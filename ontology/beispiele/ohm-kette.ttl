# =============================================================================
# Beispiel „Ohm-Kette“: dasselbe Thema in Schule, Berufsausbildung und Studium.
# Alle Dokumente und Wortlaute sind FIKTIV (nach dem Muster echter Pläne
# formuliert), Seiten und Block-IDs erfunden. Gezeigt werden:
#   L1  Dokument, Spezifikation, Gliederung, Aussagen mit Fundstelle
#   L2  Zerlegung, Inhalts- und Kompetenzkonzepte (Hubs), Niveau, Zeit
#   L3  Zuordnungen: steigert (bestätigt → Kurzform), steigert (vorgeschlagen),
#       Lernortkooperation (amtlich), Anrechnung (amtlich)
# Erwartung: konform zu cur-shapes.ttl und profil-shapes.ttl.
# =============================================================================

# -----------------------------------------------------------------------------
# Hubs (L2, bottom-up, hier von Hand)
# -----------------------------------------------------------------------------
ex:ContentHub a skos:ConceptScheme ; skos:prefLabel "Inhalts-Hub (Beispiel)"@de .
ex:CompetencyHub a skos:ConceptScheme ; skos:prefLabel "Kompetenz-Hub (Beispiel)"@de .

ex:ic-elektrizitaet a cur:ContentConcept ; skos:inScheme ex:ContentHub ; cur:granularity cv:gran_topic ;
    skos:prefLabel "Elektrizität"@de , "electricity"@en .
ex:ic-ohm a cur:ContentConcept ; skos:inScheme ex:ContentHub ; cur:granularity cv:gran_concept ; skos:broader ex:ic-elektrizitaet ;
    skos:prefLabel "Ohmsches Gesetz"@de , "Ohm's law"@en ;
    skos:editorialNote "Normdatenabgleich (Wikidata, GND) in N2 per Reconciliation; Ergebnis als cur:Alignment mit Methode reconciliation."@de .
ex:ic-stromkreis a cur:ContentConcept ; skos:inScheme ex:ContentHub ; cur:granularity cv:gran_concept ; skos:broader ex:ic-elektrizitaet ;
    skos:prefLabel "Elektrischer Stromkreis"@de .
ex:ic-kirchhoff a cur:ContentConcept ; skos:inScheme ex:ContentHub ; cur:granularity cv:gran_concept ; skos:broader ex:ic-elektrizitaet ;
    skos:prefLabel "Kirchhoffsche Regeln"@de ;
    skos:related ex:ic-ohm .

ex:kk-ohm-beschreiben a cur:CompetencyConcept ; skos:inScheme ex:CompetencyHub ;
    skos:prefLabel "Zusammenhang von Spannung, Stromstärke und Widerstand beschreiben"@de .
ex:kk-groessen-berechnen a cur:CompetencyConcept ; skos:inScheme ex:CompetencyHub ;
    skos:prefLabel "Elektrische Größen in Stromkreisen berechnen"@de .
ex:kk-netzwerke-analysieren a cur:CompetencyConcept ; skos:inScheme ex:CompetencyHub ;
    skos:prefLabel "Gleichstromnetzwerke analysieren"@de .

