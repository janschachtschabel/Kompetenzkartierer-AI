    skos:prefLabel "Akzeptanz von Vielfalt und Inklusion"@de , "diversity and inclusion"@en ;
    skos:altLabel "Bildung für Toleranz und Akzeptanz von Vielfalt"@de , "BTV"@de , "Inklusion"@de , "Diversität"@de , "Umgang mit Heterogenität"@de , "vorurteilsbewusste Bildung"@de .
