# -----------------------------------------------------------------------------
# KMK „Bildung in der digitalen Welt“ (2016) – sechs Kompetenzbereiche
# -----------------------------------------------------------------------------
qz:KMKDigital a skos:ConceptScheme ;
    skos:prefLabel "KMK-Strategie Bildung in der digitalen Welt – Kompetenzbereiche"@de ;
    dct:source "KMK 2016 (ergänzt 2021); maschinenlesbarer KIM-Entwurf: http://w3id.org/kim/kmk-vocabs/digitalisierungsbezogene-kompetenzen/" ;
    skos:editorialNote "Die 22 Einzelkompetenzen werden aus dem KIM-Entwurf importiert, wenn er stabil ist."@de .
qz:kmkdig-1 a cur:CrossCuttingObjective ; skos:inScheme qz:KMKDigital ; skos:topConceptOf qz:KMKDigital ; skos:notation "1" ;
    skos:prefLabel "Suchen, Verarbeiten und Aufbewahren"@de ; skos:broadMatch qz:DigitalWorld .
qz:kmkdig-2 a cur:CrossCuttingObjective ; skos:inScheme qz:KMKDigital ; skos:topConceptOf qz:KMKDigital ; skos:notation "2" ;
    skos:prefLabel "Kommunizieren und Kooperieren"@de ; skos:broadMatch qz:DigitalWorld .
qz:kmkdig-3 a cur:CrossCuttingObjective ; skos:inScheme qz:KMKDigital ; skos:topConceptOf qz:KMKDigital ; skos:notation "3" ;
    skos:prefLabel "Produzieren und Präsentieren"@de ; skos:broadMatch qz:DigitalWorld .
qz:kmkdig-4 a cur:CrossCuttingObjective ; skos:inScheme qz:KMKDigital ; skos:topConceptOf qz:KMKDigital ; skos:notation "4" ;
    skos:prefLabel "Schützen und sicher Agieren"@de ; skos:broadMatch qz:DigitalWorld .
qz:kmkdig-5 a cur:CrossCuttingObjective ; skos:inScheme qz:KMKDigital ; skos:topConceptOf qz:KMKDigital ; skos:notation "5" ;
    skos:prefLabel "Problemlösen und Handeln"@de ; skos:broadMatch qz:DigitalWorld .
qz:kmkdig-6 a cur:CrossCuttingObjective ; skos:inScheme qz:KMKDigital ; skos:topConceptOf qz:KMKDigital ; skos:notation "6" ;
    skos:prefLabel "Analysieren und Reflektieren"@de ; skos:broadMatch qz:DigitalWorld .

