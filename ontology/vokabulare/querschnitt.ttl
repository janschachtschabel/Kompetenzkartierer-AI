@prefix lp:    <https://w3id.org/lehrplan/ontology/> .

# =============================================================================
# Querschnittsziele: EIN Hub-Schema für alle Bildungsbereiche (qz:Hub) und
# Quellschemata der Länder, der KMK, des BIBB, der EU und der MRVO, die per
# SKOS-Mapping am Hub hängen. Ein Querschnittsziel existiert genau einmal im
# Hub; ob es in einem Land Bildungsbereich, Leitperspektive, Prinzip oder
# Standardberufsbildposition ist, steht am Knoten bzw. am Quellschema.
# Querschnittsfragen über Bereiche („Wo wird BNE konkret verankert?“) laufen
# über den Hub. Quellschemata, deren Wortlaut nicht am Primärdokument geprüft
# ist, tragen eine editorialNote.
# =============================================================================

<https://w3id.org/wlo/curriculum/crosscutting> a owl:Ontology ;
    dct:title "Querschnittsziele"@de , "cross-cutting objectives"@en ;
    owl:versionInfo "1.0-entwurf" ;
    dct:created "2026-10-19"^^xsd:date .

# -----------------------------------------------------------------------------
# Hub
# -----------------------------------------------------------------------------
qz:Hub a skos:ConceptScheme ;
    skos:prefLabel "Querschnittsziele – Hub"@de , "cross-cutting objectives – hub"@en .

qz:BNE a cur:CrossCuttingObjective ; skos:inScheme qz:Hub ; skos:topConceptOf qz:Hub ; cur:objectiveType cv:obj_perspective ;
    skos:prefLabel "Bildung für nachhaltige Entwicklung"@de , "education for sustainable development"@en ;
    skos:altLabel "BNE"@de , "Nachhaltigkeit"@de , "Umweltbildung"@de , "Globales Lernen"@de , "BBNE"@de .
qz:DigitalWorld a cur:CrossCuttingObjective ; skos:inScheme qz:Hub ; skos:topConceptOf qz:Hub ; cur:objectiveType cv:obj_perspective ;
    skos:prefLabel "Medienbildung und Bildung in der digitalen Welt"@de , "media and digital education"@en ;
    skos:altLabel "Medienbildung"@de , "Medienkompetenz"@de , "Digitale Bildung"@de , "Digitalkompetenz"@de , "Digitalität"@de , "Leben und Lernen in einer digitalisierten Welt"@de .
qz:Democracy a cur:CrossCuttingObjective ; skos:inScheme qz:Hub ; skos:topConceptOf qz:Hub ; cur:objectiveType cv:obj_perspective ;
    skos:prefLabel "Demokratiebildung und politische Bildung"@de , "democracy education"@en ;
    skos:altLabel "Demokratieerziehung"@de , "politische Bildung"@de , "Bürgerkompetenz"@de .
