qz:mkr-4 a cur:CrossCuttingObjective ; skos:inScheme qz:MKR-NW ; skos:topConceptOf qz:MKR-NW ; skos:notation "4" ; skos:prefLabel "Produzieren und Präsentieren"@de ; skos:broadMatch qz:DigitalWorld ; skos:closeMatch qz:kmkdig-3 .
qz:mkr-5 a cur:CrossCuttingObjective ; skos:inScheme qz:MKR-NW ; skos:topConceptOf qz:MKR-NW ; skos:notation "5" ; skos:prefLabel "Analysieren und Reflektieren"@de ; skos:broadMatch qz:DigitalWorld ; skos:closeMatch qz:kmkdig-6 .
