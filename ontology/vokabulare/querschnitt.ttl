# -----------------------------------------------------------------------------
# Leitperspektiven Bildungsplan 2016 Baden-Württemberg
# -----------------------------------------------------------------------------
qz:BW-BP2016 a skos:ConceptScheme ;
    skos:prefLabel "Leitperspektiven Bildungsplan 2016 (BW)"@de ;
    skos:editorialNote "Plangeneration BP2016. Laut Feedback wurde „Medienbildung“ mit der Reform 2026 zu „Leben und Lernen in einer digitalisierten Welt“ weiterentwickelt – nicht unabhängig geprüft. FWU führt Leitperspektiven als Klasse CE-Leitperspektive (lp:LP_0030325)."@de .
qz:bw-BNE a cur:CrossCuttingObjective ; skos:inScheme qz:BW-BP2016 ; skos:topConceptOf qz:BW-BP2016 ; skos:notation "BNE" ;
    skos:prefLabel "Bildung für nachhaltige Entwicklung"@de ; skos:exactMatch qz:BNE .
qz:bw-BTV a cur:CrossCuttingObjective ; skos:inScheme qz:BW-BP2016 ; skos:topConceptOf qz:BW-BP2016 ; skos:notation "BTV" ;
    skos:prefLabel "Bildung für Toleranz und Akzeptanz von Vielfalt"@de ; skos:exactMatch qz:Diversity .
qz:bw-PG a cur:CrossCuttingObjective ; skos:inScheme qz:BW-BP2016 ; skos:topConceptOf qz:BW-BP2016 ; skos:notation "PG" ;
    skos:prefLabel "Prävention und Gesundheitsförderung"@de ; skos:exactMatch qz:Health .
qz:bw-BO a cur:CrossCuttingObjective ; skos:inScheme qz:BW-BP2016 ; skos:topConceptOf qz:BW-BP2016 ; skos:notation "BO" ;
    skos:prefLabel "Berufliche Orientierung"@de ; skos:exactMatch qz:CareerOrientation .
qz:bw-MB a cur:CrossCuttingObjective ; skos:inScheme qz:BW-BP2016 ; skos:topConceptOf qz:BW-BP2016 ; skos:notation "MB" ;
    skos:prefLabel "Medienbildung"@de ; skos:exactMatch qz:DigitalWorld .
qz:bw-VB a cur:CrossCuttingObjective ; skos:inScheme qz:BW-BP2016 ; skos:topConceptOf qz:BW-BP2016 ; skos:notation "VB" ;
    skos:prefLabel "Verbraucherbildung"@de ; skos:exactMatch qz:ConsumerEducation .

