@prefix fld:   <https://w3id.org/wlo/curriculum/field/> .
@prefix cur:   <https://w3id.org/wlo/curriculum/core#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix kimi13: <https://w3id.org/kim/isced-2013/> .
@prefix iscedf: <http://data.europa.eu/snb/isced-f/> .
@prefix kimsf: <http://w3id.org/kim/schulfaecher/> .

# =============================================================================
# Fach-Hub (Andockpunkt 4): ISCED-F 2013 als bereichsübergreifendes Rückgrat.
# Begründung: ISCED-F ist offen, international, deckt Berufs-, Hochschul- und
# Erwachsenenbildung ab und hat belegte URIs (EU-Vokabular, KIM, ESCO); die
# KIM-Hochschulfächersystematik hat eine geschlossene Lizenz und eignet sich
# deshalb nur als zusätzliches Mapping.
# Fächer der Schule (KIM-Schulfächer), Bildungsbereiche der Kita und
# Programmbereiche der Erwachsenenbildung hängen per SKOS-Mapping am Hub
# (siehe auch Profile). Der Fach-Hub dient als Kandidatenfilter für Kanten:
# verglichen wird nur, was sich ein Feld oder ein verwandtes Feld teilt.
#
# Mappings: kimi13: Muster n<Code> für alle Ebenen belegt (2026-10-19);
# iscedf: Muster an 071 und 0713 belegt, hier nur für drei- und vierstellige
# Codes gesetzt. Deutsche Labels sind eigene Übersetzungen (KIM und EU führen
# nur englische).
# skos:related zwischen Feldern verschiedener Breitfelder = redaktionelle
# Fachverwandtschaft (Vorschlag, je Fächerpaar zu prüfen).
# =============================================================================

<https://w3id.org/wlo/curriculum/field> a owl:Ontology ;
    dct:title "Fach-Hub (ISCED-F 2013)"@de , "field hub (ISCED-F 2013)"@en ;
    owl:versionInfo "1.0-entwurf" ;
    dct:created "2026-10-19"^^xsd:date .

fld:ISCEDF a skos:ConceptScheme ;
    skos:prefLabel "Fach-Hub nach ISCED-F 2013"@de , "field hub based on ISCED-F 2013"@en ;
    dct:source "UNESCO-UIS, ISCED Fields of Education and Training 2013" .

# --- 00 Allgemeine Bildungsgänge und Qualifikationen -------------------------
fld:00 a skos:Concept ; skos:inScheme fld:ISCEDF ; skos:topConceptOf fld:ISCEDF ; skos:notation "00" ;
    skos:prefLabel "Allgemeine Bildungsgänge und Qualifikationen"@de , "Generic programmes and qualifications"@en ; skos:exactMatch kimi13:n00 .
fld:0011 a skos:Concept ; skos:inScheme fld:ISCEDF ; skos:broader fld:001 ; skos:notation "0011" ;
    skos:prefLabel "Grundlegende Bildungsgänge"@de , "Basic programmes and qualifications"@en ; skos:exactMatch kimi13:n0011 , iscedf:0011 .
fld:0021 a skos:Concept ; skos:inScheme fld:ISCEDF ; skos:broader fld:002 ; skos:notation "0021" ;
    skos:prefLabel "Lesen, Schreiben, Rechnen (Grundbildung)"@de , "Literacy and numeracy"@en ; skos:exactMatch kimi13:n0021 , iscedf:0021 .
fld:0031 a skos:Concept ; skos:inScheme fld:ISCEDF ; skos:broader fld:003 ; skos:notation "0031" ;
    skos:prefLabel "Persönliche Fähigkeiten und Entwicklung"@de , "Personal skills and development"@en ; skos:exactMatch kimi13:n0031 , iscedf:0031 .

