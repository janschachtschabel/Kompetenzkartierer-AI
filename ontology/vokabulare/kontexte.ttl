ctx:guided-activity a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:offers-projects ; cur:contextType cv:ctxt_situation ; skos:prefLabel "Angeleitetes Angebot"@de .
ctx:project a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:offers-projects ; cur:contextType cv:ctxt_situation ; skos:prefLabel "Projekt"@de .
ctx:experimenting a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:offers-projects ; cur:contextType cv:ctxt_situation ; skos:prefLabel "Forschen und Experimentieren"@de .
