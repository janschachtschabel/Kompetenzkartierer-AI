ctx:work-order a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:situations ; cur:contextType cv:ctxt_situation ;
    skos:prefLabel "Kundenauftrag/betrieblicher Arbeitsauftrag"@de ; skos:scopeNote "Typische Handlungssituation in Lernfeldern und Prüfungsbereichen."@de .

# -----------------------------------------------------------------------------
# Lebens- und Handlungsbereiche (Erwachsenenbildung, Rahmencurriculum Integrationskurse)
# -----------------------------------------------------------------------------
ctx:ik-hf a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:lifeDomains ; cur:contextType cv:ctxt_lifeDomain ;
    skos:prefLabel "Handlungsfelder des Rahmencurriculums für Integrationskurse"@de ;
    skos:editorialNote "Zwölf Handlungsfelder aus Modellwissen (EB-Prüfer [A]); vor Freigabe am Rahmencurriculum (BAMF/Goethe 2016/2017) prüfen."@de .
ctx:hf-authorities a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:ik-hf ; cur:contextType cv:ctxt_lifeDomain ; skos:prefLabel "Ämter und Behörden"@de .
