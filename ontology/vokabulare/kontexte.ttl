# Berufsfelder (KldB 2010, Berufsbereiche, einstellig)
# -----------------------------------------------------------------------------
ctx:kldb a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:occupationalFields ; cur:contextType cv:ctxt_occupationalField ;
