ctx:excursion a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:places ; cur:contextType cv:ctxt_situation ; skos:prefLabel "Ausflug in den Sozialraum"@de .
ctx:room-design a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:places ; cur:contextType cv:ctxt_situation ; skos:prefLabel "Raum- und Materialgestaltung"@de .
