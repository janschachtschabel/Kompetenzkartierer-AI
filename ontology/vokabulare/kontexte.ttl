ctx:hf-children a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:ik-hf ; cur:contextType cv:ctxt_lifeDomain ; skos:prefLabel "Betreuung und Ausbildung der Kinder"@de .
ctx:hf-shopping a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:ik-hf ; cur:contextType cv:ctxt_lifeDomain ; skos:prefLabel "Einkaufen"@de .
ctx:hf-health a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:ik-hf ; cur:contextType cv:ctxt_lifeDomain ; skos:prefLabel "Gesundheit"@de .
ctx:hf-media a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:ik-hf ; cur:contextType cv:ctxt_lifeDomain ; skos:prefLabel "Mediennutzung"@de .
ctx:hf-mobility a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:ik-hf ; cur:contextType cv:ctxt_lifeDomain ; skos:prefLabel "Mobilität"@de .
ctx:hf-classroom a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:ik-hf ; cur:contextType cv:ctxt_lifeDomain ; skos:prefLabel "Unterricht"@de .
ctx:hf-housing a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:ik-hf ; cur:contextType cv:ctxt_lifeDomain ; skos:prefLabel "Wohnen"@de .
ctx:ik-transversal a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:lifeDomains ; cur:contextType cv:ctxt_lifeDomain ;
    skos:prefLabel "Handlungsfelder übergreifende Kommunikation"@de ;
    skos:scopeNote "Situationsunabhängig; erzeugen keinen Lebensbereich-Kontext für die Aussagen darunter. Belegt: A Umgang mit der Migrationssituation, E Umgang mit dem eigenen Sprachenlernen; B–D am Rahmencurriculum ergänzen."@de .
ctx:ik-migration a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:ik-transversal ; cur:contextType cv:ctxt_lifeDomain ;
    skos:notation "A" ; skos:prefLabel "Umgang mit der Migrationssituation"@de .
ctx:ik-own-learning a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:ik-transversal ; cur:contextType cv:ctxt_lifeDomain ;
    skos:notation "E" ; skos:prefLabel "Umgang mit dem eigenen Sprachenlernen"@de .

