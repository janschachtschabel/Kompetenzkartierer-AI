@prefix ctx:   <https://w3id.org/wlo/curriculum/context/> .
@prefix cur:   <https://w3id.org/wlo/curriculum/core#> .
@prefix cv:    <https://w3id.org/wlo/curriculum/vocab#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# Kontexte (Andockpunkt 7): Situationen, Lebens- und Handlungsbereiche,
# Lernorte, Rollen/Zielgruppen und Berufsfelder – der wichtigste Anker für
# Lernszenarien und Lernsituationen. Knotentypen mit Kontextsemantik
# (Handlungsfeld, Alltagssituation, Lernort) setzen den Kontext per
# cur:impliesContext ohne LLM-Aufruf (Herkunft inherited).
# Startbestand aus den Bereichsentwürfen; mit „zu prüfen“ markierte Listen
# stammen aus Modellwissen und sind am Primärdokument zu verifizieren.
# =============================================================================

<https://w3id.org/wlo/curriculum/context> a owl:Ontology ;
    dct:title "Kontexte"@de , "contexts"@en ;
    owl:versionInfo "1.0-entwurf" ;
    dct:created "2026-10-19"^^xsd:date .

ctx:Contexts a skos:ConceptScheme ;
    skos:prefLabel "Kontexte"@de , "contexts"@en ;
    skos:hasTopConcept ctx:situations , ctx:lifeDomains , ctx:settings , ctx:roles , ctx:occupationalFields .

ctx:situations a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:topConceptOf ctx:Contexts ; cur:contextType cv:ctxt_situation ;
    skos:prefLabel "Situationen"@de , "situations"@en .
ctx:lifeDomains a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:topConceptOf ctx:Contexts ; cur:contextType cv:ctxt_lifeDomain ;
    skos:prefLabel "Lebens- und Handlungsbereiche"@de , "life domains"@en .
ctx:settings a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:topConceptOf ctx:Contexts ; cur:contextType cv:ctxt_setting ;
    skos:prefLabel "Lernorte"@de , "learning settings"@en .
ctx:roles a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:topConceptOf ctx:Contexts ; cur:contextType cv:ctxt_role ;
    skos:prefLabel "Rollen und Zielgruppen"@de , "roles and target groups"@en .
ctx:occupationalFields a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:topConceptOf ctx:Contexts ; cur:contextType cv:ctxt_occupationalField ;
    skos:prefLabel "Berufsfelder"@de , "occupational fields"@en .

# -----------------------------------------------------------------------------
# Situationen (Elementarbildung; pädagogische Alltagssituationen BB 2024 u. a.)
# -----------------------------------------------------------------------------
ctx:everyday a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:situations ; cur:contextType cv:ctxt_situation ;
    skos:prefLabel "Alltagssituationen"@de .
ctx:arrival-farewell a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:everyday ; cur:contextType cv:ctxt_situation ; skos:prefLabel "Ankommen und Abschied"@de .
ctx:meals a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:everyday ; cur:contextType cv:ctxt_situation ; skos:prefLabel "Mahlzeiten"@de .
ctx:body-care a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:everyday ; cur:contextType cv:ctxt_situation ; skos:prefLabel "Körperpflege, Wickeln, Toilette"@de .
ctx:rest-sleep a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:everyday ; cur:contextType cv:ctxt_situation ; skos:prefLabel "Ruhen und Schlafen"@de .
ctx:dressing a cur:ContextConcept ; skos:inScheme ctx:Contexts ; skos:broader ctx:everyday ; cur:contextType cv:ctxt_situation ; skos:prefLabel "An- und Ausziehen"@de .
