op:reflektieren a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "reflektieren"@de .
op:skizzieren a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "skizzieren"@de .
op:untersuchen a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "untersuchen"@de .
