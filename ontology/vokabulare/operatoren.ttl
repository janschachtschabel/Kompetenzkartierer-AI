@prefix op:    <https://w3id.org/wlo/curriculum/operator/> .
@prefix cur:   <https://w3id.org/wlo/curriculum/core#> .
@prefix lvl:   <https://w3id.org/wlo/curriculum/level/> .
@prefix fld:   <https://w3id.org/wlo/curriculum/field/> .
@prefix land:  <https://w3id.org/wlo/curriculum/region/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# Operatoren: Lemmata (bereichsneutral, ohne Stufe) und Operatorenlisten mit
# Quelle und Geltung. Die Taxonomiestufe einer Zerlegung kommt NUR aus einer
# Liste, die für Land, Fach und Stufe des Curriculums gilt (Methode lookup,
# Herkunft rule, Dimension cognitive); gibt es keine passende Liste, bleibt
# sie leer. Belege: „beschreiben“ ist in BW Physik AFB II, in der SCO-
# Heuristik AFB I; drei Physikpläne nutzen 112 Verben, die Listen decken
# 51–82 % ab. Eine globale Tabelle wäre falsch.
# Lemma-Regeln: Infinitiv; trennbare Verben zusammengezogen („wählen … aus“ →
# auswählen); „sich“ entfällt; bei „besitzen/verfügen über die Kompetenz …“,
# „haben“, „kennen“ zählt das folgende Handlungsverb.
# =============================================================================

<https://w3id.org/wlo/curriculum/operator> a owl:Ontology ;
    dct:title "Operatoren und Operatorenlisten"@de , "operators and operator lists"@en ;
    owl:versionInfo "1.0-entwurf" ;
    dct:created "2026-10-19"^^xsd:date .

op:Lemmas a skos:ConceptScheme ;
    skos:prefLabel "Operator-Lemmata"@de , "operator lemmas"@en ;
    skos:scopeNote "Offene Menge: neue Lemmata entstehen in N1 (Herkunft model) und werden redaktionell bestätigt."@de .

op:ableiten a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "ableiten"@de .
op:abschaetzen a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "abschätzen"@de .
op:analysieren a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "analysieren"@de .
op:angeben a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "angeben"@de .
op:anwenden a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "anwenden"@de .
op:aufstellen a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "aufstellen"@de .
op:aufzeichnen a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "aufzeichnen"@de .
op:auswaehlen a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "auswählen"@de ; skos:hiddenLabel "wählen … aus" .
op:auswerten a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "auswerten"@de ; skos:hiddenLabel "werten … aus" .
