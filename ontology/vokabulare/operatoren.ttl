# -----------------------------------------------------------------------------
# Liste 3: heuristische Startliste (Entwurf SCO v2) – AFB und Bloom, NICHT amtlich
# -----------------------------------------------------------------------------
op:list-heuristic a cur:OperatorList ;
    skos:prefLabel "Heuristische Operatorenliste (Startbestand, nicht amtlich)"@de ;
    dct:source "Entwurf SchulCurriculum-Ontologie (SCO) v2, scov:Operator" ;
    skos:scopeNote "Nur als letzte Rückfallebene, wenn keine Liste für Land und Fach gilt; Ergebnis immer Herkunft rule mit Konfidenz ≤ 0,5. Nie für steigert-Kanten verwenden."@de .
op:heu-analysieren a cur:OperatorEntry ; skos:inScheme op:list-heuristic ; cur:lemma op:analysieren ; cur:taskDemand lvl:afb-II ; cur:cognitiveLevel lvl:bloom-analyze ; skos:prefLabel "analysieren"@de .
