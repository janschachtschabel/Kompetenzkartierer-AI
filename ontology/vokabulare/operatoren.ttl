op:beweisen a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "beweisen"@de .
op:bewerten a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "bewerten"@de .
op:darstellen a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "darstellen"@de ; skos:hiddenLabel "stellen … dar" .
op:deuten a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "deuten"@de .
op:diskutieren a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "diskutieren"@de .
op:dokumentieren a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "dokumentieren"@de .
