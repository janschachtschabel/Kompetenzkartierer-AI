    skos:scopeNote "Nur, wenn kein Handlungsverb folgt („kennen“ als einziges Verb)."@de .
op:klassifizieren a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "klassifizieren"@de .
