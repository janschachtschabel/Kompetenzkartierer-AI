op:erkennen a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "erkennen"@de .
op:erklaeren a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "erklären"@de .
op:erlaeutern a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "erläutern"@de .
op:ermitteln a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "ermitteln"@de .
