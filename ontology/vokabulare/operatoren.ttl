op:wiedergeben a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "wiedergeben"@de ; skos:hiddenLabel "geben … wieder" .
op:zeichnen a cur:OperatorLemma ; skos:inScheme op:Lemmas ; skos:prefLabel "zeichnen"@de .

# -----------------------------------------------------------------------------
# Liste 1: Bildungsplan 2016 Baden-Württemberg, Sekundarstufe I (Naturwissenschaften)
# -----------------------------------------------------------------------------
op:list-bw2016-nawi a cur:OperatorList ;
    skos:prefLabel "Operatorenliste Bildungsplan 2016 BW, Sek I (inhaltsbezogene Standards)"@de ;
    cur:scopeRegion land:DE-BW ;
    cur:scopeSubject fld:0533 , fld:0531 , fld:0511 , fld:071 ;
    dct:source "data/sources/schulbildung-ontologie/sb-operatoren.ttl (übernommen aus dem BW-Bildungsplan 2016; nur Verben, Listenzeilen und AFB)" ;
    skos:scopeNote "Gilt für die Standards für inhaltsbezogene Kompetenzen in Alltagskultur, Ernährung, Soziales, Biologie, Chemie, Technik, Naturwissenschaft und Technik, Physik und im Fächerverbund Biologie, Naturphänomene und Technik. Für prozessbezogene Kompetenzen deckt sie nur 19 von 55 Verwendungen ab."@de .
op:bw16-ableiten a cur:OperatorEntry ; skos:inScheme op:list-bw2016-nawi ; cur:lemma op:ableiten ; cur:taskDemand lvl:afb-II ; skos:prefLabel "ableiten"@de .
