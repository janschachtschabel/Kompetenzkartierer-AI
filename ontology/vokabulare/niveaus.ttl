# -----------------------------------------------------------------------------
# Erwartungs- und Kursniveaus
# -----------------------------------------------------------------------------
lvl:Attainment a cur:LevelScheme ;
    skos:prefLabel "Erwartungsniveaus (Standards)"@de , "attainment levels"@en ;
    cur:levelDimension cv:dim_attainment ; cur:levelOrdering cv:ord_cumulative ;
    skos:scopeNote "KMK: Mindest-, Regel-, Optimalstandard; HH: Mindestanforderungen und erhöhte Anforderungen. „Anforderung“ in HH ist ein Erwartungsniveau, nicht der Anforderungsbereich einer Aufgabe."@de .
lvl:att-minimum a cur:LevelConcept ; skos:inScheme lvl:Attainment ; skos:topConceptOf lvl:Attainment ; skos:notation "minimum" ; cur:rank 1 ;
    skos:prefLabel "Mindestanforderung/Mindeststandard"@de ; skos:altLabel "Mindestanforderungen"@de .
lvl:att-regular a cur:LevelConcept ; skos:inScheme lvl:Attainment ; skos:topConceptOf lvl:Attainment ; skos:notation "regular" ; cur:rank 2 ;
    skos:prefLabel "Regelanforderung/Regelstandard"@de .
lvl:att-increased a cur:LevelConcept ; skos:inScheme lvl:Attainment ; skos:topConceptOf lvl:Attainment ; skos:notation "increased" ; cur:rank 3 ;
    skos:prefLabel "erhöhte Anforderung"@de ; skos:altLabel "erhöhte Anforderungen"@de , "Regelstandard plus"@de .
lvl:att-optimal a cur:LevelConcept ; skos:inScheme lvl:Attainment ; skos:topConceptOf lvl:Attainment ; skos:notation "optimal" ; cur:rank 4 ;
    skos:prefLabel "Optimalstandard"@de .

lvl:AttainmentTracks a cur:LevelScheme ;
    skos:prefLabel "Anforderungsebenen nach Abschluss (Sekundarstufe I)"@de , "attainment tracks by school-leaving qualification"@en ;
    cur:levelDimension cv:dim_attainment ; cur:levelOrdering cv:ord_cumulative ;
    skos:scopeNote "SH-Fachanforderungen: Kompetenzen und Inhalte auf drei Anforderungsebenen. Erwartungsniveau einer Aussage, kein Abschluss; deshalb kein DQR-Bezug. Der Abschluss selbst steht in lvl:SchoolLeaving."@de .
lvl:track-ESA a cur:LevelConcept ; skos:inScheme lvl:AttainmentTracks ; skos:topConceptOf lvl:AttainmentTracks ; skos:notation "ESA" ; cur:rank 1 ;
    skos:prefLabel "Anforderungsebene Erster allgemeinbildender Schulabschluss"@de ; skos:altLabel "ESA"@de ; skos:relatedMatch lvl:school-ESA .
lvl:track-MSA a cur:LevelConcept ; skos:inScheme lvl:AttainmentTracks ; skos:topConceptOf lvl:AttainmentTracks ; skos:notation "MSA" ; cur:rank 2 ;
    skos:prefLabel "Anforderungsebene Mittlerer Schulabschluss"@de ; skos:altLabel "MSA"@de ; skos:relatedMatch lvl:school-MSA .
lvl:track-transition a cur:LevelConcept ; skos:inScheme lvl:AttainmentTracks ; skos:topConceptOf lvl:AttainmentTracks ; skos:notation "UEO" ; cur:rank 3 ;
    skos:prefLabel "Anforderungsebene Übergang in die Oberstufe"@de ; skos:relatedMatch lvl:school-transition .

lvl:BWLevels a cur:LevelScheme ;
    skos:prefLabel "Niveaus G/M/E (Bildungsplan BW, Sekundarstufe I)"@de , "BW levels G/M/E"@en ;
    cur:levelDimension cv:dim_attainment ; cur:levelOrdering cv:ord_parallel ;
    skos:scopeNote "Parallele Anspruchsniveaus desselben Jahrgangs. Gleicher Wortlaut über mehrere Niveaus = ein Element mit mehreren Niveaus."@de .
lvl:bw-G a cur:LevelConcept ; skos:inScheme lvl:BWLevels ; skos:topConceptOf lvl:BWLevels ; skos:notation "G" ; cur:rank 1 ; skos:prefLabel "Niveau G (grundlegend)"@de .
lvl:bw-M a cur:LevelConcept ; skos:inScheme lvl:BWLevels ; skos:topConceptOf lvl:BWLevels ; skos:notation "M" ; cur:rank 2 ; skos:prefLabel "Niveau M (mittel)"@de .
lvl:bw-E a cur:LevelConcept ; skos:inScheme lvl:BWLevels ; skos:topConceptOf lvl:BWLevels ; skos:notation "E" ; cur:rank 3 ; skos:prefLabel "Niveau E (erweitert)"@de .

lvl:CourseLevelsLowerSecondary a cur:LevelScheme ;
    skos:prefLabel "Kursniveaus Sekundarstufe I (G-/E-/Z-Kurs)"@de , "course levels lower secondary"@en ;
    cur:levelDimension cv:dim_course ; cur:levelOrdering cv:ord_parallel ;
    skos:scopeNote "NI: Fettdruck kennzeichnet E-Kurs-Anforderungen; HB, SL: G- und E-Niveau; BE: GR-/ER-Niveau; NW: Grund- und Erweiterungskurse. Bei drei Ebenen ist „E“ in NI die mittlere; HE nennt drei Ebenen A/B/C (A oben). Die Kursbuchstaben nur im Landeskontext deuten."@de .
lvl:course-G a cur:LevelConcept ; skos:inScheme lvl:CourseLevelsLowerSecondary ; skos:topConceptOf lvl:CourseLevelsLowerSecondary ; skos:notation "G" ; cur:rank 1 ;
    skos:prefLabel "G-Kurs (grundlegend)"@de ; skos:altLabel "Grundkurs Sek I"@de , "GR-Niveau"@de , "GR-Kurs"@de .
lvl:course-E a cur:LevelConcept ; skos:inScheme lvl:CourseLevelsLowerSecondary ; skos:topConceptOf lvl:CourseLevelsLowerSecondary ; skos:notation "E" ; cur:rank 2 ;
    skos:prefLabel "E-Kurs (erweitert)"@de ; skos:altLabel "Erweiterungskurs"@de , "ER-Niveau"@de , "ER-Kurs"@de .
lvl:course-Z a cur:LevelConcept ; skos:inScheme lvl:CourseLevelsLowerSecondary ; skos:topConceptOf lvl:CourseLevelsLowerSecondary ; skos:notation "Z" ; cur:rank 3 ;
    skos:prefLabel "Z-Kurs (zusätzliche Anforderungsebene)"@de ; skos:altLabel "zusätzliche Anforderungsebene"@de ;
    skos:scopeNote "NI Oberschule: dritte Ebene nach den Kerncurricula des Gymnasiums (RdErl. „Die Arbeit in der Oberschule“)."@de .

lvl:CourseLevelsUpperSecondary a cur:LevelScheme ;
    skos:prefLabel "Anforderungsniveaus der gymnasialen Oberstufe"@de , "course levels upper secondary"@en ;
    cur:levelDimension cv:dim_course ; cur:levelOrdering cv:ord_cumulative .
lvl:course-basic a cur:LevelConcept ; skos:inScheme lvl:CourseLevelsUpperSecondary ; skos:topConceptOf lvl:CourseLevelsUpperSecondary ; skos:notation "gA" ; cur:rank 1 ;
    skos:prefLabel "grundlegendes Anforderungsniveau"@de ; skos:altLabel "Grundkurs"@de , "GK"@de , "Basisfach"@de , "gA"@de .
lvl:course-advanced a cur:LevelConcept ; skos:inScheme lvl:CourseLevelsUpperSecondary ; skos:topConceptOf lvl:CourseLevelsUpperSecondary ; skos:notation "eA" ; cur:rank 2 ;
    skos:prefLabel "erhöhtes Anforderungsniveau"@de ; skos:altLabel "Leistungskurs"@de , "LK"@de , "Leistungsfach"@de , "eA"@de .

# -----------------------------------------------------------------------------
# Bewertung: nur an Prüfung, Prüfungsspezifikation oder Standard
# -----------------------------------------------------------------------------
lvl:Grades a cur:LevelScheme ;
    skos:prefLabel "Notenstufen 1–6"@de , "German school grades 1–6"@en ;
    cur:levelDimension cv:dim_grading ; cur:levelOrdering cv:ord_ordinal ;
    dct:source "KMK-Beschluss vom 03.10.1968 (Notenstufen)" ;
    skos:scopeNote "Schul- und Prüfungsnoten mit den Bezeichnungen „sehr gut“ bis „ungenügend“, auch Kammerprüfungen. Hochschulnoten (1,0–5,0) sind ein eigenes System und gehören nicht hierher. cur:rank steigt mit der Leistung (Note 1 = Rang 6). Tendenzen (+/−) und Zwischennoten als cur:levelText."@de .
lvl:grade-1 a cur:LevelConcept ; skos:inScheme lvl:Grades ; skos:topConceptOf lvl:Grades ; skos:notation "1" ; cur:rank 6 ; skos:prefLabel "sehr gut"@de , "very good"@en .
lvl:grade-2 a cur:LevelConcept ; skos:inScheme lvl:Grades ; skos:topConceptOf lvl:Grades ; skos:notation "2" ; cur:rank 5 ; skos:prefLabel "gut"@de , "good"@en .
lvl:grade-3 a cur:LevelConcept ; skos:inScheme lvl:Grades ; skos:topConceptOf lvl:Grades ; skos:notation "3" ; cur:rank 4 ; skos:prefLabel "befriedigend"@de , "satisfactory"@en .
lvl:grade-4 a cur:LevelConcept ; skos:inScheme lvl:Grades ; skos:topConceptOf lvl:Grades ; skos:notation "4" ; cur:rank 3 ; skos:prefLabel "ausreichend"@de , "sufficient"@en .
lvl:grade-5 a cur:LevelConcept ; skos:inScheme lvl:Grades ; skos:topConceptOf lvl:Grades ; skos:notation "5" ; cur:rank 2 ; skos:prefLabel "mangelhaft"@de , "poor"@en .
lvl:grade-6 a cur:LevelConcept ; skos:inScheme lvl:Grades ; skos:topConceptOf lvl:Grades ; skos:notation "6" ; cur:rank 1 ; skos:prefLabel "ungenügend"@de , "insufficient"@en .

lvl:GradePoints a cur:LevelScheme ;
    skos:prefLabel "Notenpunkte 0–15 (gymnasiale Oberstufe)"@de , "grade points 0–15 (upper secondary)"@en ;
    cur:levelDimension cv:dim_grading ; cur:levelOrdering cv:ord_ordinal ;
    dct:source "KMK-Vereinbarung zur Gestaltung der gymnasialen Oberstufe und der Abiturprüfung (i. d. F. vom 16.03.2023)" ;
    skos:scopeNote "Die Zuordnung zu den Notenstufen (15–13 = 1, … 0 = 6) steht als broadMatch."@de .
lvl:points-15 a cur:LevelConcept ; skos:inScheme lvl:GradePoints ; skos:topConceptOf lvl:GradePoints ; skos:notation "15" ; cur:rank 15 ; skos:prefLabel "15 Punkte"@de ; skos:broadMatch lvl:grade-1 .
