lvl:points-12 a cur:LevelConcept ; skos:inScheme lvl:GradePoints ; skos:topConceptOf lvl:GradePoints ; skos:notation "12" ; cur:rank 12 ; skos:prefLabel "12 Punkte"@de ; skos:broadMatch lvl:grade-2 .
lvl:points-11 a cur:LevelConcept ; skos:inScheme lvl:GradePoints ; skos:topConceptOf lvl:GradePoints ; skos:notation "11" ; cur:rank 11 ; skos:prefLabel "11 Punkte"@de ; skos:broadMatch lvl:grade-2 .
lvl:points-10 a cur:LevelConcept ; skos:inScheme lvl:GradePoints ; skos:topConceptOf lvl:GradePoints ; skos:notation "10" ; cur:rank 10 ; skos:prefLabel "10 Punkte"@de ; skos:broadMatch lvl:grade-2 .
lvl:points-09 a cur:LevelConcept ; skos:inScheme lvl:GradePoints ; skos:topConceptOf lvl:GradePoints ; skos:notation "9" ; cur:rank 9 ; skos:prefLabel "9 Punkte"@de ; skos:broadMatch lvl:grade-3 .
