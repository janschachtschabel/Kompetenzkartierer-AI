# -----------------------------------------------------------------------------
# Aufgabenanforderung und Heuristiken (kognitiv, affektiv, psychomotorisch)
# -----------------------------------------------------------------------------
lvl:AFB a cur:LevelScheme ;
    skos:prefLabel "Anforderungsbereiche I–III"@de , "task demand areas I–III"@en ;
    cur:levelDimension cv:dim_taskDemand ; cur:levelOrdering cv:ord_cumulative ;
    skos:scopeNote "Beziehen sich auf Aufgaben (KMK-Bildungsstandards, EPA). An Lernergebnissen nur, wenn das Dokument sie nennt (Herkunft source); aus dem Operator abgeleitet nur als Heuristik über eine Operatorenliste (Dimension cognitive, Herkunft rule). Die Zuordnung Operator → AFB ist fach- und listenabhängig."@de .
lvl:afb-I a cur:LevelConcept ; skos:inScheme lvl:AFB ; skos:topConceptOf lvl:AFB ; skos:notation "I" ; cur:rank 1 ;
    skos:prefLabel "Anforderungsbereich I (Reproduktion)"@de ; skos:exactMatch lp:LP_0000803 .
lvl:afb-II a cur:LevelConcept ; skos:inScheme lvl:AFB ; skos:topConceptOf lvl:AFB ; skos:notation "II" ; cur:rank 2 ;
    skos:prefLabel "Anforderungsbereich II (Reorganisation und Transfer)"@de ; skos:exactMatch lp:LP_0000804 .
lvl:afb-III a cur:LevelConcept ; skos:inScheme lvl:AFB ; skos:topConceptOf lvl:AFB ; skos:notation "III" ; cur:rank 3 ;
    skos:prefLabel "Anforderungsbereich III (Reflexion und Problemlösung)"@de ; skos:exactMatch lp:LP_0000805 .

lvl:Bloom a cur:LevelScheme ;
    skos:prefLabel "Taxonomie kognitiver Prozesse (Anderson/Krathwohl 2001)"@de , "revised Bloom taxonomy"@en ;
    cur:levelDimension cv:dim_cognitive ; cur:levelOrdering cv:ord_cumulative ;
    skos:closeMatch wd:Q1774565 ;
    skos:scopeNote "Nur als Heuristik mit Konfidenz (Menschen erreichen vor Abgleich κ = 0,63; Zero-Shot-LLMs 0,42–0,73 Accuracy). Die Revision vertauscht die beiden obersten Stufen von Bloom 1956 (Synthese, Bewertung) – alte Bezeichnungen als hiddenLabel."@de .
lvl:bloom-remember a cur:LevelConcept ; skos:inScheme lvl:Bloom ; skos:topConceptOf lvl:Bloom ; skos:notation "remember" ; cur:rank 1 ;
    skos:prefLabel "Erinnern"@de , "remember"@en ; skos:hiddenLabel "Kenntnis"@de , "Wissen"@de .
lvl:bloom-understand a cur:LevelConcept ; skos:inScheme lvl:Bloom ; skos:topConceptOf lvl:Bloom ; skos:notation "understand" ; cur:rank 2 ;
    skos:prefLabel "Verstehen"@de , "understand"@en ; skos:hiddenLabel "Verständnis"@de .
lvl:bloom-apply a cur:LevelConcept ; skos:inScheme lvl:Bloom ; skos:topConceptOf lvl:Bloom ; skos:notation "apply" ; cur:rank 3 ;
    skos:prefLabel "Anwenden"@de , "apply"@en ; skos:hiddenLabel "Anwendung"@de .
lvl:bloom-analyze a cur:LevelConcept ; skos:inScheme lvl:Bloom ; skos:topConceptOf lvl:Bloom ; skos:notation "analyze" ; cur:rank 4 ;
    skos:prefLabel "Analysieren"@de , "analyze"@en ; skos:hiddenLabel "Analyse"@de .
lvl:bloom-evaluate a cur:LevelConcept ; skos:inScheme lvl:Bloom ; skos:topConceptOf lvl:Bloom ; skos:notation "evaluate" ; cur:rank 5 ;
    skos:prefLabel "Bewerten"@de , "evaluate"@en ; skos:hiddenLabel "Beurteilung"@de .
lvl:bloom-create a cur:LevelConcept ; skos:inScheme lvl:Bloom ; skos:topConceptOf lvl:Bloom ; skos:notation "create" ; cur:rank 6 ;
    skos:prefLabel "Erschaffen"@de , "create"@en ; skos:hiddenLabel "Synthese"@de , "Kreieren"@de .

lvl:SOLO a cur:LevelScheme ;
    skos:prefLabel "SOLO-Taxonomie (Biggs/Collis 1982)"@de , "SOLO taxonomy"@en ;
    cur:levelDimension cv:dim_cognitive ; cur:levelOrdering cv:ord_cumulative ;
    skos:scopeNote "Tiefe des Verständnisses, verbreitet in der Hochschuldidaktik. Nur als Heuristik wie Bloom."@de .
lvl:solo-prestructural a cur:LevelConcept ; skos:inScheme lvl:SOLO ; skos:topConceptOf lvl:SOLO ; skos:notation "prestructural" ; cur:rank 1 ; skos:prefLabel "prästrukturell"@de , "prestructural"@en .
lvl:solo-unistructural a cur:LevelConcept ; skos:inScheme lvl:SOLO ; skos:topConceptOf lvl:SOLO ; skos:notation "unistructural" ; cur:rank 2 ; skos:prefLabel "unistrukturell"@de , "unistructural"@en .
lvl:solo-multistructural a cur:LevelConcept ; skos:inScheme lvl:SOLO ; skos:topConceptOf lvl:SOLO ; skos:notation "multistructural" ; cur:rank 3 ; skos:prefLabel "multistrukturell"@de , "multistructural"@en .
lvl:solo-relational a cur:LevelConcept ; skos:inScheme lvl:SOLO ; skos:topConceptOf lvl:SOLO ; skos:notation "relational" ; cur:rank 4 ; skos:prefLabel "relational"@de , "relational"@en .
lvl:solo-extendedAbstract a cur:LevelConcept ; skos:inScheme lvl:SOLO ; skos:topConceptOf lvl:SOLO ; skos:notation "extendedAbstract" ; cur:rank 5 ; skos:prefLabel "erweitert abstrakt"@de , "extended abstract"@en .

lvl:AffectiveTaxonomy a cur:LevelScheme ;
    skos:prefLabel "Affektive Taxonomie (Krathwohl/Bloom/Masia 1964)"@de , "affective taxonomy"@en ;
    cur:levelDimension cv:dim_affective ; cur:levelOrdering cv:ord_cumulative ;
    skos:scopeNote "Nur als Heuristik zur Planung; Haltungen von Lernenden werden damit nicht eingestuft (politische Bildung: Überwältigungsverbot)."@de .
