lvl:cefr-A2 a cur:LevelConcept ; skos:inScheme lvl:CEFR ; skos:topConceptOf lvl:CEFR ; skos:notation "A2" ; cur:rank 2 ; skos:prefLabel "GER A2"@de , "CEFR A2"@en ; skos:exactMatch wd:Q104381931 .
lvl:cefr-B1 a cur:LevelConcept ; skos:inScheme lvl:CEFR ; skos:topConceptOf lvl:CEFR ; skos:notation "B1" ; cur:rank 3 ; skos:prefLabel "GER B1"@de , "CEFR B1"@en ; skos:exactMatch wd:Q104381935 .
lvl:cefr-B2 a cur:LevelConcept ; skos:inScheme lvl:CEFR ; skos:topConceptOf lvl:CEFR ; skos:notation "B2" ; cur:rank 4 ; skos:prefLabel "GER B2"@de , "CEFR B2"@en ; skos:exactMatch wd:Q104381938 .
lvl:cefr-C1 a cur:LevelConcept ; skos:inScheme lvl:CEFR ; skos:topConceptOf lvl:CEFR ; skos:notation "C1" ; cur:rank 5 ; skos:prefLabel "GER C1"@de , "CEFR C1"@en ; skos:exactMatch wd:Q104381941 .
lvl:cefr-C2 a cur:LevelConcept ; skos:inScheme lvl:CEFR ; skos:topConceptOf lvl:CEFR ; skos:notation "C2" ; cur:rank 6 ; skos:prefLabel "GER C2"@de , "CEFR C2"@en ; skos:exactMatch wd:Q104381943 .

lvl:AlphaLevel a cur:LevelScheme ;
    skos:prefLabel "Alpha-Level (lea.)"@de , "alpha levels"@en ;
    cur:levelDimension cv:dim_proficiency ; cur:levelOrdering cv:ord_cumulative ;
    dct:source "lea. – Projekt der Universitäten Bremen und Hamburg; DVV-Rahmencurricula" ;
    skos:scopeNote "Alpha-Level 1–3 entsprechen funktionalem Analphabetismus. Kann zugleich Gliederungseinheit (Kapitel je Level) und Niveau sein. Die DVV-Rahmencurricula nutzen Level 1–4, das lea.-Kompetenzmodell Lesen (2010) beschreibt Level 1–6."@de .
lvl:alpha-1 a cur:LevelConcept ; skos:inScheme lvl:AlphaLevel ; skos:topConceptOf lvl:AlphaLevel ; skos:notation "AL1" ; cur:rank 1 ; skos:prefLabel "Alpha-Level 1"@de ; skos:hiddenLabel "L1" , "AL 1" .
lvl:alpha-2 a cur:LevelConcept ; skos:inScheme lvl:AlphaLevel ; skos:topConceptOf lvl:AlphaLevel ; skos:notation "AL2" ; cur:rank 2 ; skos:prefLabel "Alpha-Level 2"@de ; skos:hiddenLabel "L2" , "AL 2" .
lvl:alpha-3 a cur:LevelConcept ; skos:inScheme lvl:AlphaLevel ; skos:topConceptOf lvl:AlphaLevel ; skos:notation "AL3" ; cur:rank 3 ; skos:prefLabel "Alpha-Level 3"@de ; skos:hiddenLabel "L3" , "AL 3" .
lvl:alpha-4 a cur:LevelConcept ; skos:inScheme lvl:AlphaLevel ; skos:topConceptOf lvl:AlphaLevel ; skos:notation "AL4" ; cur:rank 4 ; skos:prefLabel "Alpha-Level 4"@de ; skos:hiddenLabel "L4" , "AL 4" .
lvl:alpha-5 a cur:LevelConcept ; skos:inScheme lvl:AlphaLevel ; skos:topConceptOf lvl:AlphaLevel ; skos:notation "AL5" ; cur:rank 5 ; skos:prefLabel "Alpha-Level 5"@de ; skos:hiddenLabel "L5" , "AL 5" ;
    skos:scopeNote "lea. Lesen: Textebene 2, mittelschwere Texte mit Illustrationen."@de .
lvl:alpha-6 a cur:LevelConcept ; skos:inScheme lvl:AlphaLevel ; skos:topConceptOf lvl:AlphaLevel ; skos:notation "AL6" ; cur:rank 6 ; skos:prefLabel "Alpha-Level 6"@de ; skos:hiddenLabel "L6" , "AL 6" ;
    skos:scopeNote "lea. Lesen: Textebene 3, überwiegend lexikalisches Lesen."@de .

lvl:BEBB a cur:LevelScheme ;
    skos:prefLabel "Niveaustufen A–H (Rahmenlehrplan 1–10 Berlin/Brandenburg)"@de , "level stages A–H (Berlin-Brandenburg)"@en ;
    cur:levelDimension cv:dim_proficiency ; cur:levelOrdering cv:ord_cumulative ;
    skos:scopeNote "Stufenplan statt Klassenplan; Zuordnung zu Jahrgängen nur, wenn das Dokument sie nennt. Buchstaben A–H bedeuten in BW (G/M/E) etwas anderes."@de .
lvl:bebb-A a cur:LevelConcept ; skos:inScheme lvl:BEBB ; skos:topConceptOf lvl:BEBB ; skos:notation "A" ; cur:rank 1 ; skos:prefLabel "Niveaustufe A"@de .
lvl:bebb-B a cur:LevelConcept ; skos:inScheme lvl:BEBB ; skos:topConceptOf lvl:BEBB ; skos:notation "B" ; cur:rank 2 ; skos:prefLabel "Niveaustufe B"@de .
lvl:bebb-C a cur:LevelConcept ; skos:inScheme lvl:BEBB ; skos:topConceptOf lvl:BEBB ; skos:notation "C" ; cur:rank 3 ; skos:prefLabel "Niveaustufe C"@de .
lvl:bebb-D a cur:LevelConcept ; skos:inScheme lvl:BEBB ; skos:topConceptOf lvl:BEBB ; skos:notation "D" ; cur:rank 4 ; skos:prefLabel "Niveaustufe D"@de .
lvl:bebb-E a cur:LevelConcept ; skos:inScheme lvl:BEBB ; skos:topConceptOf lvl:BEBB ; skos:notation "E" ; cur:rank 5 ; skos:prefLabel "Niveaustufe E"@de .
lvl:bebb-F a cur:LevelConcept ; skos:inScheme lvl:BEBB ; skos:topConceptOf lvl:BEBB ; skos:notation "F" ; cur:rank 6 ; skos:prefLabel "Niveaustufe F"@de .
lvl:bebb-G a cur:LevelConcept ; skos:inScheme lvl:BEBB ; skos:topConceptOf lvl:BEBB ; skos:notation "G" ; cur:rank 7 ; skos:prefLabel "Niveaustufe G"@de .
