lvl:points-07 a cur:LevelConcept ; skos:inScheme lvl:GradePoints ; skos:topConceptOf lvl:GradePoints ; skos:notation "7" ; cur:rank 7 ; skos:prefLabel "7 Punkte"@de ; skos:broadMatch lvl:grade-3 .
lvl:points-06 a cur:LevelConcept ; skos:inScheme lvl:GradePoints ; skos:topConceptOf lvl:GradePoints ; skos:notation "6" ; cur:rank 6 ; skos:prefLabel "6 Punkte"@de ; skos:broadMatch lvl:grade-4 .
