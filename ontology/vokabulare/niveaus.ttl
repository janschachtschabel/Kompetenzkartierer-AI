@prefix lvl:   <https://w3id.org/wlo/curriculum/level/> .
@prefix cur:   <https://w3id.org/wlo/curriculum/core#> .
@prefix cv:    <https://w3id.org/wlo/curriculum/vocab#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix eqf:   <http://data.europa.eu/snb/eqf/> .
@prefix qdr:   <http://data.europa.eu/snb/qdr/> .
@prefix kimel: <https://w3id.org/kim/educationalLevel/> .
@prefix kimi11: <https://w3id.org/kim/isced-2011/> .
@prefix wd:    <http://www.wikidata.org/entity/> .
@prefix lp:    <https://w3id.org/lehrplan/ontology/> .

# =============================================================================
# Niveausysteme. Jedes System ist ein eigenes cur:LevelScheme mit Standard-
# dimension und Ordnungsart; cur:rank ordnet nur innerhalb des Systems.
# Systeme werden NIE umgerechnet. Mappings zwischen Systemen stehen nur dort,
# wo eine amtliche Zuordnung besteht (DQR ↔ EQR, Fortbildungsstufen ↔ DQR,
# Schulabschlüsse ↔ DQR, Notenpunkte → Notenstufen); sie dienen als
# Vorfilter, nicht als Gleichwertigkeitsbeleg.
# Externe IRIs: EQF und DQR (EU-Vokabular QDR), KIM, Wikidata (GER) und FWU
# (AFB) am 2026-10-19 belegt.
# =============================================================================

<https://w3id.org/wlo/curriculum/level> a owl:Ontology ;
    dct:title "Niveausysteme"@de , "level schemes"@en ;
    owl:imports <https://w3id.org/wlo/curriculum/vocab> ;
    owl:versionInfo "1.0-entwurf" ;
    dct:created "2026-10-19"^^xsd:date .

# -----------------------------------------------------------------------------
# Qualifikationsniveaus
# -----------------------------------------------------------------------------
lvl:EQF a cur:LevelScheme ;
    skos:prefLabel "Europäischer Qualifikationsrahmen (EQR)"@de , "European Qualifications Framework (EQF)"@en ;
    cur:levelDimension cv:dim_qualification ; cur:levelOrdering cv:ord_cumulative ;
    dct:source "Empfehlung des Rates vom 22. Mai 2017 (2017/C 189/03)" ;
    skos:scopeNote "Nur an Qualifikation, Spezifikation oder Programm; nie an einzelnen Aussagen."@de .
lvl:EQF-1 a cur:LevelConcept ; skos:inScheme lvl:EQF ; skos:topConceptOf lvl:EQF ; skos:notation "EQF-1" ; cur:rank 1 ; skos:prefLabel "EQR-Niveau 1"@de , "EQF level 1"@en ; skos:exactMatch eqf:1 .
lvl:EQF-2 a cur:LevelConcept ; skos:inScheme lvl:EQF ; skos:topConceptOf lvl:EQF ; skos:notation "EQF-2" ; cur:rank 2 ; skos:prefLabel "EQR-Niveau 2"@de , "EQF level 2"@en ; skos:exactMatch eqf:2 .
lvl:EQF-3 a cur:LevelConcept ; skos:inScheme lvl:EQF ; skos:topConceptOf lvl:EQF ; skos:notation "EQF-3" ; cur:rank 3 ; skos:prefLabel "EQR-Niveau 3"@de , "EQF level 3"@en ; skos:exactMatch eqf:3 .
lvl:EQF-4 a cur:LevelConcept ; skos:inScheme lvl:EQF ; skos:topConceptOf lvl:EQF ; skos:notation "EQF-4" ; cur:rank 4 ; skos:prefLabel "EQR-Niveau 4"@de , "EQF level 4"@en ; skos:exactMatch eqf:4 .
lvl:EQF-5 a cur:LevelConcept ; skos:inScheme lvl:EQF ; skos:topConceptOf lvl:EQF ; skos:notation "EQF-5" ; cur:rank 5 ; skos:prefLabel "EQR-Niveau 5"@de , "EQF level 5"@en ; skos:exactMatch eqf:5 .
lvl:EQF-6 a cur:LevelConcept ; skos:inScheme lvl:EQF ; skos:topConceptOf lvl:EQF ; skos:notation "EQF-6" ; cur:rank 6 ; skos:prefLabel "EQR-Niveau 6"@de , "EQF level 6"@en ; skos:exactMatch eqf:6 .
lvl:EQF-7 a cur:LevelConcept ; skos:inScheme lvl:EQF ; skos:topConceptOf lvl:EQF ; skos:notation "EQF-7" ; cur:rank 7 ; skos:prefLabel "EQR-Niveau 7"@de , "EQF level 7"@en ; skos:exactMatch eqf:7 .
lvl:EQF-8 a cur:LevelConcept ; skos:inScheme lvl:EQF ; skos:topConceptOf lvl:EQF ; skos:notation "EQF-8" ; cur:rank 8 ; skos:prefLabel "EQR-Niveau 8"@de , "EQF level 8"@en ; skos:exactMatch eqf:8 .

lvl:DQR a cur:LevelScheme ;
    skos:prefLabel "Deutscher Qualifikationsrahmen (DQR)"@de , "German Qualifications Framework"@en ;
    cur:levelDimension cv:dim_qualification ; cur:levelOrdering cv:ord_cumulative ;
    skos:exactMatch qdr:c_ef113b94 ;
    skos:scopeNote "Nur an Qualifikation, Spezifikation oder Programm. Gleiches Niveau heißt gleichwertig, nicht gleichartig (Bachelor und Meister); als Vorfilter nutzen, nie als Äquivalenzbeleg. Faustregel Beruf: zweijährige Ausbildung DQR 3, drei- und dreieinhalbjährige DQR 4 – als Regel mit Herkunft rule, amtlich ist die Liste der zugeordneten Qualifikationen."@de .
lvl:DQR-1 a cur:LevelConcept ; skos:inScheme lvl:DQR ; skos:topConceptOf lvl:DQR ; skos:notation "DQR-1" ; cur:rank 1 ; skos:prefLabel "DQR-Niveau 1"@de ; skos:exactMatch qdr:c_f77c7095 ; skos:closeMatch lvl:EQF-1 .
lvl:DQR-2 a cur:LevelConcept ; skos:inScheme lvl:DQR ; skos:topConceptOf lvl:DQR ; skos:notation "DQR-2" ; cur:rank 2 ; skos:prefLabel "DQR-Niveau 2"@de ; skos:exactMatch qdr:c_c71cce15 ; skos:closeMatch lvl:EQF-2 .
lvl:DQR-3 a cur:LevelConcept ; skos:inScheme lvl:DQR ; skos:topConceptOf lvl:DQR ; skos:notation "DQR-3" ; cur:rank 3 ; skos:prefLabel "DQR-Niveau 3"@de ; skos:exactMatch qdr:c_c37d888a ; skos:closeMatch lvl:EQF-3 .
lvl:DQR-4 a cur:LevelConcept ; skos:inScheme lvl:DQR ; skos:topConceptOf lvl:DQR ; skos:notation "DQR-4" ; cur:rank 4 ; skos:prefLabel "DQR-Niveau 4"@de ; skos:exactMatch qdr:c_12a84182 ; skos:closeMatch lvl:EQF-4 .
lvl:DQR-5 a cur:LevelConcept ; skos:inScheme lvl:DQR ; skos:topConceptOf lvl:DQR ; skos:notation "DQR-5" ; cur:rank 5 ; skos:prefLabel "DQR-Niveau 5"@de ; skos:exactMatch qdr:c_bd9f8e42 ; skos:closeMatch lvl:EQF-5 .
lvl:DQR-6 a cur:LevelConcept ; skos:inScheme lvl:DQR ; skos:topConceptOf lvl:DQR ; skos:notation "DQR-6" ; cur:rank 6 ; skos:prefLabel "DQR-Niveau 6"@de ; skos:exactMatch qdr:c_6919ed25 ; skos:closeMatch lvl:EQF-6 .
lvl:DQR-7 a cur:LevelConcept ; skos:inScheme lvl:DQR ; skos:topConceptOf lvl:DQR ; skos:notation "DQR-7" ; cur:rank 7 ; skos:prefLabel "DQR-Niveau 7"@de ; skos:exactMatch qdr:c_184f7fed ; skos:closeMatch lvl:EQF-7 .
lvl:DQR-8 a cur:LevelConcept ; skos:inScheme lvl:DQR ; skos:topConceptOf lvl:DQR ; skos:notation "DQR-8" ; cur:rank 8 ; skos:prefLabel "DQR-Niveau 8"@de ; skos:exactMatch qdr:c_341d539b ; skos:closeMatch lvl:EQF-8 .

lvl:SchoolLeaving a cur:LevelScheme ;
    skos:prefLabel "Allgemeinbildende Schulabschlüsse"@de , "school-leaving qualifications"@en ;
    cur:levelDimension cv:dim_qualification ; cur:levelOrdering cv:ord_cumulative ;
    skos:scopeNote "Abschluss an Qualifikation, Spezifikation oder Geltungskontext („führt zum MSA“). Anforderungsebenen an Aussagen („ESA“, „MSA“ in den SH-Fachanforderungen) stehen in lvl:AttainmentTracks. DQR-Zuordnung nach KMK-Beschluss 2017: ESA 2, MSA 3, FHR und AHR 4; EESA und der Übergang haben keine eigene Zuordnung. MV, RP, SL und SH haben keinen erweiterten ersten Abschluss."@de ;
    skos:editorialNote "DQR-Zuordnung am 2026-10-20 bei Eurydice geprüft (Nationaler Qualifikationsrahmen Deutschland)."@de .
lvl:school-ESA a cur:LevelConcept ; skos:inScheme lvl:SchoolLeaving ; skos:topConceptOf lvl:SchoolLeaving ; skos:notation "ESA" ; cur:rank 1 ;
    skos:prefLabel "Erster Schulabschluss"@de ; skos:altLabel "ESA"@de , "Hauptschulabschluss"@de , "Berufsbildungsreife"@de , "BBR"@de ;
    skos:closeMatch lvl:DQR-2 .
lvl:school-EESA a cur:LevelConcept ; skos:inScheme lvl:SchoolLeaving ; skos:topConceptOf lvl:SchoolLeaving ; skos:notation "EESA" ; cur:rank 2 ;
    skos:prefLabel "Erweiterter Erster Schulabschluss"@de ; skos:altLabel "EESA"@de , "erweiterte Berufsbildungsreife"@de , "EBBR"@de , "qualifizierender Hauptschulabschluss"@de .
lvl:school-MSA a cur:LevelConcept ; skos:inScheme lvl:SchoolLeaving ; skos:topConceptOf lvl:SchoolLeaving ; skos:notation "MSA" ; cur:rank 3 ;
    skos:prefLabel "Mittlerer Schulabschluss"@de ; skos:altLabel "MSA"@de , "Realschulabschluss"@de , "Fachoberschulreife"@de , "FOR"@de ;
    skos:closeMatch lvl:DQR-3 .
lvl:school-transition a cur:LevelConcept ; skos:inScheme lvl:SchoolLeaving ; skos:topConceptOf lvl:SchoolLeaving ; skos:notation "UEO" ; cur:rank 4 ;
    skos:prefLabel "Übergang in die gymnasiale Oberstufe"@de ; skos:altLabel "FOR-Q"@de ;
    skos:scopeNote "Berechtigung zum Besuch der gymnasialen Oberstufe (z. B. FOR-Q in NRW). Die gleichnamige Anforderungsebene der SH-Fachanforderungen ist lvl:track-transition."@de .
lvl:school-FHR a cur:LevelConcept ; skos:inScheme lvl:SchoolLeaving ; skos:topConceptOf lvl:SchoolLeaving ; skos:notation "FHR" ; cur:rank 5 ;
    skos:prefLabel "Fachhochschulreife"@de ; skos:closeMatch lvl:DQR-4 .
lvl:school-AHR a cur:LevelConcept ; skos:inScheme lvl:SchoolLeaving ; skos:topConceptOf lvl:SchoolLeaving ; skos:notation "AHR" ; cur:rank 6 ;
    skos:prefLabel "Allgemeine Hochschulreife"@de ; skos:altLabel "Abitur"@de ; skos:closeMatch lvl:DQR-4 .

lvl:HigherEducationDegrees a cur:LevelScheme ;
    skos:prefLabel "Hochschulabschlussstufen (HQR/QF-EHEA)"@de , "higher education cycles"@en ;
    cur:levelDimension cv:dim_qualification ; cur:levelOrdering cv:ord_cumulative ;
    skos:scopeNote "Stufen des Qualifikationsrahmens für deutsche Hochschulabschlüsse; die HQR-Dimensionen stehen in kd:HQR, nicht hier."@de .
lvl:he-bachelor a cur:LevelConcept ; skos:inScheme lvl:HigherEducationDegrees ; skos:topConceptOf lvl:HigherEducationDegrees ; skos:notation "BA" ; cur:rank 1 ;
    skos:prefLabel "Bachelor (1. Stufe)"@de , "first cycle"@en ; skos:closeMatch lvl:EQF-6 .
lvl:he-master a cur:LevelConcept ; skos:inScheme lvl:HigherEducationDegrees ; skos:topConceptOf lvl:HigherEducationDegrees ; skos:notation "MA" ; cur:rank 2 ;
    skos:prefLabel "Master (2. Stufe)"@de , "second cycle"@en ; skos:closeMatch lvl:EQF-7 .
lvl:he-doctorate a cur:LevelConcept ; skos:inScheme lvl:HigherEducationDegrees ; skos:topConceptOf lvl:HigherEducationDegrees ; skos:notation "PhD" ; cur:rank 3 ;
    skos:prefLabel "Promotion (3. Stufe)"@de , "third cycle"@en ; skos:closeMatch lvl:EQF-8 .

lvl:AdvancedVocational a cur:LevelScheme ;
    skos:prefLabel "Fortbildungsstufen der höherqualifizierenden Berufsbildung (§ 53a BBiG)"@de , "advanced vocational levels"@en ;
    cur:levelDimension cv:dim_qualification ; cur:levelOrdering cv:ord_cumulative .
lvl:avt-specialist a cur:LevelConcept ; skos:inScheme lvl:AdvancedVocational ; skos:topConceptOf lvl:AdvancedVocational ; skos:notation "BS" ; cur:rank 1 ;
    skos:prefLabel "Geprüfte/r Berufsspezialist/in"@de ; skos:closeMatch lvl:DQR-5 .
lvl:avt-bachelor a cur:LevelConcept ; skos:inScheme lvl:AdvancedVocational ; skos:topConceptOf lvl:AdvancedVocational ; skos:notation "BP" ; cur:rank 2 ;
    skos:prefLabel "Bachelor Professional"@de ; skos:altLabel "Meister/in"@de , "Fachwirt/in"@de , "Techniker/in"@de ; skos:closeMatch lvl:DQR-6 .
lvl:avt-master a cur:LevelConcept ; skos:inScheme lvl:AdvancedVocational ; skos:topConceptOf lvl:AdvancedVocational ; skos:notation "MP" ; cur:rank 3 ;
    skos:prefLabel "Master Professional"@de ; skos:altLabel "Geprüfte/r Betriebswirt/in"@de ; skos:closeMatch lvl:DQR-7 .

# -----------------------------------------------------------------------------
# Bildungsstufe (ISCED 2011) – Brücke zu KIM-Bildungsstufe und OER-Metadaten
# -----------------------------------------------------------------------------
lvl:ISCED2011 a cur:LevelScheme ;
    skos:prefLabel "ISCED 2011 – Bildungsstufen"@de , "ISCED 2011 levels"@en ;
    cur:levelDimension cv:dim_stage ; cur:levelOrdering cv:ord_cumulative ;
    skos:scopeNote "Am Curriculum oder Geltungskontext, abgeleitet per Regel aus Bildungsbereich, Schulart und Jahrgang (Herkunft rule), wenn das Dokument sie nicht nennt."@de .
lvl:isced-0 a cur:LevelConcept ; skos:inScheme lvl:ISCED2011 ; skos:topConceptOf lvl:ISCED2011 ; skos:notation "0" ; cur:rank 0 ;
    skos:prefLabel "Frühkindliche Bildung, Betreuung und Erziehung"@de , "early childhood education"@en ;
    skos:exactMatch kimi11:level0 ; skos:closeMatch kimel:level_0 .
lvl:isced-01 a cur:LevelConcept ; skos:inScheme lvl:ISCED2011 ; skos:broader lvl:isced-0 ; skos:notation "01" ; cur:rank 0 ;
    skos:prefLabel "Frühkindliche Erziehung (unter 3 Jahren)"@de , "early childhood educational development"@en .
lvl:isced-02 a cur:LevelConcept ; skos:inScheme lvl:ISCED2011 ; skos:broader lvl:isced-0 ; skos:notation "02" ; cur:rank 0 ;
    skos:prefLabel "Elementarbereich (ab 3 Jahren bis Schuleintritt)"@de , "pre-primary education"@en .
lvl:isced-1 a cur:LevelConcept ; skos:inScheme lvl:ISCED2011 ; skos:topConceptOf lvl:ISCED2011 ; skos:notation "1" ; cur:rank 1 ;
    skos:prefLabel "Primarbereich"@de , "primary education"@en ; skos:exactMatch kimi11:level1 ; skos:closeMatch kimel:level_1 .
lvl:isced-2 a cur:LevelConcept ; skos:inScheme lvl:ISCED2011 ; skos:topConceptOf lvl:ISCED2011 ; skos:notation "2" ; cur:rank 2 ;
    skos:prefLabel "Sekundarbereich I"@de , "lower secondary education"@en ; skos:exactMatch kimi11:level2 ; skos:closeMatch kimel:level_2 .
lvl:isced-3 a cur:LevelConcept ; skos:inScheme lvl:ISCED2011 ; skos:topConceptOf lvl:ISCED2011 ; skos:notation "3" ; cur:rank 3 ;
    skos:prefLabel "Sekundarbereich II"@de , "upper secondary education"@en ; skos:exactMatch kimi11:level3 ; skos:closeMatch kimel:level_3 ;
    skos:scopeNote "In Deutschland auch die duale Berufsausbildung."@de .
lvl:isced-4 a cur:LevelConcept ; skos:inScheme lvl:ISCED2011 ; skos:topConceptOf lvl:ISCED2011 ; skos:notation "4" ; cur:rank 4 ;
    skos:prefLabel "Postsekundärer nicht tertiärer Bereich"@de , "post-secondary non-tertiary education"@en ; skos:exactMatch kimi11:level4 ; skos:closeMatch kimel:level_4 .
lvl:isced-5 a cur:LevelConcept ; skos:inScheme lvl:ISCED2011 ; skos:topConceptOf lvl:ISCED2011 ; skos:notation "5" ; cur:rank 5 ;
    skos:prefLabel "Kurzer tertiärer Bildungsgang"@de , "short-cycle tertiary education"@en ; skos:exactMatch kimi11:level5 ; skos:closeMatch kimel:level_5 .
lvl:isced-6 a cur:LevelConcept ; skos:inScheme lvl:ISCED2011 ; skos:topConceptOf lvl:ISCED2011 ; skos:notation "6" ; cur:rank 6 ;
    skos:prefLabel "Bachelor- bzw. gleichwertiges Bildungsprogramm"@de , "bachelor's or equivalent"@en ; skos:exactMatch kimi11:level6 ; skos:closeMatch kimel:level_6 .
lvl:isced-7 a cur:LevelConcept ; skos:inScheme lvl:ISCED2011 ; skos:topConceptOf lvl:ISCED2011 ; skos:notation "7" ; cur:rank 7 ;
    skos:prefLabel "Master- bzw. gleichwertiges Bildungsprogramm"@de , "master's or equivalent"@en ; skos:exactMatch kimi11:level7 ; skos:closeMatch kimel:level_7 .
lvl:isced-8 a cur:LevelConcept ; skos:inScheme lvl:ISCED2011 ; skos:topConceptOf lvl:ISCED2011 ; skos:notation "8" ; cur:rank 8 ;
    skos:prefLabel "Promotion bzw. gleichwertiges Bildungsprogramm"@de , "doctoral or equivalent"@en ; skos:exactMatch kimi11:level8 ; skos:closeMatch kimel:level_8 .

# -----------------------------------------------------------------------------
# Kompetenzstufen
# -----------------------------------------------------------------------------
lvl:CEFR a cur:LevelScheme ;
    skos:prefLabel "Gemeinsamer Europäischer Referenzrahmen für Sprachen (GER)"@de , "CEFR"@en ;
    cur:levelDimension cv:dim_proficiency ; cur:levelOrdering cv:ord_cumulative ;
    skos:exactMatch wd:Q221385 ;
    skos:scopeNote "Deskriptoren des Begleitbands 2020 ersetzen die Skalen von 2001. GER ↔ DQR ist kein Äquivalent (Sprachniveau ≠ Qualifikationsniveau): kein Mapping."@de .
