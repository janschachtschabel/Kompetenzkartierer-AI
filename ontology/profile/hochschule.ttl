hs:ct-ergaenzung a skos:Concept ; skos:inScheme hs:ComponentTypes ; skos:topConceptOf hs:ComponentTypes ; skos:prefLabel "Ergänzungsmodul"@de .
hs:ct-sq a skos:Concept ; skos:inScheme hs:ComponentTypes ; skos:topConceptOf hs:ComponentTypes ; skos:prefLabel "Schlüsselqualifikationsmodul"@de ; skos:altLabel "SQ-Modul"@de .
hs:ct-interdisziplinaer a skos:Concept ; skos:inScheme hs:ComponentTypes ; skos:topConceptOf hs:ComponentTypes ; skos:prefLabel "Interdisziplinäres Modul"@de .

hs:RecognitionProcedures a skos:ConceptScheme ; skos:prefLabel "Anrechnungsverfahren"@de .
hs:rp-pauschal a skos:Concept ; skos:inScheme hs:RecognitionProcedures ; skos:topConceptOf hs:RecognitionProcedures ; skos:prefLabel "pauschal"@de .
hs:rp-individuell a skos:Concept ; skos:inScheme hs:RecognitionProcedures ; skos:topConceptOf hs:RecognitionProcedures ; skos:prefLabel "individuell"@de .
hs:rp-kombiniert a skos:Concept ; skos:inScheme hs:RecognitionProcedures ; skos:topConceptOf hs:RecognitionProcedures ; skos:prefLabel "kombiniert"@de .

hs:IgnoredFields a skos:ConceptScheme ; skos:prefLabel "Nicht zu extrahierende Felder"@de .
hs:if-person a skos:Concept ; skos:inScheme hs:IgnoredFields ; skos:topConceptOf hs:IgnoredFields ; skos:prefLabel "Personenangaben"@de ;
    skos:definition "Modulverantwortliche, Lehrende, Kontaktdaten: Personendaten, werden nicht gespeichert. Die Überschrift dient nur als Feldgrenze."@de .
hs:if-literatur a skos:Concept ; skos:inScheme hs:IgnoredFields ; skos:topConceptOf hs:IgnoredFields ; skos:prefLabel "Literatur"@de ;
    skos:definition "Literaturlisten; als Feldgrenze erkennen, Inhalt nicht als Aussagen extrahieren."@de .

# =============================================================================
# 6. Von Hand ergänzte Hinweise (Homonyme aus HCO-Vokabularen, Formmuster,
#    überfachliche Kompetenzbereiche); das portierte Feldlexikon steht in
#    hochschule-lexikon.ttl.
# =============================================================================
hs:Terminology a cur:TerminologyProfile ;
    rdfs:label "Terminologie Hochschule"@de ;
    cur:profileScope cv:sec_higher ;
    cur:hasCue hs:cue-th , hs:cue-ba , hs:cue-ue , hs:cue-modulcode , hs:cue-modulkopf , hs:cue-lp , hs:cue-sws , hs:cue-semester ,
        hs:cue-uek-dig , hs:cue-uek-bne , hs:cue-uek-ent , hs:cue-uek-ink , hs:cue-uek-int , hs:cue-uek-eth , hs:cue-uek-res ,
        hs:cue-qz-wb , hs:cue-qz-ew , hs:cue-qz-pe , hs:cue-qz-ge , hs:cue-literatur , hs:cue-dualkurz .

hs:cue-th a cur:LexicalCue ; cur:surfaceForm "Technische Hochschule" ; cur:cueRole cv:role_homonym ; cur:cueKind cv:ck_term ;
    cur:mapsTo hs:it-haw ; cur:alsoMapsTo hs:it-uni ; cur:strength 0.5 ;
    cur:recognitionHint "In BY und NW meist HAW; einige Technische Hochschulen sind Universitäten (RWTH, KIT-Vorläufer). Hochschultyp aus Grundordnung oder Landesgesetz, nicht aus dem Namen."@de .
hs:cue-ba a cur:LexicalCue ; cur:surfaceForm "BA" ; cur:cueRole cv:role_homonym ; cur:cueKind cv:ck_term ;
    cur:mapsTo hs:it-dual ; cur:alsoMapsTo hs:deg-BA ; cur:strength 0.4 ;
    cur:recognitionHint "„Berufsakademie“ nur als Herausgeber; „B.A.“ oder „Bachelor of Arts“ hinter dem Studiengang ist der Grad."@de .
hs:cue-ue a cur:LexicalCue ; cur:surfaceForm "UE" ; cur:cueRole cv:role_homonym ; cur:cueKind cv:ck_term ;
    cur:mapsTo hs:tf-uebung ; cur:alsoMapsTo cv:unit_teachingUnit ; cur:strength 0.4 ;
    cur:recognitionHint "In Lehrformangaben (2 V + 2 UE) Übung; mit Zahl als Umfang (40 UE) Unterrichtseinheit."@de .
hs:cue-modulcode a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_codePattern ;
    cur:pattern "^[A-Z]{2,6}[-_ ]?[A-Z]{0,3}[-_ ]?\\d{2,4}[a-z]?\\b" ; cur:mapsTo hs:Modul , cur:code ; cur:strength 0.7 ;
    cur:positiveExample "INF-B-110 Grundlagen der Programmierung" , "MA 1001 Analysis I" , "BWL202 Kostenrechnung" ;
    cur:negativeExample "Modulhandbuch Informatik" , "Modulprüfung" , "Modulverantwortliche:r" , "2024 Fassung" ;
    cur:recognitionHint "Codes beginnen mit Buchstabenkürzel und Nummer; Code + Hochschule ist der Zusammenführungsschlüssel über Dokumente."@de .
hs:cue-modulkopf a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_headingPattern ;
    cur:pattern "^Modul\\s+([A-Z0-9][\\w.-]*\\s*)?[:–-]\\s*\\S" ; cur:mapsTo hs:Modul ; cur:strength 0.75 ;
    cur:positiveExample "Modul 3: Datenbanken" , "Modul INF-110 – Programmierung" ;
    cur:negativeExample "Modulhandbuch Informatik" , "Modulprüfung" , "Modulverantwortliche:r" , "Modul" ;
    skos:editorialNote "Ersetzt das HCO-Muster ^Modul, das Modulhandbuch, Modulprüfung und Modulverantwortliche:r traf."@de .
hs:cue-lp a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
    cur:pattern "\\b(\\d+(,\\d+)?)\\s*(LP|CP|ECTS|ECTS-Punkte|Leistungspunkte|Credits)\\b" ; cur:mapsTo cv:unit_ectsCredit ; cur:strength 0.9 ;
    cur:positiveExample "8 LP" , "7,5 ECTS" , "30 Leistungspunkte" ; cur:negativeExample "LP-Vergabe" , "ECTS-Grade" ;
    cur:recognitionHint "cur:workload mit cv:unit_ectsCredit und cv:wl_credits; am Modul Regelwert, an der Verwendung im Kontext, am Bereich gefordert (cur:minAmount)."@de .
hs:cue-sws a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
    cur:pattern "\\b(\\d+)\\s*SWS\\b" ; cur:mapsTo hs:sws ; cur:strength 0.9 ;
    cur:positiveExample "4 SWS" , "2 SWS V + 2 SWS Ü" ; cur:negativeExample "SWS-Angabe" ;
    cur:negativeHint "SWS sind keine Arbeitsstunden und keine LP."@de .
hs:cue-semester a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_tablePattern ;
    cur:pattern "^(\\d)\\.\\s*(FS|Sem\\.?|Semester|Fachsemester)$" ; cur:mapsTo cv:time_semester ; cur:strength 0.85 ;
    cur:positiveExample "3. Semester" , "1. FS" , "5. Fachsemester" ; cur:negativeExample "Semesterwochenstunden" , "jedes Semester" ;
    cur:recognitionHint "Spalte im Verlaufsplan = empfohlenes Fachsemester an cur:Placement (cur:isRecommendation true)."@de .
hs:cue-uek-dig a cur:LexicalCue ; cur:surfaceForm "Digitalkompetenz" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:mapsTo qz:DigitalWorld ; cur:strength 0.7 ;
    cur:recognitionHint "Auch „Data Literacy“, „KI-Kompetenz“."@de .
hs:cue-uek-bne a cur:LexicalCue ; cur:surfaceForm "Nachhaltigkeit" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:mapsTo qz:BNE ; cur:strength 0.6 .
hs:cue-uek-ent a cur:LexicalCue ; cur:surfaceForm "Entrepreneurship" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:mapsTo qz:Entrepreneurship ; cur:strength 0.7 .
hs:cue-uek-ink a cur:LexicalCue ; cur:surfaceForm "Umgang mit Heterogenität" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:mapsTo qz:Diversity ; cur:strength 0.7 .
hs:cue-uek-int a cur:LexicalCue ; cur:surfaceForm "Internationalisierung" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:mapsTo qz:Intercultural ; cur:strength 0.6 .
hs:cue-uek-eth a cur:LexicalCue ; cur:surfaceForm "Gute wissenschaftliche Praxis" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:mapsTo qz:Ethics ; cur:strength 0.7 .
hs:cue-uek-res a cur:LexicalCue ; cur:surfaceForm "Forschendes Lernen" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:mapsTo qz:Research ; cur:strength 0.7 .
hs:cue-qz-wb a cur:LexicalCue ; cur:surfaceForm "wissenschaftliche Befähigung" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:mapsTo qz:mrvo-WB ; cur:strength 0.8 .
hs:cue-qz-ew a cur:LexicalCue ; cur:surfaceForm "Befähigung zu einer qualifizierten Erwerbstätigkeit" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:mapsTo qz:mrvo-EW ; cur:strength 0.9 .
hs:cue-qz-pe a cur:LexicalCue ; cur:surfaceForm "Persönlichkeitsentwicklung" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:mapsTo qz:mrvo-PE ; cur:strength 0.8 .
hs:cue-qz-ge a cur:LexicalCue ; cur:surfaceForm "gesellschaftliches Engagement" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:mapsTo qz:mrvo-GE ; cur:strength 0.8 .
hs:cue-literatur a cur:LexicalCue ; cur:surfaceForm "Literatur" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:occursIn cv:occ_heading ;
    cur:mapsTo hs:if-literatur ; cur:strength 0.85 ; cur:recognitionHint "Feldgrenze im Modulsteckbrief; Literaturangaben nicht als Aussagen."@de .
hs:cue-dualkurz a cur:LexicalCue ; cur:surfaceForm "dual" ; cur:cueRole cv:role_homonym ; cur:cueKind cv:ck_term ;
    cur:mapsTo hs:sm-dual-praxis ; cur:alsoMapsTo hs:sm-berufsbegleitend ; cur:strength 0.4 ;
    cur:recognitionHint "Nur als dual klassifizieren, wenn curriculare und organisatorische Verzahnung der Lernorte beschrieben ist (WR 2013); ausbildungsintegrierend nur mit Berufsabschluss."@de .
