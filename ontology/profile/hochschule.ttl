@prefix hs:    <https://w3id.org/wlo/curriculum/profile/higher-education#> .
@prefix cur:   <https://w3id.org/wlo/curriculum/core#> .
@prefix cv:    <https://w3id.org/wlo/curriculum/vocab#> .
@prefix lvl:   <https://w3id.org/wlo/curriculum/level/> .
@prefix qz:    <https://w3id.org/wlo/curriculum/crosscutting/> .
@prefix kd:    <https://w3id.org/wlo/curriculum/dimension/> .
@prefix land:  <https://w3id.org/wlo/curriculum/region/> .
@prefix ctx:   <https://w3id.org/wlo/curriculum/context/> .
@prefix fld:   <https://w3id.org/wlo/curriculum/field/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix kimsa: <https://w3id.org/kim/schularten/> .
@prefix kimsf: <http://w3id.org/kim/schulfaecher/> .

# =============================================================================
# Profil Hochschule (hs:) – Studien- und Prüfungsordnungen (Rahmen-PO +
# fachspezifische Bestimmungen), Modulhandbücher, Studienverlaufspläne,
# Diploma Supplement, Zertifikats- und Promotionsordnungen.
#
# Ein Modul wird einmal beschrieben (cur:CurriculumNode im Modulhandbuch) und
# über cur:Placement in jedem Studiengang mit eigenen Werten verwendet
# (Verbindlichkeit, Fachsemester, LP im Kontext, Notengewicht, Fundstelle).
# Ein Studiengang hat mehrere Dokumente; Konflikte löst cur:ConflictResolution
# (Kohorte → Verbindlichkeit → Spezifität → Aktualität → Mensch). Die Felder
# des Modulsteckbriefs sind die stärksten Segmentierungssignale: das
# Feldlexikon (hochschule-lexikon.ttl) bildet Überschriften auf
# Kern-Eigenschaften ab und ersetzt den LLM für die Feldzuordnung.
#
# Quellen: HCO v1.0 (cc-core, hco, hco-vocab 39 Schemata, hco-lexicon 396
# Einträge, hco-shapes, Modulhandbuch-Beispiel), Deep-Research-Bericht
# Hochschule, App-Profil hochschule (Studienrichtung als Bereich).
# =============================================================================

<https://w3id.org/wlo/curriculum/profile/higher-education> a owl:Ontology ;
    dct:title "Curriculum-Profil Hochschule"@de , "curriculum profile higher education"@en ;
    owl:imports <https://w3id.org/wlo/curriculum/core> , <https://w3id.org/wlo/curriculum/vocab> ,
        <https://w3id.org/wlo/curriculum/level> , <https://w3id.org/wlo/curriculum/dimension> ,
        <https://w3id.org/wlo/curriculum/crosscutting> , <https://w3id.org/wlo/curriculum/field> ;
    owl:versionInfo "1.0-entwurf" ;
    dct:created "2026-10-19"^^xsd:date .

# =============================================================================
# 1. Profil-Eigenschaften
# =============================================================================
hs:annexOf a owl:ObjectProperty ; rdfs:subPropertyOf dct:isPartOf ; rdfs:domain cur:Document ; rdfs:range cur:Document ;
    rdfs:label "Anlage zu"@de , "annex of"@en ;
    skos:definition "Das Dokument ist Anlage einer Ordnung („Das Modulhandbuch ist Anlage der Prüfungsordnung“) und teilt dann deren Verbindlichkeit (cv:bind_binding); sonst ist ein Modulhandbuch cv:bind_informative."@de .
hs:mrvoVersion a owl:ObjectProperty ; rdfs:domain cur:Document ;
    rdfs:label "MRVO-Fassung"@de , "MRVO version"@en ;
    skos:definition "Fassung der Musterrechtsverordnung, nach der Modulbeschreibungen gegliedert sind; bestimmt die Pflichtfelder (Profilregeln)."@de .
hs:academicDegree a owl:ObjectProperty ; rdfs:domain cur:Qualification ;
    rdfs:label "akademischer Grad"@de , "academic degree"@en .
hs:studyMode a owl:ObjectProperty ;
    rdfs:label "Studienform"@de , "study mode"@en ;
    skos:definition "Vollzeit, Teilzeit, dual (ausbildungs-, praxis-, berufsintegrierend), berufsbegleitend, Fernstudium. „dual“ nur bei beschriebener Verzahnung der Lernorte (WR 2013) – dann Brücke zu beruf:."@de .
hs:programmeType a owl:ObjectProperty ; rdfs:label "Studiengangstyp"@de , "programme type"@en .
hs:programmeProfile a owl:ObjectProperty ; rdfs:label "Studiengangsprofil"@de , "programme profile"@en .
hs:teacherTrainingType a owl:ObjectProperty ; rdfs:label "Lehramtstyp"@de , "teacher training type"@en .
hs:partialProgrammeRole a owl:ObjectProperty ; rdfs:domain cur:Curriculum ;
    rdfs:label "Rolle im Kombinationsstudium"@de , "partial programme role"@en ;
    skos:definition "Rolle eines Teilstudiengangs (Kernfach, Nebenfach, Erstfach, Unterrichtsfach, Bildungswissenschaften). Jedes Fach ist ein eigenes cur:Curriculum mit eigenem Fach-Andockpunkt, verbunden über cur:partOf mit dem Gesamtstudiengang (cur:Programme)."@de .
hs:teachingSubject a owl:ObjectProperty ;
    rdfs:label "Unterrichtsfach"@de , "teaching subject"@en ;
    skos:definition "Schulfach, für das ein Lehramts-Teilstudiengang ausbildet (KIM-Schulfächer). Direkter Andockpunkt zum Profil schul:."@de .
hs:sws a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "Semesterwochenstunden"@de , "semester weekly hours"@en ;
    skos:definition "Präsenzumfang einer Lehrveranstaltung; keine Arbeitsstunden und nie in LP umrechnen."@de .
hs:durationSemesters a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "Dauer in Semestern"@de , "duration in semesters"@en .
hs:standardDurationSemesters a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "Regelstudienzeit"@de , "standard period of study"@en .
hs:offerFrequency a owl:ObjectProperty ; rdfs:label "Angebotsturnus"@de , "offer frequency"@en .
hs:teachingFormat a owl:ObjectProperty ; rdfs:label "Lehrform"@de , "teaching format"@en .
hs:instructionLanguage a owl:DatatypeProperty ; rdfs:range xsd:language ;
    rdfs:label "Lehrsprache"@de , "language of instruction"@en ;
    skos:definition "BCP-47-Sprachcode (de, en); mehrere Werte bei wahlweiser Sprache."@de .
hs:componentType a owl:ObjectProperty ;
    rdfs:label "Modultyp (lokal)"@de , "component type"@en ;
    skos:definition "Nur setzen, wenn das Dokument den Typ nennt (Basis-, Aufbau-, Vertiefungsmodul …)."@de .
hs:creditAwardCondition a owl:DatatypeProperty ; rdfs:range rdf:langString ;
    rdfs:label "Voraussetzungen für die Vergabe von Leistungspunkten (Wortlaut)"@de , "credit award condition"@en .
hs:gradingText a owl:DatatypeProperty ; rdfs:range rdf:langString ;
    rdfs:label "Benotung (Wortlaut)"@de , "grading text"@en ;
    skos:definition "Wortlaut; cur:graded (boolean) und cur:gradeWeight (an cur:Placement) sind die Normwerte."@de .
hs:usabilityText a owl:DatatypeProperty ; rdfs:range rdf:langString ;
    rdfs:label "Verwendbarkeit (Wortlaut)"@de , "usability text"@en ;
    skos:definition "Liefert nur Kandidaten für cur:Placement; bestätigt erst, wenn eine Modulübersicht oder ein Verlaufsplan das Modul ebenfalls nennt."@de .
hs:recognitionProcedure a owl:ObjectProperty ; rdfs:domain cur:RecognitionRule ;
    rdfs:label "Anrechnungsverfahren"@de , "recognition procedure"@en .
hs:scopeQualification a owl:ObjectProperty ;
    rdfs:label "Geltung Abschlussart"@de , "scope qualification type"@en ;
    skos:definition "Lexikongeltung nach Abschlussart (Staatsexamen, Diplom/Magister), z. B. „Grundstudium“."@de .

# =============================================================================
# 2. Dokumenttypen (HCO, 21; der Typ bestimmt nie die Verbindlichkeit)
# =============================================================================
hs:DocumentTypes a skos:ConceptScheme ; skos:prefLabel "Dokumenttypen Hochschule"@de .

hs:dt-Ordnung a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Ordnung/Satzung"@de .
hs:dt-RahmenPO a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Rahmen-/Allgemeine Prüfungsordnung"@de ;
    skos:altLabel "Allgemeine Prüfungsordnung"@de , "Rahmenprüfungsordnung"@de , "Allgemeine Studien- und Prüfungsordnung"@de , "Allgemeine Bestimmungen"@de ;
    skos:scopeNote "Fachspezifische Bestimmungen erben davon (cur:inheritsFrom); das lokale Dokument überschreibt den Rahmen."@de .
hs:dt-Studienordnung a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Studienordnung"@de ; skos:altLabel "Studiengangsordnung"@de .
hs:dt-Pruefungsordnung a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "(Fach-)Prüfungsordnung"@de ; skos:altLabel "Fachprüfungsordnung"@de , "Fachspezifische Bestimmungen"@de , "Besonderer Teil"@de .
hs:dt-SPO a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Studien- und Prüfungsordnung"@de ; skos:altLabel "Prüfungs- und Studienordnung"@de , "Fachprüfungs- und Studienordnung"@de .
hs:dt-Zugangsordnung a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Zugangs-/Zulassungsordnung"@de ; skos:altLabel "Zulassungssatzung"@de , "Auswahlsatzung"@de .
hs:dt-Praxisordnung a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Praktikums-/Praxisphasenordnung"@de ; skos:altLabel "Praktikumsordnung"@de , "Praxissemesterordnung"@de .
hs:dt-Anrechnungsordnung a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Anrechnungs-/Anerkennungsordnung"@de ; skos:altLabel "Äquivalenzliste"@de .
hs:dt-Aenderungssatzung a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Änderungssatzung/-ordnung"@de ;
    skos:scopeNote "Ändert eine Ordnung (cur:amends), ersetzt sie nicht; erst die konsolidierte neue Fassung ersetzt die alte (cur:supersedes) ab Inkrafttreten, oft mit Kohortenregel."@de .
hs:dt-Weiterbildungsordnung a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Ordnung für weiterbildende Studienangebote"@de ; skos:altLabel "Zertifikatsordnung"@de .
hs:dt-Promotionsordnung a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Promotionsordnung"@de .
hs:dt-Modulhandbuch a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_catalogue ;
    skos:prefLabel "Modulhandbuch"@de ; skos:altLabel "Modulkatalog"@de , "Modulbeschreibungen"@de , "Modulverzeichnis"@de ;
    skos:scopeNote "Verbindlich nur als Anlage einer Ordnung (hs:annexOf)."@de .
hs:dt-Studienverlaufsplan a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_curriculum ;
    skos:prefLabel "Studienverlaufsplan"@de ; skos:altLabel "Studienplan"@de , "Musterstudienplan"@de , "Regelstudienplan"@de ;
    skos:scopeNote "Liefert Fachsemester an cur:Placement (cv:time_semester, meist empfohlen)."@de .
hs:dt-Studiengangsprofil a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_other ;
    skos:prefLabel "Studiengangsbeschreibung/-profil"@de ; skos:altLabel "Qualifikationsprofil"@de , "Studiengangsflyer"@de .
hs:dt-DiplomaSupplement a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_other ;
    skos:prefLabel "Diploma Supplement"@de ;
    skos:scopeNote "Programm-Lernergebnisse in Abschnitt 4.2."@de .
hs:dt-Akkreditierung a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_other ;
    skos:prefLabel "Akkreditierungsunterlage"@de ; skos:altLabel "Selbstbericht"@de , "Akkreditierungsbericht"@de .
hs:dt-Vorlesungsverzeichnis a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_catalogue ;
    skos:prefLabel "Vorlesungsverzeichnis"@de ;
    skos:scopeNote "Semesterbezogen; liefert Lehrveranstaltungen, selten Lernergebnisse."@de .
hs:dt-MicroCredential a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_curriculum ;
    skos:prefLabel "Micro-Credential-Beschreibung"@de .
hs:dt-Externe a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Staatliche/fachrechtliche Vorgabe"@de .
hs:dt-Lehramt a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Lehramtsrechtliche Vorgabe"@de ; skos:altLabel "Lehramtsprüfungsordnung"@de , "Lehramtszugangsverordnung"@de , "Lehrerbildungsgesetz"@de .
hs:dt-Staatsexamen a cur:DocumentType ; skos:inScheme hs:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Approbations-/Ausbildungsordnung (Staatsexamen)"@de ; skos:altLabel "Approbationsordnung"@de , "Juristenausbildungsgesetz"@de .

# =============================================================================
# 3. Knotentypen
# =============================================================================
hs:NodeTypes a skos:ConceptScheme ; skos:prefLabel "Knotentypen Hochschule"@de .

hs:Ordnungsteil a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "Paragraf/Ordnungsteil"@de ; cur:extractionDepth cv:depth_typed ;
    skos:definition "§§ einer Ordnung (Geltungsbereich, Regelstudienzeit, Prüfungen, Anrechnung, Wiederholung). Liefert cur:Rule, cur:Assessment und Werte des Studiengangs; keine Lernergebnisse."@de .
hs:Studiengangsprofil a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "Qualifikationsziele des Studiengangs"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Abschnitt mit Programm-Lernergebnissen (Ziele des Studiums, Kompetenzprofil, Diploma Supplement 4.2)."@de .
hs:Studienabschnitt a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_grouping ;
    skos:prefLabel "Studienabschnitt"@de ; skos:altLabel "Studienphase"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Grund-/Hauptstudium, Orientierungsphase, Vorklinik/Klinik, Studienjahr (DHBW)."@de ;
    cur:impliesTimeKind cv:time_semester .
hs:Studienbereich a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Studienbereich"@de ; skos:altLabel "Modulbereich"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Bereich mit zugeordneten Modulen und gefordertem Umfang (Pflichtbereich, Wahlpflichtbereich, Schlüsselqualifikationen, Studium generale)."@de ;
    cur:delimitation "Nur als Knoten werten, wenn Module oder LP zugeordnet sind; „Studienbereich“ ist auch eine Ebene der Destatis-Fächersystematik."@de .
hs:Schwerpunkt a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Schwerpunkt/Studienrichtung"@de ; skos:altLabel "Vertiefungsrichtung"@de , "Profillinie"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Bereich mit gefordertem Umfang, von dem genau einer zu wählen ist; zugleich cur:Variant (cv:var_specialisation) für die Geltung. Ein eigenes Curriculum nur, wenn das Dokument die Richtungen als eigene Studiengänge mit eigenem Abschluss führt."@de .
hs:Wahlpflichtkatalog a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Wahlpflichtkatalog"@de ; skos:altLabel "Modulgruppe"@de , "Wahlkatalog"@de , "Modulpool"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Liste wählbarer Module mit cur:SelectionRule („mindestens 20 LP aus …“, „zwei aus fünf“); die Module sind Placements mit cv:obl_selectionPool."@de .
hs:Modul a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Modul"@de ; skos:altLabel "Moduleinheit"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Modulbeschreibung im Modulhandbuch (Code, Titel, LP, Workload, Dauer, Turnus, Lernergebnisse, Inhalte, Prüfung). Einmal beschrieben, über cur:Placement mehrfach verwendet."@de ;
    cur:typicalParent hs:Studienbereich , hs:Wahlpflichtkatalog , hs:Schwerpunkt ;
    cur:positiveExample "„INF-B-110 Grundlagen der Programmierung (8 LP)“"@de ;
    cur:negativeExample "„Modulhandbuch Informatik“ (Dokumenttitel)"@de , "„Modulprüfung“ (Feld)"@de .
hs:Praxisphase a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Praxisphase"@de ; skos:altLabel "Praxissemester"@de , "Pflichtpraktikum"@de , "Praxismodul"@de ; cur:extractionDepth cv:depth_full ;
    cur:impliesContext ctx:practice-placement .
hs:Abschlussarbeit a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Abschlussarbeit"@de ; skos:altLabel "Bachelorarbeit"@de , "Masterarbeit"@de , "Abschlussmodul"@de ; cur:extractionDepth cv:depth_full .
hs:Projektmodul a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Projekt"@de ; skos:altLabel "Projektmodul"@de , "Studienprojekt"@de , "Teamprojekt"@de ; cur:extractionDepth cv:depth_full .
hs:KuenstlerischesHauptfach a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Künstlerisches Hauptfach"@de ; skos:altLabel "Künstlerisches Kernfach"@de ; cur:extractionDepth cv:depth_full ;
    skos:scopeNote "Darf mehr als zwei Semester dauern."@de .
hs:Lehrveranstaltung a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_subunit ;
    skos:prefLabel "Lehrveranstaltung"@de ; skos:altLabel "Teilmodul"@de , "Modulteil"@de , "Modulelement"@de ; cur:extractionDepth cv:depth_full ;
    cur:typicalParent hs:Modul ;
    cur:delimitation "Liegt unter dem Modul; nie als Modul klassifizieren."@de .
hs:Verzeichnis a cur:NodeType ; skos:inScheme hs:NodeTypes ; skos:broader cv:fn_nonCurricular ;
    skos:prefLabel "Verzeichnis/Impressum"@de ; cur:extractionDepth cv:depth_skip .

# =============================================================================
# 4. Aussage-Unterarten
# =============================================================================
hs:StatementSubkinds a skos:ConceptScheme ; skos:prefLabel "Aussage-Unterarten Hochschule"@de .

hs:Studiengangsziel a cur:StatementSubkind ; skos:inScheme hs:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
    skos:prefLabel "Lernergebnis des Studiengangs"@de ; skos:altLabel "Programm-Lernergebnis"@de ;
    skos:definition "„Absolventinnen und Absolventen verfügen über …“, „Das Studium befähigt …“, Diploma Supplement 4.2."@de ;
    cur:segmentation cv:seg_bullet ; cur:defaultAddressee cv:addr_learner .
hs:Modulziel a cur:StatementSubkind ; skos:inScheme hs:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
    skos:prefLabel "Lernergebnis des Moduls"@de ; skos:altLabel "Qualifikationsziel"@de , "angestrebtes Lernergebnis"@de ;
    skos:definition "Lernergebnis im Feld „Qualifikationsziele“ (MRVO 2017) bzw. „angestrebte Lernergebnisse und Studieninhalte“ (MRVO 2024). Der Feldname schwankt stark; die DHBW teilt das Feld in vier Unterfelder (kd:DHBW)."@de ;
    cur:segmentation cv:seg_bullet ; cur:defaultAddressee cv:addr_learner ;
    cur:wordingRule "Einleitungssatz („Nach erfolgreichem Abschluss des Moduls können die Studierenden …“) in cur:leadIn; jeder Spiegelstrich bzw. Satz eine Aussage."@de .
hs:Vermittlungsziel a cur:StatementSubkind ; skos:inScheme hs:StatementSubkinds ; skos:broader cv:kind_content ;
    skos:prefLabel "Lehrziel (Lehrendenperspektive)"@de ;
    skos:definition "„Ziel der Veranstaltung ist es, … zu vermitteln“ – Lehrendenperspektive, gilt als Inhalt, nicht als Lernergebnis."@de ;
    cur:defaultAddressee cv:addr_educator .
hs:Inhalt a cur:StatementSubkind ; skos:inScheme hs:StatementSubkinds ; skos:broader cv:kind_content ;
    skos:prefLabel "Modulinhalt"@de ;
    cur:wordingRule "Die Sammelfelder „Inhalte und Qualifikationsziele des Moduls“ (MRVO 2017) und „angestrebte Lernergebnisse und Studieninhalte“ (MRVO 2024) in Lernergebnis- und Inhaltsaussagen auftrennen."@de .
hs:Verweis a cur:StatementSubkind ; skos:inScheme hs:StatementSubkinds ; skos:broader cv:kind_reference ;
    skos:prefLabel "Verweis/Importmodul"@de ;
    skos:definition "„siehe Modulbeschreibung“, „gemäß Modulhandbuch des Studiengangs“, „aus dem Angebot der Fakultät“; zitierte Kennung in cur:citedCode, nie auflösen raten (cur:resolutionStatus)."@de .
hs:Hinweis a cur:StatementSubkind ; skos:inScheme hs:StatementSubkinds ; skos:broader cv:kind_guidance ;
    skos:prefLabel "Hinweis/Literatur"@de .

# =============================================================================
# 5. Wertelisten (aus HCO, bereinigt)
# =============================================================================
hs:MRVOVersions a skos:ConceptScheme ; skos:prefLabel "MRVO-Fassungen"@de .
hs:mrvo-2017 a skos:Concept ; skos:inScheme hs:MRVOVersions ; skos:topConceptOf hs:MRVOVersions ; skos:prefLabel "MRVO 2017"@de ;
    skos:scopeNote "KMK-Beschluss 07.12.2017; Pflichtangaben einschließlich Verwendbarkeit."@de .
hs:mrvo-2024 a skos:Concept ; skos:inScheme hs:MRVOVersions ; skos:topConceptOf hs:MRVOVersions ; skos:prefLabel "MRVO 2024"@de ;
    skos:scopeNote "KMK-Beschluss 21.11.2024; in allen Ländern umgesetzt, meist ab 01.08.2025 (BB 01.09.2025). § 7 Abs. 2 nennt acht Pflichtangaben: 1. angestrebte Lernergebnisse und Studieninhalte, 2. Lehr- und Lernformen, 3. Voraussetzungen für die Teilnahme, 4. Voraussetzungen für die Vergabe von ECTS-Leistungspunkten, 5. ECTS-Leistungspunkte und Benotung, 6. Häufigkeit des Angebots, 7. Arbeitsaufwand, 8. Dauer. Die Verwendbarkeit ist keine Pflichtangabe mehr (HB: weiter für Lehramtsmodule). § 12: Module sollen mindestens 5 ECTS-Leistungspunkte umfassen."@de ;
    skos:editorialNote "Landesverordnungen nur für BY und TH im Verordnungsblatt gelesen, sonst über die Synopsen des Akkreditierungsrats (Recherche 04 A, 2026-10-20)."@de .

