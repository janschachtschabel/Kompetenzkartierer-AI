    skos:prefLabel "Ästhetische Bildung"@de ; skos:closeMatch qz:Cultural .
elem:f-bildnerisch a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-aesthetik ; skos:prefLabel "Bildnerisches Gestalten"@de ; skos:relatedMatch kimsf:s1015 .
elem:f-musik a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-aesthetik ; skos:prefLabel "Musik und Rhythmik"@de ; skos:relatedMatch kimsf:s1020 .
elem:f-tanz-darstellendes-spiel a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-aesthetik ; skos:prefLabel "Tanz und darstellendes Spiel"@de ; skos:relatedMatch kimsf:s1004 .
elem:f-sinneswahrnehmung a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-aesthetik ; skos:prefLabel "Sinneswahrnehmung"@de .

elem:f-koerper a skos:Concept ; skos:inScheme elem:Fields ; skos:topConceptOf elem:Fields ; skos:notation "3.2.6" ;
    skos:prefLabel "Körper, Bewegung, Gesundheit und Prävention"@de ; skos:closeMatch qz:Health .
elem:f-bewegung a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-koerper ; skos:prefLabel "Bewegung"@de ; skos:relatedMatch kimsf:s1031 .
elem:f-gesundheit-ernaehrung a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-koerper ; skos:prefLabel "Gesundheit, Ernährung und Hygiene"@de .
elem:f-koerperwahrnehmung-sexualitaet a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-koerper ; skos:prefLabel "Körperwahrnehmung und Sexualität"@de ;
    skos:relatedMatch qz:SexualEducation .
elem:f-praevention-sicherheit a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-koerper ; skos:prefLabel "Prävention und Sicherheit"@de ;
    skos:editorialNote "ELEM-Mapping auf DigComp „Safety“ verworfen: Körper-/Unfallprävention ist keine digitale Sicherheit."@de .

elem:f-umwelt-bne a skos:Concept ; skos:inScheme elem:Fields ; skos:topConceptOf elem:Fields ; skos:notation "3.2.7" ;
    skos:prefLabel "Umweltbildung und Bildung für nachhaltige Entwicklung"@de .
elem:f-natur-oekologie a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-umwelt-bne ; skos:prefLabel "Naturerfahrung und Ökologie"@de .
elem:f-bne a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-umwelt-bne ; skos:prefLabel "Bildung für nachhaltige Entwicklung"@de ;
    skos:exactMatch qz:BNE ;
    skos:scopeNote "BNE ist Bereich (ST) oder Leitprinzip (BW); der Knotentyp entscheidet. Querschnittsfragen laufen über qz:BNE."@de .

# =============================================================================
# 7. Pädagogische Prinzipien (Quellschema am Querschnitts-Hub)
#    Prinzipien des ELEM-Themenkanons, die keine Weltausschnitte sind.
#    „Beobachtung und Dokumentation“, „Übergänge“ und „Zusammenarbeit“ sind
#    Knotentypen (Rahmenteile), keine Themen.
# =============================================================================
elem:Principles a skos:ConceptScheme ; skos:prefLabel "Pädagogische Prinzipien Elementarbildung"@de .

elem:p-kinderrechte a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Kinderrechte"@de ; skos:broadMatch qz:ChildrensRights .
elem:p-partizipation a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Partizipation"@de ; skos:broadMatch qz:ChildrensRights ; skos:relatedMatch qz:Democracy .
elem:p-kinderschutz a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Kinderschutz"@de ; skos:exactMatch qz:ChildProtection .
elem:p-inklusion a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Inklusion"@de ; skos:broadMatch qz:Diversity .
elem:p-diversitaet a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Diversität und vorurteilsbewusste Bildung"@de ; skos:broadMatch qz:Diversity .
elem:p-geschlechtersensibel a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Geschlechtersensible Pädagogik"@de ; skos:closeMatch qz:GenderEquality .
elem:p-spiel a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Spiel als Lernform"@de .
elem:p-alltagsintegration a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Alltagsintegrierte Bildung"@de .
elem:p-ko-konstruktion a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Ko-Konstruktion"@de .
elem:p-bindung-beziehung a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Bindung und Beziehung"@de .
elem:p-uebergaenge a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Übergänge gestalten"@de ; skos:exactMatch qz:Transitions .
elem:p-zusammenarbeit-familie a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Zusammenarbeit mit Familien"@de ; skos:exactMatch qz:FamilyPartnership .
elem:p-sozialraum a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Sozialraum und Vernetzung"@de .
elem:p-umgang-mit-veraenderung a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Umgang mit Veränderungen und Herausforderungen"@de ; skos:relatedMatch kd:ec-resilience ;
    skos:scopeNote "Leitmotiv HH 2024."@de .
elem:p-bne a cur:CrossCuttingObjective ; skos:inScheme elem:Principles ; skos:topConceptOf elem:Principles ; cur:objectiveType cv:obj_principle ;
    skos:prefLabel "Bildung für nachhaltige Entwicklung (Leitprinzip)"@de ; skos:exactMatch qz:BNE .

# =============================================================================
# 8. Terminologieprofil: von Hand ergänzte Hinweise (Archiv v1, Deep Research,
#    Formmuster). Die portierten Länderhinweise stehen in elementar-lexikon.ttl
#    und hängen per cur:hasCue an demselben Profil.
# =============================================================================
elem:Terminology a cur:TerminologyProfile ;
    rdfs:label "Terminologie Elementarbildung (alle Länder)"@de ;
    cur:profileScope cv:sec_elementary ;
    cur:hasCue elem:cue-toc , elem:cue-leitbild-muster , elem:cue-qa , elem:cue-reflexionsfrage , elem:cue-fachkraft ,
        elem:cue-kind-satz , elem:cue-rahmenlehrplan-fachschule , elem:cue-konzeption-kita , elem:cue-th-dimension ,
        elem:cue-hf-gestaltung , elem:cue-hf-teil3-ni , elem:cue-hf-didaktisch-sn , elem:cue-hf-qualitaet-th ,
        elem:cue-ziele-felder , elem:cue-ziele-bez , elem:cue-praxisbeispiele ,
        elem:cue-he-starke , elem:cue-he-kommunikation , elem:cue-he-kreativ , elem:cue-he-lernend , elem:cue-he-verantwortung ,
        elem:cue-by-sprachmedien , elem:cue-by-fragend ,
        elem:cue-u3 , elem:cue-alter-bis , elem:cue-monate , elem:cue-entwicklungsqualifikator ,
        elem:cue-gen-orientierungsplan , elem:cue-gen-bildungsprogramm , elem:cue-gen-bildungsempfehlungen , elem:cue-gen-bildungsleitlinien ,
        elem:cue-gen-erfahrungsfeld , elem:cue-gen-schwerpunkt , elem:cue-gen-kompetenzbereich .

elem:cue-toc a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_headingPattern ; cur:occursIn cv:occ_toc ;
    cur:pattern "^\\d+(\\.\\d+)*\\s+.+\\s+\\d+$" ; cur:mapsTo cv:occ_toc ; cur:strength 0.9 ;
    cur:recognitionHint "Inhaltsverzeichniszeile mit Seitenzahl; liefert in X1 den Gliederungsbaum und die gedruckten Seiten."@de .
elem:cue-leitbild-muster a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_headingPattern ;
    cur:pattern "^([A-ZÄÖÜ][a-zäöüß-]+(,| und| oder)? )+Kinder$" ; cur:mapsTo elem:Leitbild ; cur:scopeRegion land:DE-BY , land:DE-HE ; cur:strength 0.85 ;
    cur:negativeHint "Nicht als Bildungsbereich instanziieren; die Unterkapitel sind die Bereiche."@de .
elem:cue-qa a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_codePattern ;
    cur:pattern "^QA\\s?\\d+\\b" ; cur:mapsTo elem:Qualitaetsanspruch ; cur:scopeRegion land:DE-BE ; cur:strength 0.9 ;
    cur:recognitionHint "Berliner Bildungsprogramm: nummerierte Qualitätsansprüche, Adressat Fachkraft; Nummer als cur:code."@de .
elem:cue-reflexionsfrage a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
    cur:pattern "\\?\\s*$" ; cur:mapsTo elem:Reflexionsfrage ; cur:strength 0.85 ;
    cur:negativeHint "Fragesätze sind nie Ziele, auch wenn sie ein Ziel umschreiben."@de .
elem:cue-fachkraft a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
    cur:pattern "^(Die )?(pädagogischen? Fachkr(a|ä)fte?|Fachkr(a|ä)fte?|Erzieherinnen und Erzieher|Tagespflegepersonen?)\\b" ;
    cur:mapsTo elem:FachkraftAufgabe , cv:addr_educator ; cur:strength 0.9 .
elem:cue-kind-satz a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
    cur:pattern "^(Das Kind|Die Kinder|Kinder)\\b" ; cur:mapsTo elem:Bildungsziel , cv:addr_learner ; cur:strength 0.75 ;
    cur:recognitionHint "„Kinder lernen …“ kann Ziel oder Beschreibung sein; bei Zweifel cv:kind_unclassified."@de .
elem:cue-rahmenlehrplan-fachschule a cur:LexicalCue ; cur:surfaceForm "Rahmenlehrplan Fachschule Sozialpädagogik" ; cur:cueRole cv:role_negative ;
    cur:cueKind cv:ck_term ; cur:occursIn cv:occ_titlePage ; cur:mapsTo cv:sec_vocational ; cur:strength 0.95 ;
    cur:recognitionHint "Ausbildung der Erzieherinnen und Erzieher – Profil beruf:, nicht Elementarbildung."@de .
elem:cue-konzeption-kita a cur:LexicalCue ; cur:surfaceForm "Konzeption" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_titlePage ; cur:mapsTo elem:dt-Einrichtungskonzeption ; cur:strength 0.7 ;
    cur:recognitionHint "Nur mit Kita- oder Trägername auf der Titelseite; Landesministerium als Herausgeber spricht für einen Bildungsplan."@de .
elem:cue-th-dimension a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_tablePattern ; cur:occursIn cv:occ_tableHeader ;
    cur:pattern "^(personale|soziale|sachliche) (Bildungs)?[Dd]imension$" ; cur:mapsTo kd:ec-personal , kd:ec-social , kd:ec-subject ;
    cur:scopeRegion land:DE-TH ; cur:strength 0.9 ;
    cur:recognitionHint "Spaltenkopf der Bereichstabellen; Wert per cur:competenceDimension an jede Aussage der Spalte, kein Teilbaum."@de .
elem:cue-hf-gestaltung a cur:LexicalCue ; cur:surfaceForm "Gestaltung der pädagogischen Arbeit" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo elem:Handlungsfeld ; cur:scopeRegion land:DE ; cur:strength 0.85 .
elem:cue-hf-teil3-ni a cur:LexicalCue ; cur:surfaceForm "Arbeit in der Tageseinrichtung" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo elem:Handlungsfeld ; cur:scopeRegion land:DE-NI ; cur:strength 0.8 ; cur:verified false .
elem:cue-hf-didaktisch-sn a cur:LexicalCue ; cur:surfaceForm "Didaktisch-methodische Überlegungen" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo elem:Handlungsfeld ; cur:scopeRegion land:DE-SN ; cur:strength 0.8 ; cur:verified false .
elem:cue-hf-qualitaet-th a cur:LexicalCue ; cur:surfaceForm "Qualität, Professionalität und Qualitätsmanagement" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo elem:Qualitaet ; cur:scopeRegion land:DE-TH ; cur:strength 0.8 ; cur:verified false .
elem:cue-ziele-felder a cur:LexicalCue ; cur:surfaceForm "Ziele der Bildungs- und Entwicklungsfelder" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo elem:Bildungsziel , cv:obl_binding ; cur:scopeRegion land:DE-BW ; cur:strength 0.85 ; cur:verified false ;
    cur:recognitionHint "BW: Ziele der Felder sind verbindlich (cur:obligation cv:obl_binding), der übrige Plan orientierend."@de .
elem:cue-ziele-bez a cur:LexicalCue ; cur:surfaceForm "Bildungs- und Erziehungsziele" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo elem:Bildungsziel ; cur:strength 0.8 .
elem:cue-praxisbeispiele a cur:LexicalCue ; cur:surfaceForm "Praxisbeispiele" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo elem:Praxisbeispiel ; cur:scopeRegion land:DE-BE , land:DE-BY ; cur:strength 0.85 .
elem:cue-he-starke a cur:LexicalCue ; cur:surfaceForm "Starke Kinder" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ; cur:occursIn cv:occ_heading ;
    cur:mapsTo elem:Leitbild ; cur:scopeRegion land:DE-HE ; cur:strength 0.8 ; cur:verified false ;
    cur:recognitionHint "HE-BEP: gemeinsamer Teil für Kita und Grundschule (cur:scopeShare cv:share_common)."@de .
elem:cue-he-kommunikation a cur:LexicalCue ; cur:surfaceForm "Kommunikationsfreudige und medienkompetente Kinder" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_heading ; cur:mapsTo elem:Leitbild ; cur:scopeRegion land:DE-HE ; cur:strength 0.8 ; cur:verified false .
elem:cue-he-kreativ a cur:LexicalCue ; cur:surfaceForm "Kreative, fantasievolle und künstlerische Kinder" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_heading ; cur:mapsTo elem:Leitbild ; cur:scopeRegion land:DE-HE ; cur:strength 0.8 ; cur:verified false .
elem:cue-he-lernend a cur:LexicalCue ; cur:surfaceForm "Lernende, forschende und entdeckungsfreudige Kinder" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_heading ; cur:mapsTo elem:Leitbild ; cur:scopeRegion land:DE-HE ; cur:strength 0.8 ; cur:verified false .
elem:cue-he-verantwortung a cur:LexicalCue ; cur:surfaceForm "Verantwortungsvoll und wertorientiert handelnde Kinder" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_heading ; cur:mapsTo elem:Leitbild ; cur:scopeRegion land:DE-HE ; cur:strength 0.8 ; cur:verified false .
elem:cue-by-sprachmedien a cur:LexicalCue ; cur:surfaceForm "Sprach- und medienkompetente Kinder" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_heading ; cur:mapsTo elem:Leitbild ; cur:scopeRegion land:DE-BY ; cur:strength 0.8 ; cur:verified false .
elem:cue-by-fragend a cur:LexicalCue ; cur:surfaceForm "Fragende und forschende Kinder" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_heading ; cur:mapsTo elem:Leitbild ; cur:scopeRegion land:DE-BY ; cur:strength 0.8 ; cur:verified false .
elem:cue-u3 a cur:LexicalCue ; cur:surfaceForm "U3" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo elem:set-krippe , cv:time_age ; cur:strength 0.85 ;
    cur:recognitionHint "Altersband 0–36 Monate (cur:from 0, cur:to 36, Einheit Monate); oft ergänzendes Teilcurriculum."@de .
elem:cue-alter-bis a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
    cur:pattern "(von )?(\\d+|Geburt) bis (\\d+|zum (Schuleintritt|Ende der Grundschulzeit))( Jahren?)?" ; cur:mapsTo cv:time_age ; cur:strength 0.85 ;
    cur:recognitionHint "Altersband im Wortlaut in cur:timeText; Monate nur, wenn genannt (Jahre × 12 ist Normierung, Herkunft cv:orig_rule)."@de .
elem:cue-monate a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
    cur:pattern "\\((\\d+)\\s*Monate?\\)" ; cur:mapsTo elem:Entwicklungsindikator , cv:time_age ; cur:scopeRegion land:DE-MV ; cur:strength 0.8 .
elem:cue-entwicklungsqualifikator a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
    cur:pattern "\\b(zunehmend|allmählich|erste[nrs]?|mit Unterstützung|selbstständig|immer mehr)\\b" ; cur:mapsTo elem:developmentQualifier ; cur:strength 0.7 ;
    cur:recognitionHint "In N1 wörtlich als elem:developmentQualifier speichern; keine Niveaustufe daraus machen."@de .
elem:cue-gen-orientierungsplan a cur:LexicalCue ; cur:surfaceForm "Orientierungsplan" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_titlePage ; cur:mapsTo elem:dt-Bildungsplan ; cur:scopeRegion land:DE-BW , land:DE-NI ; cur:strength 0.9 .
elem:cue-gen-bildungsprogramm a cur:LexicalCue ; cur:surfaceForm "Bildungsprogramm" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
