    skos:scopeNote "Brücke zur KMK-Leitidee „Zahl und Operation“ (Primarbereich)."@de .
elem:f-raum-form a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-mathematik ; skos:prefLabel "Raum und Form"@de .
elem:f-muster-strukturen a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-mathematik ; skos:prefLabel "Muster und Strukturen"@de .
elem:f-groessen-messen a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-mathematik ; skos:prefLabel "Größen und Messen"@de .
elem:f-daten-zufall a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-mathematik ; skos:prefLabel "Daten und Zufall"@de .
elem:f-naturwissenschaft a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-mint ; skos:prefLabel "Naturwissenschaftliche Phänomene"@de ; skos:relatedMatch kimsf:s1028 .
elem:f-technik a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-mint ; skos:prefLabel "Technik"@de ; skos:relatedMatch kimsf:s1059 .
elem:f-informatik a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-mint ; skos:prefLabel "Informatische Grunderfahrungen"@de ; skos:relatedMatch kimsf:s1013 .

elem:f-medien a skos:Concept ; skos:inScheme elem:Fields ; skos:topConceptOf elem:Fields ; skos:notation "3.2.4" ;
    skos:prefLabel "Medien und digitale Bildung"@de ; skos:closeMatch qz:DigitalWorld ; skos:relatedMatch kimsf:s1046 .
elem:f-medienerleben-reflexion a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-medien ; skos:prefLabel "Medien erleben und reflektieren"@de .
