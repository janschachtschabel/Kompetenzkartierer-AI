@prefix elem:  <https://w3id.org/wlo/curriculum/profile/early-childhood#> .
@prefix cur:   <https://w3id.org/wlo/curriculum/core#> .
@prefix cv:    <https://w3id.org/wlo/curriculum/vocab#> .
@prefix lvl:   <https://w3id.org/wlo/curriculum/level/> .
@prefix qz:    <https://w3id.org/wlo/curriculum/crosscutting/> .
@prefix kd:    <https://w3id.org/wlo/curriculum/dimension/> .
@prefix land:  <https://w3id.org/wlo/curriculum/region/> .
@prefix ctx:   <https://w3id.org/wlo/curriculum/context/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix kimsf: <http://w3id.org/kim/schulfaecher/> .
@prefix kimsa: <https://w3id.org/kim/schularten/> .
@prefix kimel: <https://w3id.org/kim/educationalLevel/> .

# =============================================================================
# Profil Elementarbildung (elem:) – Bildungspläne der 16 Länder für Kita,
# Kindertagespflege und Hort, 0–10-/0–18-Pläne, Gemeinsamer Rahmen der Länder.
#
# Besonderheiten gegenüber Schule: Bildungsziele statt Lernergebnisse
# (Normalfall cv:kind_developmentGoal), viele Aussagen an Fachkräfte
# (cv:addr_educator – docken nie an Kompetenzkonzepte), Alter statt Jahrgang
# (cv:time_age, Einheit Monate), Niveau fast immer leer (cur:checkedAbsent),
# Situation als Andockpunkt (ctx:situations), große Rahmenteile mit
# Extraktionstiefe „typed“. Ein Dokument trägt oft mehrere Curricula
# (Krippe/Kita/Hort/Grundschule) – getrennt über cur:ApplicabilityContext mit
# elem:setting und Altersband, gemeinsame Teile über cur:appliesTo.
#
# Das Länderlexikon (201 Hinweise der ELEM-Recherche, je Land aufgefächert,
# korrigiert) steht generiert in elementar-lexikon.ttl; hier nur Struktur,
# Werte und die von Hand ergänzten Hinweise.
#
# Quellen: ELEM V2 (CUR-Kern + ELEM-Profil, 15 Steuervokabulare, Themenkanon
# des Gemeinsamen Rahmens JFMK 2021/KMK 2022), ELEM-v1-Archiv,
# Deep-Research-Bericht Elementarbildung.
# =============================================================================

<https://w3id.org/wlo/curriculum/profile/early-childhood> a owl:Ontology ;
    dct:title "Curriculum-Profil Elementarbildung"@de , "curriculum profile early childhood education"@en ;
    owl:imports <https://w3id.org/wlo/curriculum/core> , <https://w3id.org/wlo/curriculum/vocab> ,
        <https://w3id.org/wlo/curriculum/dimension> , <https://w3id.org/wlo/curriculum/crosscutting> ,
        <https://w3id.org/wlo/curriculum/context> , <https://w3id.org/wlo/curriculum/region> ;
    owl:versionInfo "1.0-entwurf" ;
    dct:created "2026-10-19"^^xsd:date .

# =============================================================================
# 1. Profil-Eigenschaften
# =============================================================================
elem:setting a owl:ObjectProperty ; rdfs:subPropertyOf cur:institutionType ;
    rdfs:label "Bildungsort"@de , "setting"@en ;
    skos:definition "Bildungsort, für den ein Curriculum oder ein Abschnitt gilt (Krippe, Kindergarten, Hort, Kindertagespflege, Grundschule). Trennt Teilcurricula eines 0–10-Plans."@de .
elem:developmentQualifier a owl:DatatypeProperty ; rdfs:range rdf:langString ;
    rdfs:label "Entwicklungsqualifikator"@de , "development qualifier"@en ;
    skos:definition "Wortlaut eines Entwicklungs- oder Fortschrittssignals in einer Zielaussage („zunehmend selbstständig“, „erste Erfahrungen“, „mit Unterstützung“). Das einzige Niveausignal in Kita-Texten; wird nie in eine Niveaustufe übersetzt."@de ;
    skos:scopeNote "Wird in N1 an cur:Decomposition gesetzt (neben cur:conditionText, cur:autonomy)."@de .
elem:basicNeed a owl:ObjectProperty ;
    rdfs:label "Grundbedürfnis"@de , "basic need"@en ;
    skos:definition "Zweite Achse der BW-Bildungs- und Erziehungsmatrix (Grundbedürfnisse × Bildungs- und Entwicklungsfelder). Wird nur gesetzt, wenn die Matrixzelle es angibt."@de ;
    skos:editorialNote "Werteliste offen: die Grundbedürfnis-Bezeichnungen des Orientierungsplans BW 2025 sind am Original zu erheben."@de .

# =============================================================================
# 2. Dokumenttypen
# =============================================================================
elem:DocumentTypes a skos:ConceptScheme ; skos:prefLabel "Dokumenttypen Elementarbildung"@de .

elem:dt-Bildungsplan a cur:DocumentType ; skos:inScheme elem:DocumentTypes ; skos:broader cv:dk_curriculum ;
    skos:prefLabel "Landesbildungsplan Elementarbereich"@de ;
    skos:scopeNote "Bildungsplan, Bildungsprogramm, Orientierungsplan, Bildungsempfehlungen, Bildungsleitlinien, Bildungskonzeption, Bildungsgrundsätze. Rechtsform meist cv:lf_officialRecommendation (§ 85 Abs. 2 SGB VIII) oder durch Verordnung verbindlich; das steht am Dokument, nie am Typ."@de .
elem:dt-Bildungsplan-0-10 a cur:DocumentType ; skos:inScheme elem:DocumentTypes ; skos:broader cv:dk_curriculum ;
    skos:prefLabel "Altersübergreifender Bildungsplan"@de ; skos:altLabel "Bildungsplan 0 bis 10"@de , "Bildungsplan bis 18 Jahre"@de ;
    skos:scopeNote "HE, MV, NW, HB 0–10, TH 0–18, BayBL: mindestens zwei Curricula (Kita, Grundschule/Schule) in einem Dokument; das Grundschul-Curriculum gehört zum Bereich Schule (cv:sec_school)."@de .
elem:dt-GemeinsamerRahmen a cur:DocumentType ; skos:inScheme elem:DocumentTypes ; skos:broader cv:dk_framework ;
    skos:prefLabel "Länderübergreifender Rahmen"@de ;
    skos:scopeNote "„Gemeinsamer Rahmen der Länder für die frühe Bildung in Kindertageseinrichtungen“ (JMK/KMK 2004, i. d. F. JFMK 2021/KMK 2022). Anker des Feldvokabulars elem:Fields."@de .
elem:dt-Rechtsnorm a cur:DocumentType ; skos:inScheme elem:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Ausführungsverordnung/Kita-Gesetz"@de ;
    skos:scopeNote "AVBayKiBiG, KiFöG-VO ST u. a.; Grundlage eines Bildungsplans (cur:derivedFrom), selbst kein Curriculum. Nur Bildungs- und Erziehungsziele (§§) extrahieren."@de .
elem:dt-Handreichung a cur:DocumentType ; skos:inScheme elem:DocumentTypes ; skos:broader cv:dk_guidance ;
    skos:prefLabel "Handreichung/Handlungsempfehlung"@de ;
    skos:scopeNote "U3-Handreichung, Handlungsempfehlungen Sprachbildung (NI), Konkretisierungen (HB), Handreichungen SH. Ergänzt einen Bildungsplan (cur:Curriculum mit cur:scopeShare cv:share_supplementary) oder ist reines Begleitdokument."@de .
elem:dt-Qualitaetsempfehlung a cur:DocumentType ; skos:inScheme elem:DocumentTypes ; skos:broader cv:dk_guidance ;
    skos:prefLabel "Qualitätsempfehlung"@de .
elem:dt-Einrichtungskonzeption a cur:DocumentType ; skos:inScheme elem:DocumentTypes ; skos:broader cv:dk_institutional ;
    skos:prefLabel "Einrichtungskonzeption"@de ;
    skos:scopeNote "Pädagogische Konzeption einer Kita; Rechtsform cv:lf_institutionalDocument, nie amtlich."@de .
elem:dt-Traegerkonzeption a cur:DocumentType ; skos:inScheme elem:DocumentTypes ; skos:broader cv:dk_institutional ;
    skos:prefLabel "Trägerkonzeption"@de .
elem:dt-Beobachtungsinstrument a cur:DocumentType ; skos:inScheme elem:DocumentTypes ; skos:broader cv:dk_assessment ;
    skos:prefLabel "Beobachtungsinstrument/Entwicklungstabelle"@de ;
    skos:scopeNote "Wird als cur:CompetencyFramework (Raster Bereich × Altersstufe, Zellen = Entwicklungsindikatoren) importiert und referenziert, nicht als Curriculum extrahiert."@de .

# =============================================================================
# 3. Knotentypen (ELEM-Rollen; je genau eine Kernfunktion)
# =============================================================================
elem:NodeTypes a skos:ConceptScheme ; skos:prefLabel "Knotentypen Elementarbildung"@de .

elem:Sammelabschnitt a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_grouping ;
    skos:prefLabel "Sammelabschnitt"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Teil, Kapitel oder Abschnitt, der Bereiche bündelt („Teil II Bildungsziele“, „Kap. 7 Themenbezogene Bildungs- und Erziehungsbereiche“)."@de .
elem:Leitbild a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_grouping ;
    skos:prefLabel "Leitbild/Vision"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Gruppenüberschrift über mehreren Bildungsbereichen in der Form „[Adjektiv] Kinder“ (BY Leitbilder, HE Visionen)."@de ;
    cur:delimitation "Kein Bildungsbereich: trägt kein Feld; die Bereiche darunter tragen es."@de ;
    cur:positiveExample "„Sprach- und medienkompetente Kinder“ (BY)"@de , "„Starke Kinder“ (HE)"@de .
elem:Bildungsbereich a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Bildungsbereich"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Weltausschnitt des Plans (Sprache, Mathematik, Körper …), in den Ländern Bildungsbereich, Bildungs- und Entwicklungsfeld (BW), Lernbereich und Erfahrungsfeld (NI), Bildungs- und Erziehungsbereich (MV, RP). Setzt cur:field auf einen Wert aus elem:Fields; Ziel 4 im Andockkonzept."@de ;
    cur:typicalParent elem:Sammelabschnitt , elem:Leitbild ;
    cur:delimitation "Ein Bereich ohne Weltausschnitt („Wahrnehmen und Denken“ BW, „Entwicklung kognitiver Fähigkeiten“ NI) bleibt Bildungsbereich, erhält aber cur:competenceDimension statt cur:field."@de .
elem:Teilbereich a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_subunit ;
    skos:prefLabel "Teilbereich"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Unterabschnitt eines Bildungsbereichs (Aspekt, Schwerpunkt, Unterbereich, Leitbegriff SN)."@de ;
    cur:typicalParent elem:Bildungsbereich .
elem:Querschnitt a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_crossCutting ;
    skos:prefLabel "Querschnitt/Leitprinzip"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Abschnitt mit wenigen (3–6) übergreifenden Prinzipien vor den Bereichen: Leitprinzip (BW), Leitmotiv (HH), Querschnittsthema (RP), Handlungsprinzip (SH), Pädagogische Grundprinzipien (Gemeinsamer Rahmen)."@de ;
    cur:positiveExample "„Inklusion“, „Partizipation“, „Kinderrechte“, „BNE“"@de .
elem:Basiskompetenzen a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_crossCutting ;
    skos:prefLabel "Basiskompetenzen"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Abschnitt, der Kompetenzen ohne Weltausschnitt beschreibt (Basiskompetenzen BY/HE nach Fthenakis, Ich-/Sozial-/Sach-/lernmethodische Kompetenzen BE). Liefert in X3 das Kompetenzmodell (kd:EarlyChildhood) als Auswahlliste; Aussagen darin tragen cur:competenceDimension."@de ;
    cur:delimitation "TH: die drei Bildungsdimensionen stehen als Tabellenkopf in jedem Bereich – keinen Teilbaum bilden, die Dimension an den Aussagen erfassen."@de .
elem:Alltagssituation a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Pädagogische Alltagssituation"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Gliederung nach Situationen statt Weltausschnitten (BB 2024: 18 Alltagssituationen in 4 Gruppen). Setzt cur:context auf ctx:situations-Werte statt cur:field."@de ;
    cur:impliesContext ctx:everyday ;
    cur:delimitation "Nicht als Bildungsbereich instanziieren."@de .
elem:Handlungsfeld a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "Handlungsfeld der Fachkräfte"@de ; cur:extractionDepth cv:depth_typed ;
    skos:definition "Kapitel zu Gestaltung der pädagogischen Arbeit, Raum, Team, didaktisch-methodischen Überlegungen, Aufgaben der pädagogischen Fachkräfte. Aussagen sind Aufträge (cv:kind_mandate) an Fachkräfte."@de ;
    cur:defaultAddressee cv:addr_educator .
elem:Uebergang a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "Übergänge"@de ; cur:extractionDepth cv:depth_typed ;
    skos:definition "Eingewöhnung, Übergang in die Schule, Übergänge im Tagesablauf."@de ;
    cur:impliesContext ctx:transition-situations ; cur:defaultAddressee cv:addr_educator .
elem:BeobachtungDokumentation a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "Beobachtung und Dokumentation"@de ; cur:extractionDepth cv:depth_typed ;
    cur:defaultAddressee cv:addr_educator .
elem:Zusammenarbeit a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "Zusammenarbeit"@de ; cur:extractionDepth cv:depth_typed ;
    skos:definition "Zusammenarbeit mit Familien, Schule, Sozialraum und Kooperationspartnern."@de ;
    cur:defaultAddressee cv:addr_institution .
elem:Qualitaet a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "Qualität und Qualitätsentwicklung"@de ; cur:extractionDepth cv:depth_typed ;
    cur:defaultAddressee cv:addr_institution .
elem:Grundlagen a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "Grundlagen/Bildungsverständnis"@de ; cur:extractionDepth cv:depth_typed ;
    skos:definition "Bild vom Kind, Bildungsverständnis, rechtliche Grundlagen, Ziele des Plans. Liefert Grundsätze und übergreifende Bildungsziele."@de .
elem:Rahmenbedingungen a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "Rahmenbedingungen"@de ; cur:extractionDepth cv:depth_typed .
elem:Einleitung a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_nonCurricular ;
    skos:prefLabel "Einleitung/Vorwort"@de ; cur:extractionDepth cv:depth_skip .
elem:Verzeichnis a cur:NodeType ; skos:inScheme elem:NodeTypes ; skos:broader cv:fn_nonCurricular ;
    skos:prefLabel "Verzeichnis/Anhang"@de ; cur:extractionDepth cv:depth_skip .

# =============================================================================
# 4. Aussage-Unterarten
# =============================================================================
elem:StatementSubkinds a skos:ConceptScheme ; skos:prefLabel "Aussage-Unterarten Elementarbildung"@de .

elem:Bildungsziel a cur:StatementSubkind ; skos:inScheme elem:StatementSubkinds ; skos:broader cv:kind_developmentGoal ;
    skos:prefLabel "Bildungs- und Entwicklungsziel"@de ;
    skos:definition "Ziel für das Kind ohne Prüfanspruch: Haltung, Erfahrung, Disposition, Entwicklung („Das Kind entwickelt Freude am …“, „Kinder erfahren …“)."@de ;
    cur:segmentation cv:seg_bullet ; cur:defaultAddressee cv:addr_learner ;
    cur:wordingRule "Wortlaut wörtlich; Satzstamm („Das Kind …“, „Kinder …“) in cur:leadIn. Nicht in Lernergebnisse umformulieren, keine Operatorformeln."@de ;
    cur:negativeExample "„Wie unterstützen wir Kinder beim …?“ (Reflexionsfrage)"@de .
elem:Kompetenzbeschreibung a cur:StatementSubkind ; skos:inScheme elem:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
    skos:prefLabel "Kompetenzbeschreibung"@de ;
    skos:definition "Beobachtbares Können des Kindes („Das Kind kann Mengen bis fünf simultan erfassen“). Selten; nur bei ausdrücklichem Können/Wissen."@de ;
    cur:defaultAddressee cv:addr_learner .
elem:Bildungsanspruch a cur:StatementSubkind ; skos:inScheme elem:StatementSubkinds ; skos:broader cv:kind_developmentGoal ;
    skos:prefLabel "Bildungsanspruch"@de ;
    skos:definition "Anspruch des Kindes auf Bildungsgelegenheiten (TH „Bildungsansprüche“)."@de ;
    cur:defaultAddressee cv:addr_learner .
elem:Grundsatz a cur:StatementSubkind ; skos:inScheme elem:StatementSubkinds ; skos:broader cv:kind_mandate ;
    skos:prefLabel "Pädagogischer Grundsatz"@de ;
    skos:definition "Normatives Prinzip der pädagogischen Arbeit (Bild vom Kind, Bildungsverständnis, Grundprinzip). Dockt an Querschnittsziele (cur:contributesTo), nicht an Kompetenzen."@de ;
    cur:defaultAddressee cv:addr_educator .
elem:FachkraftAufgabe a cur:StatementSubkind ; skos:inScheme elem:StatementSubkinds ; skos:broader cv:kind_mandate ;
    skos:prefLabel "Aufgabe der pädagogischen Fachkraft"@de ;
    skos:definition "„Pädagogische Fachkräfte …“, „Die Fachkraft unterstützt …“, „Aufgaben der pädagogischen Fachkräfte“ (HH)."@de ;
    cur:defaultAddressee cv:addr_educator ;
    cur:wordingRule "Kein Kindziel daraus ableiten. Der Bezug zu Kompetenzen entsteht in G1 als vorgeschlagene Kante rel_supports zu einem Kompetenzkonzept, nicht als neue Aussage."@de .
elem:Qualitaetsanspruch a cur:StatementSubkind ; skos:inScheme elem:StatementSubkinds ; skos:broader cv:kind_standard ;
    skos:prefLabel "Qualitätsanspruch"@de ;
    skos:definition "Nummerierter Maßstab an die pädagogische Arbeit (BE QA1, QA2 …)."@de ;
    cur:defaultAddressee cv:addr_educator .
elem:Entwicklungsindikator a cur:StatementSubkind ; skos:inScheme elem:StatementSubkinds ; skos:broader cv:kind_standard ;
    skos:prefLabel "Entwicklungsindikator"@de ;
    skos:definition "Beobachtungsmerkmal mit Altersangabe („3–5-Wort-Sätze (36 Monate)“); Alter als cur:timeSpan mit cv:time_age."@de ;
    cur:defaultAddressee cv:addr_learner .
elem:Inhalt a cur:StatementSubkind ; skos:inScheme elem:StatementSubkinds ; skos:broader cv:kind_content ;
    skos:prefLabel "Bildungsinhalt"@de ; skos:altLabel "Erfahrungsinhalt"@de .
elem:Impuls a cur:StatementSubkind ; skos:inScheme elem:StatementSubkinds ; skos:broader cv:kind_guidance ;
    skos:prefLabel "Impuls/Anregung"@de ; skos:altLabel "Umsetzungsidee"@de , "Bildungsmöglichkeit"@de .
elem:Reflexionsfrage a cur:StatementSubkind ; skos:inScheme elem:StatementSubkinds ; skos:broader cv:kind_guidance ;
    skos:prefLabel "Reflexionsfrage"@de ; skos:altLabel "Erkundungsfrage"@de , "Frage zur Reflexion"@de ;
    cur:delimitation "Fragesätze sind nie Ziele."@de ; cur:defaultAddressee cv:addr_educator .
elem:Praxisbeispiel a cur:StatementSubkind ; skos:inScheme elem:StatementSubkinds ; skos:broader cv:kind_guidance ;
    skos:prefLabel "Praxisbeispiel"@de .

# =============================================================================
# 5. Bildungsorte
# =============================================================================
elem:Settings a skos:ConceptScheme ; skos:prefLabel "Bildungsorte Elementarbildung"@de .
elem:set-krippe a skos:Concept ; skos:inScheme elem:Settings ; skos:topConceptOf elem:Settings ;
    skos:prefLabel "Krippe"@de ; skos:altLabel "U3"@de , "unter drei Jahren"@de ; skos:broadMatch ctx:ecec .
elem:set-kindergarten a skos:Concept ; skos:inScheme elem:Settings ; skos:topConceptOf elem:Settings ;
    skos:prefLabel "Kindergarten"@de ; skos:broadMatch ctx:ecec .
elem:set-kita a skos:Concept ; skos:inScheme elem:Settings ; skos:topConceptOf elem:Settings ;
    skos:prefLabel "Kindertageseinrichtung"@de ; skos:altLabel "Kita"@de , "Kindertagesstätte"@de ; skos:exactMatch ctx:ecec ;
    skos:narrower elem:set-krippe , elem:set-kindergarten .
elem:set-kindertagespflege a skos:Concept ; skos:inScheme elem:Settings ; skos:topConceptOf elem:Settings ;
    skos:prefLabel "Kindertagespflege"@de ; skos:altLabel "KTP"@de , "Tagespflege"@de ; skos:exactMatch ctx:childminding .
elem:set-hort a skos:Concept ; skos:inScheme elem:Settings ; skos:topConceptOf elem:Settings ;
    skos:prefLabel "Hort"@de ; skos:altLabel "Schulkindbetreuung"@de ; skos:exactMatch ctx:after-school .
elem:set-grundschule a skos:Concept ; skos:inScheme elem:Settings ; skos:topConceptOf elem:Settings ;
    skos:prefLabel "Grundschule"@de ; skos:exactMatch kimsa:s02 ;
    skos:scopeNote "Teilcurriculum eines 0–10-Plans; gehört zum Bereich Schule (cv:sec_school)."@de .

# =============================================================================
# 6. Feldvokabular (Andockpunkt Fach/Feld): Bildungsbereiche des Gemeinsamen
#    Rahmens 3.2.1–3.2.7 mit Unterkonzepten. Länderbereiche werden über das
#    Lexikon (elementar-lexikon.ttl) auf diese Werte abgebildet. Brücken zu
#    Grundschulfächern sind relatedMatch (Vorschlag, nicht geprüft).
# =============================================================================
elem:Fields a skos:ConceptScheme ;
    skos:prefLabel "Bildungsbereiche Elementarbildung (Gemeinsamer Rahmen)"@de ;
    dct:source "Gemeinsamer Rahmen der Länder für die frühe Bildung in Kindertageseinrichtungen, i. d. F. JFMK 06.05.2021 / KMK 24.03.2022, Abschnitt 3.2" ;
    skos:hasTopConcept elem:f-sprache , elem:f-personal-sozial , elem:f-mint , elem:f-medien , elem:f-aesthetik , elem:f-koerper , elem:f-umwelt-bne .

elem:f-sprache a skos:Concept ; skos:inScheme elem:Fields ; skos:topConceptOf elem:Fields ; skos:notation "3.2.1" ;
    skos:prefLabel "Sprache, Kommunikation und Literacy"@de ;
    skos:definition "Alltagsintegrierte sprachliche Bildung, Kommunikation, Mehrsprachigkeit, Literacy."@de ;
    skos:relatedMatch kimsf:s1005 ; skos:closeMatch qz:LanguageEducation .
elem:f-sprechen-zuhoeren a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-sprache ; skos:prefLabel "Sprechen und Zuhören"@de ;
    skos:scopeNote "Brücke zum KMK-Kompetenzbereich Deutsch Primarbereich „Sprechen und Zuhören“."@de .
elem:f-nonverbale-kommunikation a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-sprache ; skos:prefLabel "Nonverbale Kommunikation"@de .
elem:f-mehrsprachigkeit a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-sprache ; skos:prefLabel "Mehrsprachigkeit"@de ; skos:closeMatch qz:Plurilingual .
elem:f-literacy a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-sprache ; skos:prefLabel "Literacy, Erzähl- und Schriftkultur"@de ; skos:closeMatch qz:Literacy .
elem:f-erzaehl-buchkultur a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-literacy ; skos:prefLabel "Erzähl- und Buchkultur"@de .
elem:f-schriftkultur a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-literacy ; skos:prefLabel "Begegnung mit Schrift"@de .
elem:f-phonologische-bewusstheit a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-literacy ; skos:prefLabel "Phonologische Bewusstheit"@de .
elem:f-sprachbetrachtung a skos:Concept ; skos:inScheme elem:Fields ; skos:broader elem:f-sprache ; skos:prefLabel "Sprachbetrachtung"@de ;
