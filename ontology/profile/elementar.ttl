elem:f-mint a skos:Concept ; skos:inScheme elem:Fields ; skos:topConceptOf elem:Fields ; skos:notation "3.2.3" ;
    skos:prefLabel "Mathematik, Informatik, Naturwissenschaft und Technik"@de ; skos:closeMatch qz:STEM .
