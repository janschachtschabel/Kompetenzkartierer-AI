@prefix beruf: <https://w3id.org/wlo/curriculum/profile/vocational#> .
@prefix cur:   <https://w3id.org/wlo/curriculum/core#> .
@prefix cv:    <https://w3id.org/wlo/curriculum/vocab#> .
@prefix lvl:   <https://w3id.org/wlo/curriculum/level/> .
@prefix qz:    <https://w3id.org/wlo/curriculum/crosscutting/> .
@prefix kd:    <https://w3id.org/wlo/curriculum/dimension/> .
@prefix land:  <https://w3id.org/wlo/curriculum/region/> .
@prefix ctx:   <https://w3id.org/wlo/curriculum/context/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix lp:    <https://w3id.org/lehrplan/ontology/> .
@prefix kimsa: <https://w3id.org/kim/schularten/> .

# =============================================================================
# Profil Berufliche Bildung (beruf:) – duale Ausbildung (Ausbildungsordnung
# mit Ausbildungsrahmenplan, KMK-Rahmenlehrplan, Landeslehrpläne),
# Gesundheitsfachberufe (PflAPrV, Rahmenpläne nach § 53 PflBG),
# landesrechtliche Bildungsgänge (Berufskolleg, Fachschule, Berufsfachschule),
# Fortbildung (§§ 53–54 BBiG, Meisterprüfung), § 66 BBiG / § 42r HwO, ÜLU.
#
# Ein Beruf hat mehrere Spezifikationen an verschiedenen Lernorten (AO/ARP
# für den Betrieb, RLP für die Berufsschule, Landeslehrplan). Der stabile
# Andockpunkt ist der Beruf (cur:Occupation mit BIBB-Bezeichnung und
# Jahresstand), nicht ein Fach. Lernortkooperation ist eine eigene Kante
# (cv:rel_correspondsTo, amtlich über die Entsprechungsliste) – nicht
# „konkretisiert“. DQR hängt nur an der Qualifikation; Ausbildungsjahr und
# Ausbildungsmonat sind Zeit, kein Niveau.
#
# Quellen: BBO v0.2 (bbo-core, bbo-vocab, bbo-extraction: 43 Hinweise, fünf
# Muster korrigiert), ältere bb-*-Vorarbeit (Inhalte, nicht Struktur),
# Deep-Research-Bericht Berufsbildung.
# =============================================================================

<https://w3id.org/wlo/curriculum/profile/vocational> a owl:Ontology ;
    dct:title "Curriculum-Profil Berufliche Bildung"@de , "curriculum profile vocational education and training"@en ;
    owl:imports <https://w3id.org/wlo/curriculum/core> , <https://w3id.org/wlo/curriculum/vocab> ,
        <https://w3id.org/wlo/curriculum/level> , <https://w3id.org/wlo/curriculum/dimension> ,
        <https://w3id.org/wlo/curriculum/crosscutting> , <https://w3id.org/wlo/curriculum/context> ;
    owl:versionInfo "1.0-entwurf" ;
    dct:created "2026-10-19"^^xsd:date .

# =============================================================================
# 1. Profil-Eigenschaften
# =============================================================================
beruf:learningPlace a owl:ObjectProperty ; rdfs:subPropertyOf cur:context ;
    rdfs:label "Lernort"@de , "learning place"@en ;
    skos:definition "Lernort einer Spezifikation, Einheit oder Aussage (ctx:company, ctx:vocational-school, ctx:intercompany, ctx:fulltime-vocational, ctx:nursing-school, ctx:practice-placement, ctx:course-provider)."@de .
beruf:legalLevel a owl:ObjectProperty ;
    rdfs:label "Rechtsebene"@de , "legal level"@en ;
    skos:definition "Bund, KMK, Land, zuständige Stelle (Kammer), sonstige. Ergänzt cur:legalForm."@de .
beruf:competentBody a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "zuständige Stelle"@de , "competent body"@en ;
    skos:definition "Kammer oder zuständige Stelle im Wortlaut (IHK München, HWK Köln). Gehört bei § 54- und § 66-Regelungen zur Identität der Spezifikation."@de .
beruf:responsibilityArea a owl:ObjectProperty ;
    rdfs:label "Zuständigkeitsbereich"@de , "area of responsibility"@en .
beruf:structuralParadigm a owl:ObjectProperty ;
    rdfs:label "Strukturparadigma"@de , "structural paradigm"@en .
beruf:differentiationModel a owl:ObjectProperty ;
    rdfs:label "Differenzierungsmodell"@de , "differentiation model"@en .
beruf:regime a owl:ObjectProperty ;
    rdfs:label "Ordnungsregime"@de , "regulatory regime"@en .
beruf:durationMonths a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "Ausbildungsdauer in Monaten"@de , "duration in months"@en ;
    skos:definition "Regelausbildungsdauer laut Verordnung (24, 36, 42). Nie aus Zeitrichtwerten umrechnen."@de .
beruf:examType a owl:ObjectProperty ; rdfs:domain cur:Assessment ;
    rdfs:label "Prüfungstyp"@de , "examination type"@en ;
    skos:definition "Berufsbildungstyp der Prüfung neben der Kern-Prüfungsart (cv:AssessmentKinds): Zwischenprüfung ≠ Abschlussprüfung Teil 1."@de .
beruf:actionPhase a owl:ObjectProperty ; rdfs:domain cur:Decomposition ;
    rdfs:label "Handlungsphase"@de , "action phase"@en ;
    skos:definition "Optional in N1, nur wenn eindeutig: informieren, planen, entscheiden, durchführen, kontrollieren, bewerten."@de .
beruf:bibbId a owl:DatatypeProperty ; rdfs:domain cur:Occupation ; rdfs:range xsd:string ;
    rdfs:label "BIBB-Kennung"@de , "BIBB identifier"@en ;
    skos:definition "Kennung im Verzeichnis der anerkannten Ausbildungsberufe mit Jahresstand (cur:validFrom am Beruf)."@de .
beruf:kldbCode a owl:DatatypeProperty ; rdfs:domain cur:Occupation ; rdfs:range xsd:string ;
    rdfs:label "KldB-2010-Schlüssel"@de , "KldB 2010 code"@en .

# =============================================================================
# 2. Dokumenttypen
# =============================================================================
beruf:DocumentTypes a skos:ConceptScheme ; skos:prefLabel "Dokumenttypen Berufliche Bildung"@de .

beruf:dt-Ausbildungsordnung a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Ausbildungsordnung"@de ; skos:altLabel "Ausbildungsverordnung"@de ;
    skos:scopeNote "Verordnung des Bundes; der Ausbildungsrahmenplan ist ihre Anlage (eigene cur:Curriculum-Spezifikation, Lernort Betrieb), kein eigenes Dokument. Prüfungs-§§ ergeben cur:AssessmentSpecification."@de .
beruf:dt-Rahmenlehrplan a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_curriculum ;
    skos:prefLabel "KMK-Rahmenlehrplan"@de ;
    skos:scopeNote "Lernort Berufsschule; verbindlich erst nach Übernahme durch ein Land (cur:documentBinding cv:bind_partial bis zum Landesakt). Teile I–IV einmal je Fassung der Handreichung speichern, nicht je Beruf."@de .
beruf:dt-Landeslehrplan a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_curriculum ;
    skos:prefLabel "Landeslehrplan berufliche Schule"@de ; skos:altLabel "Bildungsplan Berufskolleg"@de .
beruf:dt-Fortbildungsordnung a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Fortbildungsordnung"@de ; skos:altLabel "Meisterprüfungsverordnung"@de ;
    skos:scopeNote "Ergibt eine cur:QualificationSpecification; die Prüfungsgliederung ist die einzige Struktur (Knotentyp beruf:Pruefungsbereich), Lernziele stecken in den Prüfungsanforderungen."@de .
beruf:dt-Fortbildungsregelung a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Fortbildungsprüfungsregelung der zuständigen Stelle (§ 54 BBiG)"@de .
beruf:dt-Regelung66 a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Ausbildungsregelung nach § 66 BBiG / § 42r HwO"@de ; skos:altLabel "Fachpraktiker-Regelung"@de ;
    skos:scopeNote "Abgeleitet vom Regelberuf (cur:derivedFrom); Kammer gehört zur Identität."@de .
beruf:dt-Umschulungsordnung a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Umschulungsordnung"@de .
beruf:dt-AusbildungsPruefungsverordnung a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Ausbildungs- und Prüfungsverordnung"@de ; skos:example "PflAPrV" .
beruf:dt-PflegeRahmenplan a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_curriculum ;
    skos:prefLabel "Rahmenplan der Fachkommission nach § 53 PflBG"@de ;
    skos:scopeNote "Zwei Spezifikationen: Rahmenlehrplan (Pflegeschule) und Rahmenausbildungsplan (Praxiseinsatz); empfehlend."@de .
beruf:dt-UeLU a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_curriculum ;
    skos:prefLabel "ÜLU-Unterweisungsplan"@de ;
    skos:scopeNote "Lehrgang der überbetrieblichen Lehrlingsunterweisung (Handwerk); Zuordnungen zu Berufsbildpositionen sind immer maschinell."@de .
beruf:dt-Umsetzungshilfe a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_guidance ;
    skos:prefLabel "Umsetzungshilfe"@de ; skos:altLabel "Ausbildung gestalten"@de .
beruf:dt-Entsprechungsliste a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_other ;
    skos:prefLabel "Liste der Entsprechungen"@de ;
    skos:scopeNote "Wird regelbasiert in amtliche Kanten cv:rel_correspondsTo (Methode cv:meth_officialList) übersetzt, nicht als Curriculum extrahiert; n:m, nicht 1:1."@de .
beruf:dt-Kompetenzmatrix a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_other ;
    skos:prefLabel "Kompetenzmatrix"@de .
beruf:dt-Rahmenvereinbarung a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "KMK-Rahmenvereinbarung"@de ; skos:example "Rahmenvereinbarung über Fachschulen" .
beruf:dt-Anrechnungsverordnung a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_regulation ;
    skos:prefLabel "Anrechnungsverordnung"@de ;
    skos:scopeNote "Liefert cur:RecognitionRule (Zeitanrechnung, Prüfungsbefreiung)."@de .
beruf:dt-Rahmenplan-Fortbildung a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_guidance ;
    skos:prefLabel "Rahmenplan der Fortbildung"@de ; skos:scopeNote "DIHK/ZDH-Rahmenplan; nichtamtlich."@de .
beruf:dt-Jahresplanung a cur:DocumentType ; skos:inScheme beruf:DocumentTypes ; skos:broader cv:dk_institutional ;
    skos:prefLabel "Didaktische Jahresplanung"@de ; skos:altLabel "Betrieblicher Ausbildungsplan"@de ;
    skos:scopeNote "Lernsituationen und Umsetzung vor Ort; nie amtlich."@de .

# =============================================================================
# 3. Knotentypen
# =============================================================================
beruf:NodeTypes a skos:ConceptScheme ; skos:prefLabel "Knotentypen Berufliche Bildung"@de .

beruf:Verordnungsteil a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "Verordnungsteil/Paragraf"@de ; cur:extractionDepth cv:depth_typed ;
    skos:definition "§§ der Verordnung (Dauer, Struktur, Berufsbild, Prüfung). Liefert Regeln (cur:Rule), Prüfungen (cur:Assessment) und Varianten; keine Lernergebnisse."@de .
beruf:Ausbildungsberufsbild a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "Ausbildungsberufsbild"@de ; cur:extractionDepth cv:depth_typed ;
    skos:definition "§ mit der Liste der Berufsbildpositionen; dient als Skelett-Vorgabe für den ARP (deterministisch)."@de .
beruf:RLP-Rahmenteil a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "RLP-Teile I–IV"@de ; cur:extractionDepth cv:depth_typed ;
    skos:definition "Vorbemerkungen, Bildungsauftrag der Berufsschule, didaktische Grundsätze, berufsbezogene Vorbemerkungen. Bildungsauftrag → Bildungsziele; einmal je Fassung der KMK-Handreichung speichern und per cur:appliesTo teilen."@de .
beruf:AbschnittARP a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_grouping ;
    skos:prefLabel "Abschnitt des Ausbildungsrahmenplans"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Abschnitt A/B/C bzw. Teil A/B: berufsprofilgebende, fachrichtungsübergreifende, integrativ zu vermittelnde Fertigkeiten, Kenntnisse und Fähigkeiten."@de ;
    cur:delimitation "Die Buchstaben sind nicht fest an Funktionen gebunden; die Überschrift entscheidet (übergreifend → cv:share_common, „in der Fachrichtung X“ → cv:share_specific, „integrativ“ → cur:integrative true)."@de .
beruf:Kernqualifikationen a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_grouping ;
    skos:prefLabel "Gemeinsame Kernqualifikationen"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Anlage einer Sammelverordnung, die für mehrere Berufe gilt („zu den §§ 8, 12, 16“) – einmal anlegen, cur:appliesTo auf alle Curricula."@de .
beruf:Lernfeldteil a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_grouping ;
    skos:prefLabel "Lernfeldteil (Teil V)"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "„Teil V Lernfelder“ mit der Übersicht über die Lernfelder (Zeitrichtwerte je Ausbildungsjahr) – Quelle des deterministischen Skeletts."@de .
beruf:Lernbereich a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Lernbereich"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Fachrichtungs- oder berufsübergreifender bzw. -bezogener Lernbereich (Fachschule, Berufskolleg)."@de .
beruf:Handlungsfeld a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Handlungsfeld"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Berufliches Handlungsfeld (Bildungspläne BFS NRW: erste Ziffer der Anforderungssituation)."@de ;
    cur:impliesContext ctx:occupationalFields ;
    cur:delimitation "Kein Lernfeld; im KMK-RLP nur rekonstruierbar, nicht extrahieren."@de .
beruf:Kompetenzbereich a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Kompetenzbereich"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Kompetenzbereich I–V der PflAPrV-Anlagen."@de .
beruf:Kompetenzschwerpunkt a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_subunit ;
    skos:prefLabel "Kompetenzschwerpunkt"@de ; cur:extractionDepth cv:depth_full ;
    cur:typicalParent beruf:Kompetenzbereich ;
    skos:definition "Arabisch nummerierte Untergliederung eines PflAPrV-Kompetenzbereichs (ohne Zeitwert)."@de .
beruf:Buendelungsfach a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Bündelungsfach"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Fach eines NRW-Bildungsplans, das Lernfelder bündelt (Stundentafel)."@de .
beruf:Lernfeld a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Lernfeld"@de ; skos:altLabel "LF"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Durch Ziel, Inhalte und Zeitrichtwert beschriebene thematische Einheit (KMK-Handreichung 2021); Kopfzeile mit Nummer, Titel, Ausbildungsjahr und Zeitrichtwert."@de ;
    cur:typicalParent beruf:Lernfeldteil , beruf:Buendelungsfach ;
    cur:impliesTimeKind cv:time_trainingYear ;
    cur:positiveExample "„Lernfeld 5: Kunden akquirieren und binden – 2. Ausbildungsjahr – Zeitrichtwert: 80 Stunden“"@de .
beruf:Berufsbildposition a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Berufsbildposition"@de ; skos:altLabel "Teil des Ausbildungsberufsbildes"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Zeile der ARP-Tabelle (Spalte 2) mit Lernzielen a), b) … und zeitlichen Richtwerten in Wochen je Zeitraum."@de ;
    cur:typicalParent beruf:AbschnittARP , beruf:Kernqualifikationen ;
    cur:impliesTimeKind cv:time_trainingMonth ;
    skos:closeMatch lp:LP_0000261 .
beruf:Standardberufsbildposition a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_crossCutting ;
    skos:prefLabel "Standardberufsbildposition"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Seit 2021 in allen neu geordneten Berufen wortgleich: Organisation, Sicherheit und Gesundheit, Umweltschutz und Nachhaltigkeit, digitalisierte Arbeitswelt (qz:SBBP2021). Integrativ zu vermitteln, ohne Wochenwerte."@de ;
    skos:scopeNote "Doppelrolle: Knoten im ARP und Querschnittsziel. Wortgleiche SBBP werden über cur:contributesTo am Quellschema qz:SBBP2021 zusammengeführt; die Lernergebnisse bleiben je Beruf."@de .
beruf:CurriculareEinheit a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Curriculare Einheit"@de ; skos:altLabel "CE"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "CE 01–11 der Rahmenpläne nach § 53 PflBG, mit Ausbildungsdrittel und Zeitrichtwert; übernimmt PflAPrV-Kompetenzen wörtlich (regelbasierte, amtliche exactMatch-Kante)."@de .
beruf:Anforderungssituation a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Anforderungssituation"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Einheit der NRW-Bildungspläne (Berufskolleg Anlage C) mit „Zeitrichtwert: 40–50 UStd.“; Code „1.1“ = Handlungsfeld.Anforderungssituation."@de ;
    cur:typicalParent beruf:Handlungsfeld .
beruf:Fach a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Fach"@de ; skos:altLabel "Unterrichtsfach"@de ; cur:extractionDepth cv:depth_full .
beruf:Lerngebiet a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Lerngebiet"@de ; cur:extractionDepth cv:depth_full .
beruf:Modul a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Modul"@de ; skos:altLabel "Ausbildungsbaustein"@de ; cur:extractionDepth cv:depth_full .
beruf:Wahlqualifikationseinheit a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Wahlqualifikationseinheit"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Einheit, die einer cur:Variant (cv:var_electiveQualification) zugeordnet ist; die Auswahl regelt eine cur:SelectionRule."@de .
beruf:ULULehrgang a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "ÜLU-Lehrgang"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Lehrgang mit Kennziffer („G-ETEM1/22“, „G-“ = Grundstufe), meist eine Woche."@de .
beruf:Pruefungsbereich a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Prüfungs- oder Handlungsbereich"@de ; skos:altLabel "Handlungsbereich"@de , "Qualifikationsbereich"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Gliederung einer Fortbildungsordnung nach Prüfungsteilen und -bereichen; zugleich cur:Assessment (gleiches Element mit beiden Typen)."@de ;
    cur:delimitation "Nicht ohne Einzelprüfung einem Lernfeld zuordnen."@de .
beruf:Qualifikationsschwerpunkt a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_subunit ;
    skos:prefLabel "Qualifikationsschwerpunkt"@de ; cur:extractionDepth cv:depth_full ;
    cur:typicalParent beruf:Pruefungsbereich .
beruf:Lernsituation a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_subunit ;
    skos:prefLabel "Lernsituation"@de ; cur:extractionDepth cv:depth_full ;
    skos:definition "Konkretisierung eines Lernfelds in der didaktischen Jahresplanung; nichtamtlich."@de ;
    cur:typicalParent beruf:Lernfeld .
beruf:Verzeichnis a cur:NodeType ; skos:inScheme beruf:NodeTypes ; skos:broader cv:fn_nonCurricular ;
    skos:prefLabel "Verzeichnis/Impressum"@de ; cur:extractionDepth cv:depth_skip .

# =============================================================================
# 4. Aussage-Unterarten
# =============================================================================
beruf:StatementSubkinds a skos:ConceptScheme ; skos:prefLabel "Aussage-Unterarten Berufliche Bildung"@de .

beruf:Kernkompetenz a cur:StatementSubkind ; skos:inScheme beruf:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
    skos:prefLabel "Kernkompetenz"@de ;
    skos:definition "Erster, fett gesetzter Satz eines Lernfelds („Die Schülerinnen und Schüler verfügen über die Kompetenz, …“). Fasst die Zielformulierungen zusammen (cur:summarizes)."@de ;
    cur:segmentation cv:seg_wholeUnit ; cur:defaultAddressee cv:addr_learner .
beruf:Zielformulierung a cur:StatementSubkind ; skos:inScheme beruf:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
    skos:prefLabel "Zielformulierung"@de ; skos:altLabel "ZF"@de ;
    skos:definition "Satz im Präsens im Fließtext des Lernfelds („Sie analysieren …“). Ein Satz = eine Aussage; Mehrfachoperatoren trennt N1."@de ;
    cur:segmentation cv:seg_sentence ; cur:defaultAddressee cv:addr_learner ;
    cur:wordingRule "Kursiv gesetzte Inhalte im Satz bleiben im Wortlaut und werden zusätzlich als Inhaltsaussagen mit cur:layoutMarker cv:mark_italic und cur:targetsContent erfasst."@de .
beruf:FKF a cur:StatementSubkind ; skos:inScheme beruf:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
    skos:prefLabel "Lernziel (Fertigkeiten, Kenntnisse und Fähigkeiten)"@de ; skos:altLabel "FKF"@de ;
    skos:definition "Infinitivsatz a), b), c) in Spalte 3 der ARP-Tabelle („Aufbau und Organisation des Ausbildungsbetriebes erläutern“)."@de ;
    cur:segmentation cv:seg_tableRow ; cur:defaultAddressee cv:addr_learner .
beruf:PflegeKompetenz a cur:StatementSubkind ; skos:inScheme beruf:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
    skos:prefLabel "Kompetenz (PflAPrV)"@de ;
    skos:definition "„Die Auszubildenden …“ a)–h) unter einem Kompetenzschwerpunkt."@de ;
    cur:segmentation cv:seg_bullet ; cur:defaultAddressee cv:addr_learner .
beruf:Qualifikationsinhalt a cur:StatementSubkind ; skos:inScheme beruf:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
