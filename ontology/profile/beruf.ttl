# Kompetenzmodell der Ausbildungsordnungen (FKF-Trias); das KMK-Modell der
# Rahmenlehrpläne ist kd:KMKActionCompetence, die DQR-Kategorien kd:Bridge.
beruf:FKFModel a cur:CompetencyModel ;
    skos:prefLabel "Fertigkeiten, Kenntnisse und Fähigkeiten (Ausbildungsordnung)"@de ;
    dct:source "§ 1 Abs. 3 BBiG (berufliche Handlungsfähigkeit)" ;
    skos:hasTopConcept beruf:fkf-fertigkeiten , beruf:fkf-kenntnisse , beruf:fkf-faehigkeiten .
beruf:fkf-fertigkeiten a cur:CompetenceDimension ; skos:inScheme beruf:FKFModel ; skos:topConceptOf beruf:FKFModel ;
    skos:prefLabel "Fertigkeiten"@de ; skos:closeMatch kd:skills .
beruf:fkf-kenntnisse a cur:CompetenceDimension ; skos:inScheme beruf:FKFModel ; skos:topConceptOf beruf:FKFModel ;
    skos:prefLabel "Kenntnisse"@de ; skos:closeMatch kd:knowledge .
beruf:fkf-faehigkeiten a cur:CompetenceDimension ; skos:inScheme beruf:FKFModel ; skos:topConceptOf beruf:FKFModel ;
    skos:prefLabel "Fähigkeiten"@de ; skos:relatedMatch kd:personal .

# Fortbildungsstufen: die Werte sind lvl:AdvancedVocational (DQR 5/6/7);
# Mindestlernumfänge 400/1200/1600 h als cur:Workload an der Qualifikation.

# =============================================================================
# 6. Terminologieprofil (43 BBO-Hinweise, Muster korrigiert, plus D.4/D.5)
#    Jeder Hinweis mit Muster trägt Positiv- und Negativbeispiele; das
#    Prüfskript wendet das Muster darauf an.
# =============================================================================
beruf:Terminology a cur:TerminologyProfile ;
    rdfs:label "Terminologie Berufliche Bildung"@de ;
    cur:profileScope cv:sec_vocational ;
    cur:hasCue beruf:c-ao-1 , beruf:c-ao-2 , beruf:c-ao-3 , beruf:c-rlp-1 , beruf:c-rlp-2 , beruf:c-llp-1 , beruf:c-fo-1 , beruf:c-fo-2 ,
        beruf:c-66-1 , beruf:c-66-2 , beruf:c-pflege-1 , beruf:c-pflege-2 , beruf:c-uelu-1 , beruf:c-uelu-2 , beruf:c-el-1 ,
        beruf:c-lf-1 , beruf:c-lf-2 , beruf:c-lft-1 , beruf:c-bbp-1 , beruf:c-bbp-2 , beruf:c-bbp-3 , beruf:c-zq-1 , beruf:c-abs-1 ,
        beruf:c-kq-1 , beruf:c-ce-1 , beruf:c-kb-1 , beruf:c-as-1 , beruf:c-hf-1 , beruf:c-lb-1 , beruf:c-lg-1 , beruf:c-qs-1 ,
        beruf:c-qb-1 , beruf:c-hb-1 , beruf:c-kk-1 , beruf:c-kk-2 , beruf:c-kk-3 , beruf:c-inh-1 , beruf:c-inh-2 , beruf:c-inh-3 ,
        beruf:c-inh-4 , beruf:c-fkf-1 , beruf:c-fkf-2 , beruf:c-fkf-3 , beruf:c-gem-1 , beruf:c-spez-1 , beruf:c-int-1 , beruf:c-wahl-1 ,
        beruf:c-zrw-1 , beruf:c-mon-1 , beruf:c-ajahr-1 , beruf:c-pruef-1 , beruf:c-zq-2 , beruf:c-fs-1 , beruf:c-entspr-1 , beruf:c-nicht-dqr .

beruf:c-ao-1 a cur:LexicalCue ; cur:surfaceForm "Verordnung über die Berufsausbildung zum" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_titlePage ; cur:mapsTo beruf:dt-Ausbildungsordnung ; cur:strength 0.95 ; cur:verified true .
beruf:c-ao-2 a cur:LexicalCue ; cur:surfaceForm "Bundesgesetzblatt" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_headerFooter ; cur:mapsTo beruf:dt-Ausbildungsordnung ; cur:strength 0.5 .
beruf:c-ao-3 a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_headingPattern ;
    cur:pattern "^Anlage\\s*(\\d+\\s*)?\\(zu\\s+(den\\s+)?§" ; cur:mapsTo beruf:dt-Ausbildungsordnung , beruf:AbschnittARP ; cur:strength 0.85 ;
    cur:positiveExample "Anlage (zu § 4)" , "Anlage 1 (zu den §§ 8, 12, 16)" ; cur:negativeExample "Anlagenmechaniker" ;
    cur:recognitionHint "Anlage mit Ausbildungsrahmenplan; „zu den §§ …“ mit mehreren Nummern → mehrere Berufe (Sammelverordnung)."@de .
beruf:c-rlp-1 a cur:LexicalCue ; cur:surfaceForm "Rahmenlehrplan für den Ausbildungsberuf" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_titlePage ; cur:mapsTo beruf:dt-Rahmenlehrplan ; cur:strength 0.95 ; cur:verified true .
beruf:c-rlp-2 a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
    cur:pattern "Beschluss der (Kultusministerkonferenz|Bildungsministerkonferenz) vom" ; cur:mapsTo beruf:dt-Rahmenlehrplan ; cur:strength 0.8 ;
    cur:positiveExample "(Beschluss der Kultusministerkonferenz vom 27.09.2013)" ; cur:negativeExample "Beschluss vom 1. Mai" .
beruf:c-llp-1 a cur:LexicalCue ; cur:surfaceForm "Bündelungsfach" ; cur:cueRole cv:role_pref ; cur:cueKind cv:ck_term ;
    cur:mapsTo beruf:Buendelungsfach , beruf:dt-Landeslehrplan ; cur:scopeRegion land:DE-NW ; cur:strength 0.9 .
beruf:c-fo-1 a cur:LexicalCue ; cur:surfaceForm "Prüfung zum anerkannten Fortbildungsabschluss" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_titlePage ; cur:mapsTo beruf:dt-Fortbildungsordnung ; cur:strength 0.9 .
beruf:c-fo-2 a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
    cur:pattern "§\\s*54\\s*BBiG|§\\s*42a\\s*HwO" ; cur:mapsTo beruf:dt-Fortbildungsregelung ; cur:strength 0.8 ;
    cur:positiveExample "nach § 54 BBiG" ; cur:negativeExample "§ 53 BBiG" ;
    cur:recognitionHint "Regelung einer zuständigen Stelle: Kammer in beruf:competentBody."@de .
beruf:c-66-1 a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
    cur:pattern "§\\s*66\\s*BBiG|§\\s*42[mr]\\s*HwO" ; cur:mapsTo beruf:dt-Regelung66 ; cur:strength 0.9 ;
    cur:positiveExample "nach § 66 BBiG" , "§ 42r HwO" , "§42m HwO" ; cur:negativeExample "§ 64 BBiG" ;
    cur:recognitionHint "Ältere Texte § 42m HwO, neuere § 42r HwO."@de .
beruf:c-66-2 a cur:LexicalCue ; cur:surfaceForm "Fachpraktiker" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_titlePage ; cur:mapsTo beruf:dt-Regelung66 ; cur:strength 0.8 .
beruf:c-pflege-1 a cur:LexicalCue ; cur:surfaceForm "Fachkommission nach § 53 PflBG" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo beruf:dt-PflegeRahmenplan ; cur:strength 0.95 .
beruf:c-pflege-2 a cur:LexicalCue ; cur:surfaceForm "Rahmenausbildungsplan" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo beruf:dt-PflegeRahmenplan , ctx:practice-placement ; cur:strength 0.85 ;
    cur:recognitionHint "Lernort Praxiseinsatz (beruf:learningPlace ctx:practice-placement)."@de .
beruf:c-uelu-1 a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_codePattern ;
    cur:pattern "^(G-)?[A-Z]+\\d+/\\d{2}\\b" ; cur:mapsTo beruf:ULULehrgang , beruf:dt-UeLU ; cur:strength 0.85 ;
    cur:positiveExample "G-MET2/19 Schweißen" , "ETEM1/22" ; cur:negativeExample "Lernfeld 2/19" , "g-met2/19" ;
    cur:recognitionHint "Kennziffer als cur:code; „G-“ = Grundstufe."@de ;
    skos:editorialNote "BBO c-uelu-1 korrigiert: der $-Anker verhinderte Treffer, wenn der Titel folgt."@de .
beruf:c-uelu-2 a cur:LexicalCue ; cur:surfaceForm "Unterweisungsplan für einen Lehrgang der überbetrieblichen" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:occursIn cv:occ_titlePage ; cur:mapsTo beruf:dt-UeLU ; cur:strength 0.9 .
beruf:c-el-1 a cur:LexicalCue ; cur:surfaceForm "Liste der Entsprechungen" ; cur:cueRole cv:role_pref ; cur:cueKind cv:ck_term ;
    cur:mapsTo beruf:dt-Entsprechungsliste ; cur:strength 0.95 .
beruf:c-lf-1 a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_headingPattern ;
    cur:pattern "^Lernfeld\\s+\\d+[A-Z]*\\b\\s*:?" ; cur:mapsTo beruf:Lernfeld ; cur:strength 0.95 ;
    cur:positiveExample "Lernfeld 5: Kunden akquirieren" , "Lernfeld 5 Kunden akquirieren" , "Lernfeld 13GH: Projekt" ;
    cur:negativeExample "Lernfelder 1 bis 4" , "Übersicht über die Lernfelder" ;
    cur:recognitionHint "Nummer als cur:code (Zeichenkette, auch „13GH“); Ausbildungsjahr als cur:timeSpan, Zeitrichtwert als cur:workload (cv:unit_lesson, cv:wl_guidanceValue)."@de ;
    skos:editorialNote "BBO c-lf-1 korrigiert: der Doppelpunkt war Pflicht."@de .
beruf:c-lf-2 a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_layout ; cur:layoutSignal cv:mark_tableCell ;
    cur:mapsTo beruf:Lernfeld ; cur:scopeDocumentType beruf:dt-Rahmenlehrplan ; cur:strength 0.9 ;
    cur:recognitionHint "Kopfzeile mit Lernfeldnummer, Titel, Ausbildungsjahr und Zeitrichtwert."@de .
beruf:c-lft-1 a cur:LexicalCue ; cur:surfaceForm "Übersicht über die Lernfelder" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo beruf:Lernfeldteil ; cur:scopeDocumentType beruf:dt-Rahmenlehrplan ; cur:strength 0.9 ;
    cur:recognitionHint "Tabelle liefert in X2 das Skelett (Nummer, Titel, Zeitrichtwerte je Jahr) ohne LLM."@de .
beruf:c-bbp-1 a cur:LexicalCue ; cur:surfaceForm "Berufsbildposition" ; cur:cueRole cv:role_pref ; cur:cueKind cv:ck_term ;
    cur:mapsTo beruf:Berufsbildposition ; cur:scopeDocumentType beruf:dt-Ausbildungsordnung ; cur:strength 0.95 .
beruf:c-bbp-2 a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_tablePattern ; cur:occursIn cv:occ_tableHeader ;
    cur:pattern "^Lfd\\.?\\s*Nr\\.?$" ; cur:mapsTo beruf:Berufsbildposition ; cur:strength 0.9 ;
    cur:positiveExample "Lfd. Nr." , "Lfd Nr" ; cur:negativeExample "Nr. 3" ;
