@prefix schul: <https://w3id.org/wlo/curriculum/profile/school#> .
@prefix cur:   <https://w3id.org/wlo/curriculum/core#> .
@prefix cv:    <https://w3id.org/wlo/curriculum/vocab#> .
@prefix lvl:   <https://w3id.org/wlo/curriculum/level/> .
@prefix qz:    <https://w3id.org/wlo/curriculum/crosscutting/> .
@prefix kd:    <https://w3id.org/wlo/curriculum/dimension/> .
@prefix land:  <https://w3id.org/wlo/curriculum/region/> .
@prefix ctx:   <https://w3id.org/wlo/curriculum/context/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix lp:    <https://w3id.org/lehrplan/ontology/> .
@prefix kimsa: <https://w3id.org/kim/schularten/> .

# =============================================================================
# Profil Schule (schul:) – allgemeinbildende Schulen der 16 Länder und KMK-
# Bildungsstandards. Erweitert den Kern nur um Dokumenttypen, Knotentypen,
# Aussage-Unterarten, schulische Geltungsangaben und das Lexikon.
#
# Länderbegriffe sind Erkennungshinweise mit Geltung (cur:scopeRegion), keine
# Klassen. Das aktive Terminologieprofil eines Dokuments ist der Filter
# „Bereich Schule + Land(er) + Dokumenttyp“ über alle Hinweise; nur dieser
# Ausschnitt geht in den Prompt. Ein generierter Startbestand aus den 539
# FWU-Länderklassen steht in schule-lexikon-fwu.ttl (geringere Stärke,
# nicht am Dokument geprüft).
#
# Quellen: SCO v2 (92 Hinweise, Länder-Matrix), FWU/MEM-Lehrplan-Ontologie,
# Konzept-Lexikon (Andock-Entwurf), wissen/-Vorarbeiten, App-Profile
# schule/schule-kompetenz. Mehrdeutigkeiten (Lernbereich, Standard,
# Anforderung, Themenfeld, Niveau) sind als Homonyme mit Regel geführt.
# =============================================================================

<https://w3id.org/wlo/curriculum/profile/school> a owl:Ontology ;
    dct:title "Curriculum-Profil Schule"@de , "curriculum profile school"@en ;
    owl:imports <https://w3id.org/wlo/curriculum/core> , <https://w3id.org/wlo/curriculum/vocab> ,
        <https://w3id.org/wlo/curriculum/level> , <https://w3id.org/wlo/curriculum/crosscutting> ,
        <https://w3id.org/wlo/curriculum/dimension> , <https://w3id.org/wlo/curriculum/region> ,
        <https://w3id.org/wlo/curriculum/field> , <https://w3id.org/wlo/curriculum/context> ;
    owl:versionInfo "1.0-entwurf" ;
    dct:created "2026-10-19"^^xsd:date .

# =============================================================================
# 1. Profil-Eigenschaften (Geltung)
# =============================================================================
schul:schoolType a owl:ObjectProperty ; rdfs:subPropertyOf cur:institutionType ;
    rdfs:label "Schulart"@de , "school type"@en ;
    skos:definition "KIM-Schulart (https://w3id.org/kim/schularten/sNN) oder landesspezifische Schulart aus schul:SchoolTypes."@de .
schul:specialNeedsFocus a owl:ObjectProperty ;
    rdfs:label "sonderpädagogischer Förderschwerpunkt"@de , "special educational needs focus"@en .
schul:learningGoalRegime a owl:ObjectProperty ;
    rdfs:label "Lernzielregime"@de , "learning goal regime"@en ;
    skos:definition "zielgleich oder zieldifferent (Förderschwerpunkt Lernen, geistige Entwicklung)."@de .
schul:subjectStatus a owl:ObjectProperty ;
    rdfs:label "Stellung des Fachs"@de , "subject status"@en .

# =============================================================================
# 2. Dokumenttypen
# =============================================================================
schul:DocumentTypes a skos:ConceptScheme ; skos:prefLabel "Dokumenttypen Schule"@de .

schul:dt-Lehrplan a cur:DocumentType ; skos:inScheme schul:DocumentTypes ; skos:broader cv:dk_curriculum ;
    skos:prefLabel "Lehrplan"@de ; skos:altLabel "Fachlehrplan"@de ;
    skos:closeMatch lp:LP_0000438 ;
    skos:scopeNote "Landesbezeichnungen über Hinweise: Bildungsplan (BW, HB, HH), Kerncurriculum (HE, NI), Kernlehrplan (NW), Lehrplan (RP, SL, SN, TH), Fachlehrplan (ST, BY), LehrplanPLUS (BY), Rahmenlehrplan (BE/BB), Rahmenplan (MV, HH), Fachanforderungen (SH)."@de .
schul:dt-Bildungsstandards a cur:DocumentType ; skos:inScheme schul:DocumentTypes ; skos:broader cv:dk_framework ;
    skos:prefLabel "KMK-Bildungsstandards"@de ;
    skos:scopeNote "Stellt einen cur:CompetencyFramework dar; Landeslehrpläne konkretisieren ihn (rel_concretizes). Wird einmal importiert (IQB-SKOS), nicht aus jedem Plan neu extrahiert."@de .
schul:dt-Rahmendokument a cur:DocumentType ; skos:inScheme schul:DocumentTypes ; skos:broader cv:dk_curriculum ;
    skos:prefLabel "Rahmendokument/Allgemeiner Teil"@de ;
    skos:altLabel "Grundsatzband"@de , "Allgemeiner Teil"@de , "Teil A"@de , "Teil B"@de ;
    skos:scopeNote "Gilt für viele Fachpläne; seine Gliederungseinheiten (Funktion frame/crossCutting) hängen am Dokument und verweisen per cur:appliesTo auf die Curricula."@de .
schul:dt-Querschnittsrahmen a cur:DocumentType ; skos:inScheme schul:DocumentTypes ; skos:broader cv:dk_framework ;
    skos:prefLabel "Querschnittsrahmen"@de ; skos:altLabel "Medienkompetenzrahmen"@de , "Basiscurriculum"@de , "Orientierungsrahmen"@de .
schul:dt-Pruefungsvorgabe a cur:DocumentType ; skos:inScheme schul:DocumentTypes ; skos:broader cv:dk_assessment ;
    skos:prefLabel "Prüfungsvorgabe"@de ; skos:altLabel "Abiturvorgaben"@de , "Zentralabitur-Schwerpunkte"@de , "Operatorenliste"@de .
schul:dt-Sonderpaedagogisch a cur:DocumentType ; skos:inScheme schul:DocumentTypes ; skos:broader cv:dk_curriculum ;
    skos:prefLabel "Lehrplan für sonderpädagogische Förderung"@de ; skos:altLabel "Lehrplan Förderschule"@de .
schul:dt-Schulintern a cur:DocumentType ; skos:inScheme schul:DocumentTypes ; skos:broader cv:dk_institutional ;
    skos:prefLabel "Schulinternes Curriculum"@de ; skos:altLabel "Schulcurriculum"@de , "schuleigener Arbeitsplan"@de ;
    skos:scopeNote "Konkretisiert einen Landeslehrplan; Rechtsform institutionalDocument, nie amtlich."@de .
schul:dt-Handreichung a cur:DocumentType ; skos:inScheme schul:DocumentTypes ; skos:broader cv:dk_guidance ;
    skos:prefLabel "Handreichung/Umsetzungshilfe"@de ; skos:altLabel "Begleitdokument"@de .

# =============================================================================
# 3. Knotentypen (Gliederungseinheiten)
# =============================================================================
schul:NodeTypes a skos:ConceptScheme ; skos:prefLabel "Knotentypen Schule"@de .

schul:Stufenabschnitt a cur:NodeType ; skos:inScheme schul:NodeTypes ; skos:broader cv:fn_grouping ;
    skos:prefLabel "Stufenabschnitt"@de ;
    skos:definition "Gliederung nach Jahrgang, Doppeljahrgang, Schuljahrgängen oder Phase (Klassen 5/6, Doppeljahrgangsstufe 7/8, Einführungsphase). Setzt den Zeitkontext für alles darunter."@de ;
    cur:impliesTimeKind cv:time_gradeLevel ; cur:extractionDepth cv:depth_full ;
    cur:delimitation "Nicht für Niveaustufen A–H (BE/BB): die sind Niveau, nicht Zeit."@de ;
    cur:positiveExample "„Standards für inhaltsbezogene Kompetenzen Klassen 5/6“ (BW)"@de , "„Jahrgangsstufe 7“ (BY)"@de .
schul:Kompetenzbereich a cur:NodeType ; skos:inScheme schul:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Kompetenzbereich"@de ;
    skos:definition "Prozess- oder Kompetenzdimension des Fachs (Sachkompetenz, Erkenntnisgewinnung, prozessbezogene Kompetenzen)."@de ;
    cur:extractionDepth cv:depth_full ;
    skos:closeMatch lp:LP_0000349 ;
    skos:scopeNote "In Matrixlayouts (NW: Kompetenzbereich × Inhaltsfeld) wird der Kompetenzbereich als cur:AreaConcept dedupliziert und Erwartungen erhalten cur:inArea, statt den Baum zu verdoppeln."@de .
schul:Inhaltsbereich a cur:NodeType ; skos:inScheme schul:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Inhaltsbereich"@de ;
    skos:definition "Thematische Ordnungseinheit ohne eigenen Zeitumfang: Inhaltsfeld, Themenfeld, Themenbereich, Leitidee, Kompetenzschwerpunkt, Gegenstandsbereich, Rahmenthema."@de ;
    cur:extractionDepth cv:depth_full ; cur:typicalParent schul:Stufenabschnitt , schul:Kompetenzbereich ;
    skos:closeMatch lp:LP_0000349 .
schul:IntegrierterBereich a cur:NodeType ; skos:inScheme schul:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Integrierter Bereich"@de ;
    skos:definition "Bereich, der Kompetenz und Inhalt verbindet (BY LehrplanPLUS Grundschule Deutsch: Lernbereiche = Kompetenzstrukturmodell)."@de ;
    cur:extractionDepth cv:depth_full .
schul:Unterrichtseinheit a cur:NodeType ; skos:inScheme schul:NodeTypes ; skos:broader cv:fn_unit ;
    skos:prefLabel "Unterrichtseinheit"@de ;
    skos:definition "Abgeschlossene Einheit mit Zeitumfang oder fester Lage: Lernbereich mit Zeitrichtwert (SN), Modul (BY Mittelschule), Unterrichtsvorhaben (schulintern), Halbjahresthema, Wahl(pflicht)bereich (SN)."@de ;
    cur:extractionDepth cv:depth_full ;
    cur:positiveExample "„Lernbereich 1: Leben in einer Gemeinschaft 26 Ustd.“ (SN)"@de .
schul:Teilbereich a cur:NodeType ; skos:inScheme schul:NodeTypes ; skos:broader cv:fn_subunit ;
    skos:prefLabel "Teilbereich"@de ;
    skos:definition "Untergliederung eines Bereichs oder einer Einheit: inhaltlicher Schwerpunkt (NW), Teilbereich (BY), Schwerpunkt (TH)."@de ;
    cur:extractionDepth cv:depth_full .
schul:Querschnittsbereich a cur:NodeType ; skos:inScheme schul:NodeTypes ; skos:broader cv:fn_crossCutting ;
    skos:prefLabel "Querschnittsbereich"@de ;
    skos:definition "Abschnitt mit überfachlichen Zielen: Leitperspektiven, überfachliche Kompetenzen, Basiscurricula, übergreifende Themen, Aufgabengebiete."@de ;
    cur:extractionDepth cv:depth_full ;
    skos:closeMatch lp:LP_0030325 .
schul:Entwicklungsbereich a cur:NodeType ; skos:inScheme schul:NodeTypes ; skos:broader cv:fn_area ;
    skos:prefLabel "Entwicklungsbereich"@de ;
    skos:definition "Entwicklungsbezogene Kompetenzen in sonderpädagogischen Lehrplänen (BY Förderschule)."@de ;
    cur:extractionDepth cv:depth_full .
schul:Rahmenteil a cur:NodeType ; skos:inScheme schul:NodeTypes ; skos:broader cv:fn_frame ;
    skos:prefLabel "Rahmenteil"@de ;
    skos:definition "Fachprofil, Leitgedanken, Bildungsbeitrag, Bildungs- und Erziehungsauftrag, Kompetenzmodell, Operatorenliste, Leistungsbewertung."@de ;
    cur:extractionDepth cv:depth_typed ;
    skos:closeMatch lp:LP_0001015 ;
    skos:scopeNote "Wird in X3 einmal gelesen: Kompetenzmodell, Querschnittslegende und Operatorenliste werden Auswahllisten für X4."@de .
schul:Verzeichnis a cur:NodeType ; skos:inScheme schul:NodeTypes ; skos:broader cv:fn_nonCurricular ;
    skos:prefLabel "Verzeichnis/Vorwort"@de ; cur:extractionDepth cv:depth_skip .

# =============================================================================
# 4. Aussage-Unterarten
# =============================================================================
schul:StatementSubkinds a skos:ConceptScheme ; skos:prefLabel "Aussage-Unterarten Schule"@de .

schul:Kompetenzerwartung a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
    skos:prefLabel "Kompetenzerwartung"@de ;
    skos:definition "Ergebnisorientierte, überprüfbare Erwartung an Schülerinnen und Schüler zu einem Zeitpunkt oder Niveau."@de ;
    cur:segmentation cv:seg_bullet ; cur:defaultAddressee cv:addr_learner ;
    cur:wordingRule "Wortlaut wörtlich ohne den gemeinsamen Einleitungssatz („Die Schülerinnen und Schüler …“), der in cur:leadIn steht. Ein Spiegelstrich = eine Aussage; nicht aufspalten (das macht N1)."@de ;
    cur:positiveExample "„beschreiben den Zusammenhang von Spannung, Stromstärke und Widerstand“"@de ;
    cur:negativeExample "„Elektrische Stromkreise“ (Inhalt ohne Operator)"@de ;
    skos:closeMatch lp:LP_0000263 .
schul:UebergeordneteKompetenzerwartung a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
    skos:prefLabel "übergeordnete Kompetenzerwartung"@de ;
    skos:definition "Erwartung auf Ebene des Kompetenzbereichs, für mehrere Inhaltsfelder geltend (NW)."@de ;
    cur:segmentation cv:seg_bullet .
schul:KonkretisierteKompetenzerwartung a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
    skos:prefLabel "konkretisierte Kompetenzerwartung"@de ;
    skos:definition "Erwartung je Inhaltsfeld bzw. Inhaltsbereich (NW, HE)."@de ;
    cur:segmentation cv:seg_bullet .
schul:Zusammenfassung a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
    skos:prefLabel "zusammenfassende Kompetenzerwartung"@de ;
    skos:definition "Zusammenfassung im Jahrgangsstufenprofil („Grundlegende Kompetenzen“, BY); keine neue Erwartung, verweist per cur:summarizes auf die Fachlehrplan-Erwartungen und wird nicht mit ihnen dedupliziert."@de .
schul:NiveaugebundeneErwartung a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_learningOutcome ;
    skos:prefLabel "niveaugebundene Erwartung"@de ;
    skos:definition "Zelle einer Niveautabelle (BE/BB „Standards“ nach Niveaustufen A–H, BW G/M/E, HH Mindest-/erhöhte Anforderungen). Gleicher Wortlaut über mehrere Niveaus = ein Element mit mehreren Niveauzuordnungen."@de ;
    cur:segmentation cv:seg_tableCell .
schul:Regelstandard a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_standard ;
    skos:prefLabel "Regelstandard (KMK-Bildungsstandard)"@de ;
    skos:definition "Standard am Ende eines Bildungsabschnitts in den KMK-Bildungsstandards; Item eines Kompetenzrahmens, an den Landeslehrpläne andocken."@de ;
    cur:segmentation cv:seg_bullet .
schul:Inhalt a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_content ;
    skos:prefLabel "Inhalt"@de ;
    skos:definition "Gegenstand, Begriff oder Wissensbestand ohne Operator."@de ;
    cur:segmentation cv:seg_bullet ;
    cur:wordingRule "„Mögliche Inhalte“, „z. B.“ = Verbindlichkeit exemplary; „verbindliche Inhalte“ = binding."@de ;
    skos:closeMatch lp:LP_0000332 .
schul:Fachbegriff a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_content ;
    skos:prefLabel "Fachbegriff/Basisbegriff"@de ;
    skos:definition "Liste verbindlicher Fachbegriffe („Fachbegriffe:“, Basisbegriffe SL, verbindliches Fachwissen SL)."@de ;
    cur:segmentation cv:seg_bullet .
schul:Experiment a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_content ;
    skos:prefLabel "Experiment/Versuch"@de ;
    skos:definition "Genannter Versuch oder Schülerexperiment als Inhaltsvorgabe."@de .
schul:Hinweis a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_guidance ;
    skos:prefLabel "Hinweis/Anregung"@de ;
    skos:definition "Bemerkungen, Hinweise und Anregungen, Umsetzungshilfen, Denkanstöße, Unterrichtsanregungen."@de ;
    cur:delimitation "Nie als Erwartung klassifizieren, auch wenn ein Operator vorkommt („bietet sich an“, „z. B. durch …“)."@de ;
    skos:closeMatch lp:LP_0000852 .
schul:Verweis a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_reference ;
    skos:prefLabel "Verweis"@de ;
    skos:definition "Verweis auf andere Fächer, Klassenstufen, Lernbereiche, Basiskonzepte oder Leitperspektiven (BW P/I/F/L, SN „➔“)."@de ;
    skos:closeMatch lp:LP_0030065 .
schul:Bildungsbeitrag a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_developmentGoal ;
    skos:prefLabel "Bildungsbeitrag/Leitgedanke"@de ;
    skos:definition "Normative Ziele des Fachs im Fachprofil oder in den Leitgedanken ohne Prüfanspruch."@de .
schul:Unterrichtsauftrag a cur:StatementSubkind ; skos:inScheme schul:StatementSubkinds ; skos:broader cv:kind_mandate ;
    skos:prefLabel "Auftrag an Schule/Unterricht"@de ;
    skos:definition "„Der Unterricht ermöglicht …“, „Die Lehrkräfte berücksichtigen …“ – Adressat Lehrende oder Einrichtung."@de ;
    cur:defaultAddressee cv:addr_educator .

# =============================================================================
# 5. Schulische Wertelisten
# =============================================================================
schul:SpecialNeedsFoci a skos:ConceptScheme ; skos:prefLabel "Sonderpädagogische Förderschwerpunkte"@de .
schul:sn-lernen a skos:Concept ; skos:inScheme schul:SpecialNeedsFoci ; skos:topConceptOf schul:SpecialNeedsFoci ; skos:prefLabel "Lernen"@de .
schul:sn-sprache a skos:Concept ; skos:inScheme schul:SpecialNeedsFoci ; skos:topConceptOf schul:SpecialNeedsFoci ; skos:prefLabel "Sprache"@de .
schul:sn-emsoz a skos:Concept ; skos:inScheme schul:SpecialNeedsFoci ; skos:topConceptOf schul:SpecialNeedsFoci ; skos:prefLabel "emotionale und soziale Entwicklung"@de .
schul:sn-geistig a skos:Concept ; skos:inScheme schul:SpecialNeedsFoci ; skos:topConceptOf schul:SpecialNeedsFoci ; skos:prefLabel "geistige Entwicklung"@de .
schul:sn-koerper a skos:Concept ; skos:inScheme schul:SpecialNeedsFoci ; skos:topConceptOf schul:SpecialNeedsFoci ; skos:prefLabel "körperliche und motorische Entwicklung"@de .
schul:sn-hoeren a skos:Concept ; skos:inScheme schul:SpecialNeedsFoci ; skos:topConceptOf schul:SpecialNeedsFoci ; skos:prefLabel "Hören"@de ; skos:altLabel "Hören und Kommunikation"@de .
schul:sn-sehen a skos:Concept ; skos:inScheme schul:SpecialNeedsFoci ; skos:topConceptOf schul:SpecialNeedsFoci ; skos:prefLabel "Sehen"@de .

schul:LearningGoalRegimes a skos:ConceptScheme ; skos:prefLabel "Lernzielregime"@de .
schul:lgr-same a skos:Concept ; skos:inScheme schul:LearningGoalRegimes ; skos:topConceptOf schul:LearningGoalRegimes ; skos:prefLabel "zielgleich"@de .
schul:lgr-different a skos:Concept ; skos:inScheme schul:LearningGoalRegimes ; skos:topConceptOf schul:LearningGoalRegimes ; skos:prefLabel "zieldifferent"@de .

schul:Phases a skos:ConceptScheme ; skos:prefLabel "Schulphasen"@de ;
    skos:scopeNote "Werte für cur:phase (cur:timeKind cv:time_phase)."@de .
schul:ph-eingang a skos:Concept ; skos:inScheme schul:Phases ; skos:topConceptOf schul:Phases ; skos:prefLabel "Schuleingangsphase"@de .
schul:ph-orientierung a skos:Concept ; skos:inScheme schul:Phases ; skos:topConceptOf schul:Phases ; skos:prefLabel "Orientierungsstufe"@de .
schul:ph-einfuehrung a skos:Concept ; skos:inScheme schul:Phases ; skos:topConceptOf schul:Phases ; skos:prefLabel "Einführungsphase"@de ; skos:altLabel "E-Phase"@de .
schul:ph-qualifikation a skos:Concept ; skos:inScheme schul:Phases ; skos:topConceptOf schul:Phases ; skos:prefLabel "Qualifikationsphase"@de ; skos:altLabel "Q-Phase"@de .
schul:ph-kursstufe a skos:Concept ; skos:inScheme schul:Phases ; skos:topConceptOf schul:Phases ; skos:prefLabel "Kursstufe"@de ; skos:scopeNote "BW"@de .
schul:ph-studienstufe a skos:Concept ; skos:inScheme schul:Phases ; skos:topConceptOf schul:Phases ; skos:prefLabel "Studienstufe"@de ; skos:scopeNote "HH"@de .

schul:SubjectStatuses a skos:ConceptScheme ; skos:prefLabel "Stellung des Fachs"@de .
schul:ss-pflicht a skos:Concept ; skos:inScheme schul:SubjectStatuses ; skos:topConceptOf schul:SubjectStatuses ; skos:prefLabel "Pflichtfach"@de .
schul:ss-wahlpflicht a skos:Concept ; skos:inScheme schul:SubjectStatuses ; skos:topConceptOf schul:SubjectStatuses ; skos:prefLabel "Wahlpflichtfach"@de .
schul:ss-wahl a skos:Concept ; skos:inScheme schul:SubjectStatuses ; skos:topConceptOf schul:SubjectStatuses ; skos:prefLabel "Wahlfach"@de .
schul:ss-fs1 a skos:Concept ; skos:inScheme schul:SubjectStatuses ; skos:topConceptOf schul:SubjectStatuses ; skos:prefLabel "erste Fremdsprache"@de .
schul:ss-fs2 a skos:Concept ; skos:inScheme schul:SubjectStatuses ; skos:topConceptOf schul:SubjectStatuses ; skos:prefLabel "zweite Fremdsprache"@de .
schul:ss-fs3 a skos:Concept ; skos:inScheme schul:SubjectStatuses ; skos:topConceptOf schul:SubjectStatuses ; skos:prefLabel "dritte Fremdsprache"@de .

schul:SchoolTypes a skos:ConceptScheme ; skos:prefLabel "Landesspezifische Schularten"@de ;
    skos:scopeNote "Kernschularten sind die KIM-Schularten kimsa:s02–s16 (https). Hier nur Landesbezeichnungen ohne eigenes KIM-Konzept; broadMatch ist ein Vorschlag (FWU-Schulart-Ontologie für die verbindliche Zuordnung je Land heranziehen)."@de .
schul:st-mittelschule a skos:Concept ; skos:inScheme schul:SchoolTypes ; skos:topConceptOf schul:SchoolTypes ; skos:prefLabel "Mittelschule (BY)"@de ; skos:exactMatch kimsa:s03 .
schul:st-werkrealschule a skos:Concept ; skos:inScheme schul:SchoolTypes ; skos:topConceptOf schul:SchoolTypes ; skos:prefLabel "Werkrealschule (BW)"@de ; skos:broadMatch kimsa:s03 .
schul:st-stadtteilschule a skos:Concept ; skos:inScheme schul:SchoolTypes ; skos:topConceptOf schul:SchoolTypes ; skos:prefLabel "Stadtteilschule (HH)"@de ; skos:broadMatch kimsa:s05 .
schul:st-iss a skos:Concept ; skos:inScheme schul:SchoolTypes ; skos:topConceptOf schul:SchoolTypes ; skos:prefLabel "Integrierte Sekundarschule (BE)"@de ; skos:broadMatch kimsa:s05 .
schul:st-regionaleschule a skos:Concept ; skos:inScheme schul:SchoolTypes ; skos:topConceptOf schul:SchoolTypes ; skos:prefLabel "Regionale Schule (MV)"@de ; skos:broadMatch kimsa:s10 .
schul:st-realschuleplus a skos:Concept ; skos:inScheme schul:SchoolTypes ; skos:topConceptOf schul:SchoolTypes ; skos:prefLabel "Realschule plus (RP)"@de ; skos:broadMatch kimsa:s10 .
schul:st-regelschule a skos:Concept ; skos:inScheme schul:SchoolTypes ; skos:topConceptOf schul:SchoolTypes ; skos:prefLabel "Regelschule (TH)"@de ; skos:broadMatch kimsa:s10 .
