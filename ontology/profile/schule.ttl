    cur:recognitionHint "Satzstamm als cur:leadIn speichern; Operator meist am Satzende."@de .
schul:cue-ke-sn-zielbegriff a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
    cur:pattern "^(Kennen|Anwenden|Beurteilen|Sich positionieren|Einblick gewinnen|Gestalten|Übertragen)\\b" ;
