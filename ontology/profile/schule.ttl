schul:cue-ke-grundlegende a cur:LexicalCue ; cur:surfaceForm "Grundlegende Kompetenzen" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:Zusammenfassung ; cur:scopeRegion land:DE-BY ; cur:strength 0.8 ;
    cur:negativeHint "Zusammenfassung im Jahrgangsstufenprofil, keine neue Erwartung; nicht mit Fachlehrplan-Erwartungen deduplizieren."@de .
schul:cue-ke-anforderung-hb a cur:LexicalCue ; cur:surfaceForm "Anforderung" ; cur:cueRole cv:role_homonym ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:Kompetenzerwartung ; cur:alsoMapsTo lvl:AFB ; cur:scopeRegion land:DE-HB , land:DE-HH ; cur:strength 0.6 ; cur:verified false ;
    cur:recognitionHint "„Anforderungsbereich I–III“ → Aufgabenanforderung (nur an Aufgaben); sonst Erwartung bzw. Erwartungsniveau."@de .
schul:cue-ke-satzstamm a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_sentencePattern ;
