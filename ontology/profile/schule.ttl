    cur:pattern "^C?1\\.?\\s+Kompetenzentwicklung" ; cur:mapsTo schul:Rahmenteil ; cur:scopeRegion land:DE-BE , land:DE-BB ; cur:strength 0.8 ;
    cur:recognitionHint "BE/BB C1: Kompetenzmodell des Fachs – in X3 als Kompetenzmodell lesen."@de .

# --- Inhaltsbereiche und Einheiten ----------------------------------------
schul:cue-ib-inhaltsfeld a cur:LexicalCue ; cur:surfaceForm "Inhaltsfeld" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_headingPattern ;
    cur:pattern "^Inhaltsfeld\\s+\\d+\\s*[:.]" ; cur:mapsTo schul:Inhaltsbereich ; cur:scopeRegion land:DE-HE , land:DE-NW ; cur:strength 0.95 ;
    cur:recognitionHint "NW: darunter „Inhaltliche Schwerpunkte“ und konkretisierte Kompetenzerwartungen nach Sach- und Urteilskompetenz."@de .
schul:cue-ib-themenfeld a cur:LexicalCue ; cur:surfaceForm "Themenfeld" ; cur:cueRole cv:role_homonym ; cur:cueKind cv:ck_headingPattern ;
    cur:pattern "^(\\d+(\\.\\d+)*\\s+)?Themenfeld" ; cur:mapsTo schul:Inhaltsbereich ; cur:alsoMapsTo schul:Unterrichtseinheit ;
    cur:scopeRegion land:DE-BW , land:DE-BE , land:DE-BB , land:DE-RP , land:DE-SL , land:DE-HE ; cur:strength 0.75 ;
    cur:recognitionHint "Einheit, wenn das Themenfeld einen Zeitumfang, einen festen Jahrgang oder eine Verbindlichkeit (verbindlich/wahlobligatorisch) trägt (BE/BB C3, HE Oberstufe); sonst Inhaltsbereich."@de .
schul:cue-ib-themenbereich a cur:LexicalCue ; cur:surfaceForm "Themenbereich" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:Inhaltsbereich ; cur:scopeRegion land:DE-HB , land:DE-MV , land:DE-NI , land:DE-SH ; cur:strength 0.75 .
schul:cue-ib-leitidee a cur:LexicalCue ; cur:surfaceForm "Leitidee" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:Inhaltsbereich ; cur:scopeSubject <https://w3id.org/wlo/curriculum/field/0541> ; cur:strength 0.8 ;
    cur:recognitionHint "Mathematik (KMK-Bildungsstandards und Landespläne): Leitideen wie „Zahl und Operation“, „Raum und Form“."@de .
schul:cue-ib-kompetenzschwerpunkt a cur:LexicalCue ; cur:surfaceForm "Kompetenzschwerpunkt" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:Inhaltsbereich ; cur:scopeRegion land:DE-ST ; cur:strength 0.9 ;
    cur:negativeHint "Klingt nach Kompetenzbereich, ist aber inhaltlich gegliedert; Kompetenzbereiche erscheinen darunter als Zeilenköpfe, Inhalte als „Grundlegende Wissensbestände“."@de .
schul:cue-ib-gegenstandsbereich a cur:LexicalCue ; cur:surfaceForm "Gegenstandsbereich" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:Inhaltsbereich ; cur:scopeRegion land:DE-BY ; cur:strength 0.8 .
schul:cue-ib-rahmenthema a cur:LexicalCue ; cur:surfaceForm "Rahmenthema" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:Inhaltsbereich ; cur:scopeRegion land:DE-NI ; cur:strength 0.8 .
schul:cue-ib-lernbereich a cur:LexicalCue ; cur:surfaceForm "Lernbereich" ; cur:cueRole cv:role_homonym ; cur:cueKind cv:ck_headingPattern ;
    cur:pattern "^Lernbereich\\s+\\d+\\s*[:.]" ; cur:mapsTo schul:Inhaltsbereich ; cur:alsoMapsTo schul:IntegrierterBereich ;
    cur:scopeRegion land:DE-BY , land:DE-TH ; cur:strength 0.7 ;
    cur:recognitionHint "BY Grundschule Deutsch: Lernbereich = Bereich des Kompetenzstrukturmodells (integriert)."@de .
schul:cue-ib-lernbereich-sn a cur:LexicalCue ; cur:surfaceForm "Lernbereich" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_headingPattern ;
    cur:pattern "^Lernbereich\\s+\\d+\\s*:.*\\d+\\s*Ustd" ; cur:mapsTo schul:Unterrichtseinheit ; cur:scopeRegion land:DE-SN ; cur:strength 0.9 ;
    cur:recognitionHint "SN: Lernbereich mit Zeitrichtwert („26 Ustd.“) = Einheit; Zeitrichtwert als cur:workload (Unterrichtsstunden, Zeitrichtwert)."@de .
schul:cue-ib-lernbereich-faecherverbund a cur:LexicalCue ; cur:surfaceForm "Lernbereich Naturwissenschaften" ; cur:cueRole cv:role_negative ; cur:cueKind cv:ck_term ;
    cur:mapsTo cur:Curriculum ; cur:scopeRegion land:DE-NW ; cur:strength 0.85 ;
    cur:recognitionHint "NRW-Gesamtschule: „Lernbereich Naturwissenschaften“/„Lernbereich Gesellschaftslehre“ ist ein Fächerverbund (eigenes Curriculum mit mehreren Fächern), kein Knoten."@de .
schul:cue-ib-wahlbereich a cur:LexicalCue ; cur:surfaceForm "Wahlbereich" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_headingPattern ;
