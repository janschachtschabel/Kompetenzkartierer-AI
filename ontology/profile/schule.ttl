# --- Dokumenttypen --------------------------------------------------------
schul:cue-dt-bildungsplan a cur:LexicalCue ; cur:surfaceForm "Bildungsplan" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:dt-Lehrplan ; cur:scopeRegion land:DE-BW , land:DE-HB , land:DE-HH ; cur:occursIn cv:occ_titlePage ; cur:strength 0.9 ;
    cur:negativeHint "In Kita-Dokumenten (Bildungsplan BB, SN) gehört das Wort zum Profil elem:."@de .
schul:cue-dt-kerncurriculum a cur:LexicalCue ; cur:surfaceForm "Kerncurriculum" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:dt-Lehrplan ; cur:scopeRegion land:DE-HE , land:DE-NI ; cur:occursIn cv:occ_titlePage ; cur:strength 0.9 .
