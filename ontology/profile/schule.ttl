    cur:mapsTo schul:dt-Lehrplan ; cur:scopeRegion land:DE-NW ; cur:occursIn cv:occ_titlePage ; cur:strength 0.95 .
schul:cue-dt-lehrplan a cur:LexicalCue ; cur:surfaceForm "Lehrplan" ; cur:cueRole cv:role_pref ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:dt-Lehrplan ; cur:scopeRegion land:DE-RP , land:DE-SL , land:DE-SN , land:DE-TH ; cur:occursIn cv:occ_titlePage ; cur:strength 0.8 .
