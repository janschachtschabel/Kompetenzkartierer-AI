    cur:pattern "\\[MD([1-6])\\]" ; cur:mapsTo qz:KMKDigital ; cur:scopeRegion land:DE-MV ; cur:strength 0.8 ; cur:verified false ;
    cur:recognitionHint "Ziffer 1–6 vermutlich KMK-Kompetenzbereich qz:kmkdig-1 … -6; am Plan prüfen."@de .
schul:cue-qk-sn-pfeil a cur:LexicalCue ; cur:surfaceForm "⇒" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_codePattern ; cur:layoutSignal cv:mark_marginSymbol ;
    cur:pattern "⇒\\s*([A-ZÄÖÜ][\\wäöüß ]+)" ; cur:mapsTo qz:Hub ; cur:scopeRegion land:DE-SN ; cur:strength 0.8 ;
    cur:recognitionHint "Doppelpfeil vor einem Querschnittsziel („⇒ Medienbildung“, „⇒ Bildung für nachhaltige Entwicklung“): Rohmarker, Auflösung über Label im qz:Hub."@de .

# --- Verweise ---------------------------------------------------------------
schul:cue-vw-bw-pifl a cur:LexicalCue ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_codePattern ; cur:layoutSignal cv:mark_marginSymbol ;
    cur:pattern "^(P|I|F|L)\\s+[\\w.]+" ; cur:mapsTo schul:Verweis ; cur:scopeRegion land:DE-BW ; cur:planGeneration "BP2016" ; cur:strength 0.85 ;
    cur:recognitionHint "Verweisspalte: P = prozessbezogene Kompetenz, I = inhaltsbezogene Kompetenz (beide im selben Plan), F = anderes Fach, L = Leitperspektive (→ cur:contributesTo)."@de .
schul:cue-vw-sn-pfeil a cur:LexicalCue ; cur:surfaceForm "➔" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_codePattern ; cur:layoutSignal cv:mark_marginSymbol ;
    cur:pattern "(➔|→)\\s*([A-Z]{2,4},\\s*)?Kl\\.\\s*\\d+" ; cur:mapsTo schul:Verweis ; cur:scopeRegion land:DE-SN ; cur:strength 0.85 ;
    cur:recognitionHint "„➔ GE, Kl. 8/9, LB 2“ = Verweis auf Fach, Klasse, Lernbereich; ohne LLM auflösen."@de .

