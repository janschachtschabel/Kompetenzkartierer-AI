    cur:mapsTo schul:dt-Lehrplan ; cur:scopeRegion land:DE-BY ; cur:planGeneration "LehrplanPLUS" ; cur:strength 0.95 .
schul:cue-dt-rahmenlehrplan a cur:LexicalCue ; cur:surfaceForm "Rahmenlehrplan" ; cur:cueRole cv:role_homonym ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:dt-Lehrplan ; cur:scopeRegion land:DE-BE , land:DE-BB ; cur:strength 0.9 ;
    cur:recognitionHint "BE/BB: ländergemeinsamer Rahmenlehrplan 1–10 mit Teil A, B, C."@de ;
    cur:negativeHint "„Rahmenlehrplan für den Ausbildungsberuf …“ (KMK) gehört ins Profil beruf:."@de .
schul:cue-dt-rahmenplan a cur:LexicalCue ; cur:surfaceForm "Rahmenplan" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:dt-Lehrplan ; cur:scopeRegion land:DE-HH , land:DE-MV ; cur:strength 0.9 .
schul:cue-dt-fachanforderungen a cur:LexicalCue ; cur:surfaceForm "Fachanforderungen" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:dt-Lehrplan ; cur:scopeRegion land:DE-SH ; cur:strength 0.95 .
schul:cue-dt-bildungsstandards a cur:LexicalCue ; cur:surfaceForm "Bildungsstandards" ; cur:cueRole cv:role_pref ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:dt-Bildungsstandards ; cur:scopeRegion land:DE ; cur:strength 0.9 ;
    cur:recognitionHint "Herausgeber Kultusministerkonferenz; Standards für das Ende eines Bildungsabschnitts (Primarbereich, ESA, MSA, AHR)."@de .
schul:cue-dt-grundsatzband a cur:LexicalCue ; cur:surfaceForm "Grundsatzband" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:dt-Rahmendokument ; cur:scopeRegion land:DE-ST ; cur:strength 0.9 .
schul:cue-dt-allgemeinerteil a cur:LexicalCue ; cur:surfaceForm "Allgemeiner Teil" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo schul:dt-Rahmendokument , schul:Rahmenteil ; cur:scopeRegion land:DE-SH ; cur:strength 0.9 .
schul:cue-dt-teilA a cur:LexicalCue ; cur:surfaceForm "Teil A" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_headingPattern ;
    cur:pattern "^Teil\\s+A\\b" ; cur:mapsTo schul:Rahmenteil ; cur:scopeRegion land:DE-BE , land:DE-BB ; cur:strength 0.85 ;
    cur:recognitionHint "Teil A Bildung und Erziehung in der Grundschule und Sekundarstufe I – gilt für alle Fächer (cur:appliesTo)."@de .
schul:cue-dt-teilB a cur:LexicalCue ; cur:surfaceForm "Teil B" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_headingPattern ;
    cur:pattern "^Teil\\s+B\\b" ; cur:mapsTo schul:Querschnittsbereich ; cur:scopeRegion land:DE-BE , land:DE-BB ; cur:strength 0.85 ;
    cur:recognitionHint "Fachübergreifende Kompetenzentwicklung: Basiscurricula Sprach- und Medienbildung, übergreifende Themen (qz:BEBB-TeilB)."@de .
schul:cue-dt-teilC a cur:LexicalCue ; cur:surfaceForm "Teil C" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_headingPattern ;
    cur:pattern "^Teil\\s+C\\b" ; cur:mapsTo cur:Curriculum ; cur:scopeRegion land:DE-BE , land:DE-BB ; cur:strength 0.85 ;
    cur:recognitionHint "Fachteil = eigenes Curriculum: C1 Kompetenzentwicklung, C2 Kompetenzen und Standards (Niveaustufen A–H), C3 Themen und Inhalte."@de .
schul:cue-dt-anhoerung a cur:LexicalCue ; cur:surfaceForm "Anhörungsfassung" ; cur:cueRole cv:role_cue ; cur:cueKind cv:ck_term ;
    cur:mapsTo cv:life_consultation ; cur:occursIn cv:occ_titlePage ; cur:strength 0.95 ;
    cur:recognitionHint "Setzt den Lebenszyklus; das Dokument ist nicht in Kraft (ST 2026, NI 2024)."@de .

