cv:cc_human a skos:Concept ; skos:inScheme cv:ConflictCriteria ; skos:topConceptOf cv:ConflictCriteria ;
    skos:notation "human" ; skos:prefLabel "redaktionelle Entscheidung"@de , "human decision"@en .

# -----------------------------------------------------------------------------
# Zuordnungsrelationen (Kantenvokabular) – nur im Kantenpass G1 und in N2
# -----------------------------------------------------------------------------
cv:AlignmentRelations a skos:ConceptScheme ;
    skos:prefLabel "Zuordnungsrelationen"@de , "alignment relations"@en ;
    skos:definition "Ein Relationsvokabular für alle Zuordnungen. Richtung immer Quelle → Ziel. SKOS-Relationen behalten die SKOS-Richtung (Quelle broadMatch Ziel = Ziel ist breiter). Entsprechungen zu CTDL-ASN und CASE stehen in cur-alignments.ttl."@de .
cv:rel_exactMatch a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "exactMatch" ; skos:prefLabel "gleichwertig"@de , "exact match"@en ;
    cur:shortcut skos:exactMatch ;
    skos:definition "Gleiche Anforderung bzw. gleicher Begriff."@de .
cv:rel_closeMatch a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "closeMatch" ; skos:prefLabel "nahezu gleichwertig"@de , "close match"@en ;
    cur:shortcut skos:closeMatch .
cv:rel_broadMatch a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "broadMatch" ; skos:prefLabel "Ziel ist breiter"@de , "broad match"@en ;
    cur:shortcut skos:broadMatch ;
    skos:definition "Das Ziel umfasst die Quelle und mehr."@de .
cv:rel_narrowMatch a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "narrowMatch" ; skos:prefLabel "Ziel ist enger"@de , "narrow match"@en ;
    cur:shortcut skos:narrowMatch ;
    skos:definition "Die Quelle umfasst das Ziel und mehr."@de .
cv:rel_relatedMatch a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "relatedMatch" ; skos:prefLabel "verwandt"@de , "related match"@en ;
    cur:shortcut skos:relatedMatch ;
    skos:definition "Gemeinsame Grundlage ohne Hierarchie oder Kette."@de .
cv:rel_majorOverlap a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "majorOverlap" ; skos:prefLabel "überlappt stark"@de , "major overlap"@en ;
    cur:shortcut cur:majorOverlap .
cv:rel_minorOverlap a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "minorOverlap" ; skos:prefLabel "überlappt schwach"@de , "minor overlap"@en ;
    cur:shortcut cur:minorOverlap .
cv:rel_requires a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "requires" ; skos:prefLabel "setzt voraus"@de , "requires"@en ;
    cur:shortcut cur:requires .
cv:rel_buildsOn a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "buildsOn" ; skos:prefLabel "steigert"@de , "builds on"@en ;
    cur:shortcut cur:buildsOn ;
    skos:definition "Quelle: gleiches Inhaltskonzept wie Ziel auf höherer Stufe desselben kumulativen Systems oder höherer Taxonomiestufe derselben Liste."@de .
cv:rel_precedes a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "precedes" ; skos:prefLabel "geht didaktisch voraus"@de , "precedes"@en ;
    cur:shortcut cur:precedes .
cv:rel_revisits a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "revisits" ; skos:prefLabel "greift wieder auf"@de , "revisits"@en ;
    cur:shortcut cur:revisits .
cv:rel_supports a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "supports" ; skos:prefLabel "stützt"@de , "supports"@en ;
    cur:shortcut cur:supports .
cv:rel_concretizes a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "concretizes" ; skos:prefLabel "konkretisiert"@de , "concretizes"@en ;
    cur:shortcut cur:concretizes .
cv:rel_correspondsTo a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "correspondsTo" ; skos:prefLabel "entspricht (lernortübergreifend)"@de , "corresponds to"@en ;
    cur:shortcut cur:correspondsTo .
cv:rel_noCorrespondence a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "noCorrespondence" ; skos:prefLabel "ohne Entsprechung (amtlich festgestellt)"@de , "no correspondence"@en ;
    skos:definition "Die amtliche Liste stellt ausdrücklich fest, dass es keine Entsprechung gibt; verhindert falsche Vorschläge."@de .
cv:rel_derivedFrom a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "derivedFrom" ; skos:prefLabel "übernommen aus"@de , "derived from"@en ;
    cur:shortcut cur:derivedFrom .
cv:rel_replaces a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "replaces" ; skos:prefLabel "ersetzt (Fassungswechsel)"@de , "replaces"@en ;
    cur:shortcut cur:replaces .
cv:rel_variantOf a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "variantOf" ; skos:prefLabel "Variante von"@de , "variant of"@en ;
    cur:shortcut cur:variantOf .
cv:rel_crossSubject a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "crossSubject" ; skos:prefLabel "fachübergreifend"@de , "cross-subject"@en ;
    cur:shortcut cur:crossSubject .
cv:rel_contributesTo a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "contributesTo" ; skos:prefLabel "trägt bei zu"@de , "contributes to"@en ;
    cur:shortcut cur:contributesTo ;
    skos:definition "Aussage oder Einheit → Querschnittsziel oder Programmziel, wenn nicht ausdrücklich markiert."@de .
cv:rel_recognizedFor a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "recognizedFor" ; skos:prefLabel "anrechenbar auf"@de , "recognized for"@en ;
    cur:shortcut cur:recognizedFor ;
    skos:definition "Nur Herkunft official."@de .
cv:rel_qualifiesFor a skos:Concept ; skos:inScheme cv:AlignmentRelations ; skos:topConceptOf cv:AlignmentRelations ;
    skos:notation "qualifiesFor" ; skos:prefLabel "berechtigt zu"@de , "qualifies for"@en ;
    cur:shortcut cur:qualifiesFor ;
    skos:definition "Nur Herkunft official."@de .

# -----------------------------------------------------------------------------
# Layout, Segmentierung, Lexikon
# -----------------------------------------------------------------------------
cv:LayoutMarkers a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Layoutsignale"@de , "layout markers"@en .
