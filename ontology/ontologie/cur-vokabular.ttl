cv:seg_tableRow a skos:Concept ; skos:inScheme cv:Segmentations ; skos:topConceptOf cv:Segmentations ;
    skos:notation "tableRow" ; skos:prefLabel "Tabellenzeile"@de , "table row"@en .
cv:seg_tableCell a skos:Concept ; skos:inScheme cv:Segmentations ; skos:topConceptOf cv:Segmentations ;
