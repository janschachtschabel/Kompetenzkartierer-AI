# -----------------------------------------------------------------------------
# Herkunft, Prüfstatus, Methode, Fundart
# -----------------------------------------------------------------------------
cv:Origins a skos:ConceptScheme ;
    skos:prefLabel "Herkunft"@de , "origins"@en ;
    skos:definition "Woher eine Angabe kommt. Zusammen mit dem Prüfstatus ersetzt sie die lineare Kette extrahiert → vorgeschlagen → geprüft → amtlich."@de .
cv:orig_source a skos:Concept ; skos:inScheme cv:Origins ; skos:topConceptOf cv:Origins ;
    skos:notation "source" ; skos:prefLabel "Quelle (steht im Dokument)"@de , "source"@en .
cv:orig_inherited a skos:Concept ; skos:inScheme cv:Origins ; skos:topConceptOf cv:Origins ;
    skos:notation "inherited" ; skos:prefLabel "vererbt"@de , "inherited"@en .
cv:orig_rule a skos:Concept ; skos:inScheme cv:Origins ; skos:topConceptOf cv:Origins ;
    skos:notation "rule" ; skos:prefLabel "Regel (deterministisch)"@de , "rule"@en .
cv:orig_model a skos:Concept ; skos:inScheme cv:Origins ; skos:topConceptOf cv:Origins ;
    skos:notation "model" ; skos:prefLabel "Modell (LLM/Embedding)"@de , "model"@en .
cv:orig_human a skos:Concept ; skos:inScheme cv:Origins ; skos:topConceptOf cv:Origins ;
    skos:notation "human" ; skos:prefLabel "redaktionell"@de , "human"@en .
cv:orig_official a skos:Concept ; skos:inScheme cv:Origins ; skos:topConceptOf cv:Origins ;
    skos:notation "official" ; skos:prefLabel "amtlich"@de , "official"@en ;
    skos:definition "Amtliche Quelle für die Angabe (Entsprechungsliste, Anrechnungsordnung, Kompetenzmatrix); überstimmt maschinelle Vorschläge; braucht eine Fundstelle."@de .

cv:ReviewStatuses a skos:ConceptScheme ;
    skos:prefLabel "Prüfstatus"@de , "review statuses"@en .
cv:rev_proposed a skos:Concept ; skos:inScheme cv:ReviewStatuses ; skos:topConceptOf cv:ReviewStatuses ;
    skos:notation "proposed" ; skos:prefLabel "vorgeschlagen/ungeprüft"@de , "proposed"@en .
cv:rev_confirmed a skos:Concept ; skos:inScheme cv:ReviewStatuses ; skos:topConceptOf cv:ReviewStatuses ;
    skos:notation "confirmed" ; skos:prefLabel "bestätigt"@de , "confirmed"@en .
cv:rev_rejected a skos:Concept ; skos:inScheme cv:ReviewStatuses ; skos:topConceptOf cv:ReviewStatuses ;
    skos:notation "rejected" ; skos:prefLabel "verworfen"@de , "rejected"@en ;
    skos:definition "Bleibt gespeichert, damit derselbe Vorschlag nicht erneut erzeugt wird."@de .

cv:Methods a skos:ConceptScheme ;
    skos:prefLabel "Methoden"@de , "methods"@en .
cv:meth_verbatim a skos:Concept ; skos:inScheme cv:Methods ; skos:topConceptOf cv:Methods ;
    skos:notation "verbatim" ; skos:prefLabel "Wortlaut/Marker im Text"@de , "verbatim"@en .
cv:meth_pattern a skos:Concept ; skos:inScheme cv:Methods ; skos:topConceptOf cv:Methods ;
    skos:notation "pattern" ; skos:prefLabel "Muster/Lexikon"@de , "pattern"@en .
cv:meth_table a skos:Concept ; skos:inScheme cv:Methods ; skos:topConceptOf cv:Methods ;
    skos:notation "table" ; skos:prefLabel "Tabellenlesung"@de , "table reading"@en .
cv:meth_lookup a skos:Concept ; skos:inScheme cv:Methods ; skos:topConceptOf cv:Methods ;
    skos:notation "lookup" ; skos:prefLabel "Nachschlagen in Liste"@de , "lookup"@en ;
    skos:example "Operatorenliste, Berufe-/Qualifikationsliste, Code-Abgleich" .
cv:meth_inheritance a skos:Concept ; skos:inScheme cv:Methods ; skos:topConceptOf cv:Methods ;
    skos:notation "inheritance" ; skos:prefLabel "Vererbung"@de , "inheritance"@en .
cv:meth_reconciliation a skos:Concept ; skos:inScheme cv:Methods ; skos:topConceptOf cv:Methods ;
    skos:notation "reconciliation" ; skos:prefLabel "Reconciliation-Dienst"@de , "reconciliation"@en ;
    skos:example "Wikidata, lobid-gnd" .
cv:meth_embedding a skos:Concept ; skos:inScheme cv:Methods ; skos:topConceptOf cv:Methods ;
    skos:notation "embedding" ; skos:prefLabel "Embedding-Ähnlichkeit"@de , "embedding"@en .
cv:meth_llmChoice a skos:Concept ; skos:inScheme cv:Methods ; skos:topConceptOf cv:Methods ;
    skos:notation "llmChoice" ; skos:prefLabel "LLM-Auswahl aus nummerierten Kandidaten"@de , "LLM choice"@en ;
    skos:definition "Das LLM wählt unter höchstens etwa 40 nummerierten Kandidaten und antwortet nur mit Nummern."@de .
cv:meth_llmJudgement a skos:Concept ; skos:inScheme cv:Methods ; skos:topConceptOf cv:Methods ;
    skos:notation "llmJudgement" ; skos:prefLabel "LLM-Urteil über Relation"@de , "LLM judgement"@en .
cv:meth_manual a skos:Concept ; skos:inScheme cv:Methods ; skos:topConceptOf cv:Methods ;
    skos:notation "manual" ; skos:prefLabel "manuell"@de , "manual"@en .
cv:meth_officialList a skos:Concept ; skos:inScheme cv:Methods ; skos:topConceptOf cv:Methods ;
    skos:notation "officialList" ; skos:prefLabel "amtliche Liste"@de , "official list"@en .

cv:MatchKinds a skos:ConceptScheme ;
    skos:prefLabel "Fundart"@de , "match kinds"@en .
cv:match_exact a skos:Concept ; skos:inScheme cv:MatchKinds ; skos:topConceptOf cv:MatchKinds ;
    skos:notation "exact" ; skos:prefLabel "exakt"@de , "exact"@en .
cv:match_whitespace a skos:Concept ; skos:inScheme cv:MatchKinds ; skos:topConceptOf cv:MatchKinds ;
