cv:match_normalized a skos:Concept ; skos:inScheme cv:MatchKinds ; skos:topConceptOf cv:MatchKinds ;
    skos:notation "normalized" ; skos:prefLabel "normalisiert (Trennstriche, Anführungszeichen)"@de , "normalized"@en .
cv:match_fuzzy a skos:Concept ; skos:inScheme cv:MatchKinds ; skos:topConceptOf cv:MatchKinds ;
    skos:notation "fuzzy" ; skos:prefLabel "unscharf (kein Wortlautbeleg)"@de , "fuzzy"@en .
cv:match_notFound a skos:Concept ; skos:inScheme cv:MatchKinds ; skos:topConceptOf cv:MatchKinds ;
    skos:notation "notFound" ; skos:prefLabel "nicht gefunden"@de , "not found"@en .

cv:ResolutionStatuses a skos:ConceptScheme ;
    skos:prefLabel "Auflösungsstatus von Verweisen"@de , "resolution statuses"@en .
cv:res_open a skos:Concept ; skos:inScheme cv:ResolutionStatuses ; skos:topConceptOf cv:ResolutionStatuses ;
    skos:notation "open" ; skos:prefLabel "offen"@de , "open"@en .
cv:res_resolved a skos:Concept ; skos:inScheme cv:ResolutionStatuses ; skos:topConceptOf cv:ResolutionStatuses ;
    skos:notation "resolved" ; skos:prefLabel "aufgelöst"@de , "resolved"@en .
cv:res_ambiguous a skos:Concept ; skos:inScheme cv:ResolutionStatuses ; skos:topConceptOf cv:ResolutionStatuses ;
    skos:notation "ambiguous" ; skos:prefLabel "mehrdeutig"@de , "ambiguous"@en .
cv:res_notFound a skos:Concept ; skos:inScheme cv:ResolutionStatuses ; skos:topConceptOf cv:ResolutionStatuses ;
    skos:notation "notFound" ; skos:prefLabel "Ziel nicht gefunden"@de , "not found"@en .

cv:ConflictCriteria a skos:ConceptScheme ;
    skos:prefLabel "Kriterien der Konfliktauflösung (in dieser Reihenfolge)"@de , "conflict criteria"@en .
cv:cc_cohort a skos:Concept ; skos:inScheme cv:ConflictCriteria ; skos:topConceptOf cv:ConflictCriteria ;
    skos:notation "cohort" ; skos:prefLabel "Gültigkeit für die Kohorte"@de , "cohort validity"@en .
cv:cc_binding a skos:Concept ; skos:inScheme cv:ConflictCriteria ; skos:topConceptOf cv:ConflictCriteria ;
