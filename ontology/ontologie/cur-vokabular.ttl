cv:Segmentations a skos:ConceptScheme ;
    skos:prefLabel "Segmentierungsregeln"@de , "segmentation rules"@en ;
    skos:definition "Was ein Element ist. Gemessen in der App: „jeder Satz ein Element“ hob Qualifikationsziele 5 → 19, „nummerierte Tabellenzeile = Einheit“ 1 → 50–71, „jede Niveauzelle“ 59/74 → 91/85 %."@de .
cv:seg_sentence a skos:Concept ; skos:inScheme cv:Segmentations ; skos:topConceptOf cv:Segmentations ;
    skos:notation "sentence" ; skos:prefLabel "Satz"@de , "sentence"@en .
