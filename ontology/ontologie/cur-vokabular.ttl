@prefix cur:   <https://w3id.org/wlo/curriculum/core#> .
@prefix cv:    <https://w3id.org/wlo/curriculum/vocab#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .

# =============================================================================
# Kern-Wertelisten (cv:) – geschlossene SKOS-Vokabulare des Curriculum-Kerns
#
# Benennung: cv:<kürzel>_<wert>; skos:notation ist der Wert, den das LLM im
# JSON-Schema ausgibt. Schemata mit cur:llmEnum true haben höchstens zehn
# Werte und erscheinen als Enum in den Extraktionsschemata. Profile hängen
# feinere Werte per skos:broader unter einen Kernwert (z. B. elem:Impuls →
# cv:kind_guidance), statt die Kernlisten zu erweitern.
# =============================================================================

<https://w3id.org/wlo/curriculum/vocab> a owl:Ontology ;
    dct:title "Curriculum-Kern: Wertelisten"@de , "Curriculum Core: controlled vocabularies"@en ;
    owl:imports <https://w3id.org/wlo/curriculum/core> ;
    owl:versionInfo "1.0-entwurf" ;
    dct:created "2026-10-19"^^xsd:date .

# -----------------------------------------------------------------------------
# Andockpunkte (8)
# -----------------------------------------------------------------------------
cv:DockingPoints a skos:ConceptScheme ;
    skos:prefLabel "Andockpunkte"@de , "docking points"@en ;
    skos:definition "Die acht Fragen, über die Curricula untereinander und mit Kompetenzrahmen, Normdaten und Lernressourcen verbunden werden. Jeder Andockpunkt hat eine Wortlaut- und eine Norm-Eigenschaft, einen Hub und eine Vererbungsregel. Fehlt eine Angabe im Dokument, wird sie mit cur:checkedAbsent markiert, nie geraten."@de .

cv:dock_content a skos:Concept ; skos:inScheme cv:DockingPoints ; skos:topConceptOf cv:DockingPoints ;
    skos:notation "content" ; skos:prefLabel "Inhalt und Thema"@de , "content and topic"@en ;
    cur:question "Worum geht es – welches Thema, welcher Gegenstand?"@de ;
    cur:verbatimProperty cur:objectText , cur:originalTitle ; cur:normProperty cur:mentions ; cur:hubClass cur:ContentConcept ;
    cur:targetVocabulary "Wikidata, GND (über Reconciliation); WLO-/OEH-Themenbaum und Profil-Themenschemata als broadMatch"@de ;
    skos:scopeNote "Ein Hub, zwei Andockstellen: das Thema einer Gliederungseinheit (aus dem Titel, z. B. Inhaltsfeld „Elektrizität“) und der Gegenstand einer Aussage oder Zerlegung („Ohmsches Gesetz“). Begriffe hängen per skos:broader an Themen (cur:granularity); die Themensuche läuft über skos:broader*."@de ;
    cur:filledInStage cv:stage_N1 .
cv:dock_competency a skos:Concept ; skos:inScheme cv:DockingPoints ; skos:topConceptOf cv:DockingPoints ;
    skos:notation "competency" ; skos:prefLabel "Kompetenz"@de , "competency"@en ;
    cur:question "Was soll jemand damit tun können?"@de ;
    cur:verbatimProperty cur:actionText ; cur:normProperty cur:expresses ; cur:hubClass cur:CompetencyConcept ;
    cur:targetVocabulary "ESCO (Beruf, Hochschule, Erwachsenenbildung), DigComp, GER, KMK-Bildungsstandards, Kompetenzraster; Dimension über das Brückenschema kd:Bridge"@de ;
    cur:filledInStage cv:stage_N1 .
cv:dock_level a skos:Concept ; skos:inScheme cv:DockingPoints ; skos:topConceptOf cv:DockingPoints ;
    skos:notation "level" ; skos:prefLabel "Niveau"@de , "level"@en ;
    cur:question "Wie anspruchsvoll, auf welcher Stufe?"@de ;
    cur:verbatimProperty cur:levelText ; cur:normProperty cur:levelAssignment ; cur:hubClass cur:LevelConcept ;
    cur:inheritedVia cur:partOf ;
    cur:targetVocabulary "EQR/DQR, ISCED 2011 / KIM-Bildungsstufe, GER, Alpha-Level, Niveaustufen A–H, Erwartungs- und Kursniveaus, AFB (nur Aufgaben), Taxonomie (nur heuristisch)"@de ;
    cur:filledInStage cv:stage_X1 , cv:stage_X4 , cv:stage_N1 .
cv:dock_field a skos:Concept ; skos:inScheme cv:DockingPoints ; skos:topConceptOf cv:DockingPoints ;
    skos:notation "field" ; skos:prefLabel "Fach/Feld"@de , "field"@en ;
    cur:question "In welchem Fach, Beruf, Studien- oder Bildungsbereich?"@de ;
    cur:verbatimProperty cur:fieldText ; cur:normProperty cur:field ; cur:hubClass skos:Concept ;
    cur:inheritedVia cur:partOf ;
    cur:targetVocabulary "Fach-Hub fld: (ISCED-F 2013), KIM-Schulfächer, Beruf (KldB/ESCO), Elementar-Bildungsbereiche, EB-Programmbereiche"@de ;
    cur:filledInStage cv:stage_X1 .
cv:dock_time a skos:Concept ; skos:inScheme cv:DockingPoints ; skos:topConceptOf cv:DockingPoints ;
    skos:notation "time" ; skos:prefLabel "Zeit und Geltung"@de , "time and validity"@en ;
    cur:question "Wann, wie lange, wo, wie verbindlich?"@de ;
    cur:verbatimProperty cur:timeText ; cur:normProperty cur:timeSpan , cur:workload , cur:obligation , cur:region ;
    cur:hubClass cur:TimeSpan ; cur:inheritedVia cur:partOf ;
    cur:targetVocabulary "Alter, Jahrgangsstufe, Ausbildungsjahr, Semester; Stunden, UE, Wochen, ECTS; Verbindlichkeit; Land"@de ;
    cur:filledInStage cv:stage_X1 , cv:stage_X4 .
cv:dock_crossCutting a skos:Concept ; skos:inScheme cv:DockingPoints ; skos:topConceptOf cv:DockingPoints ;
    skos:notation "crossCutting" ; skos:prefLabel "Querschnitt"@de , "cross-cutting"@en ;
    cur:question "Welches überfachliche Ziel bedient das?"@de ;
    cur:verbatimProperty cur:crossCuttingMarker ; cur:normProperty cur:contributesTo ; cur:hubClass cur:CrossCuttingObjective ;
    cur:targetVocabulary "qz: (Leitperspektiven, KMK Digitale Welt, BNE, Standardberufsbildpositionen, EU-Schlüsselkompetenzen, Prinzipien)"@de ;
    cur:filledInStage cv:stage_X4 , cv:stage_N1 .
cv:dock_context a skos:Concept ; skos:inScheme cv:DockingPoints ; skos:topConceptOf cv:DockingPoints ;
    skos:notation "context" ; skos:prefLabel "Kontext"@de , "context"@en ;
    cur:question "In welcher Situation, an welchem Lernort, in welcher Rolle?"@de ;
    cur:verbatimProperty cur:contextText ; cur:normProperty cur:context ; cur:hubClass cur:ContextConcept ;
    cur:inheritedVia cur:partOf ;
    cur:targetVocabulary "ctx: (Alltagssituationen, Lebens- und Handlungsbereiche, Lernorte, Rollen, Berufsfelder)"@de ;
    cur:filledInStage cv:stage_X1 , cv:stage_X4 .
cv:dock_addressee a skos:Concept ; skos:inScheme cv:DockingPoints ; skos:topConceptOf cv:DockingPoints ;
    skos:notation "addressee" ; skos:prefLabel "Adressat"@de , "addressee"@en ;
    cur:question "Wer soll das tun oder können?"@de ;
    cur:normProperty cur:addressee ; cur:hubClass skos:Concept ;
    cur:targetVocabulary "cv:Addressees; Filter: nur Lernende docken an Kompetenzkonzepte und an AMB teaches"@de ;
    cur:filledInStage cv:stage_X4 .

# -----------------------------------------------------------------------------
# Funktionen von Gliederungseinheiten (7) – LLM-Enum
# -----------------------------------------------------------------------------
cv:NodeFunctions a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Funktionen von Gliederungseinheiten"@de , "node functions"@en .
cv:fn_grouping a skos:Concept ; skos:inScheme cv:NodeFunctions ; skos:topConceptOf cv:NodeFunctions ;
    skos:notation "grouping" ; skos:prefLabel "Gliederungsabschnitt"@de , "grouping"@en ;
    skos:definition "Ordnet nach Organisation statt nach Gegenstand: Teil, Kapitel, Jahrgangs- oder Doppeljahrgangsstufe, Phase, Studienabschnitt, Abschnitt A/B des Ausbildungsrahmenplans. Trägt oft Kontext (Zeit, Niveau, Geltung), selten eigene Aussagen."@de .
cv:fn_area a skos:Concept ; skos:inScheme cv:NodeFunctions ; skos:topConceptOf cv:NodeFunctions ;
    skos:notation "area" ; skos:prefLabel "Bereich"@de , "area"@en ;
    skos:definition "Thematischer oder Kompetenzbereich ohne eigenen Zeitumfang: Kompetenzbereich, Inhaltsfeld (NW, HE), Leitidee, Bildungsbereich (Kita), Modulgruppe, Handlungsfeld (Integrationskurs), Kompetenzschwerpunkt (ST)."@de .
cv:fn_unit a skos:Concept ; skos:inScheme cv:NodeFunctions ; skos:topConceptOf cv:NodeFunctions ;
    skos:notation "unit" ; skos:prefLabel "Einheit"@de , "unit"@en ;
    skos:definition "Abgeschlossene Lerneinheit mit Zeit- und/oder Niveaubezug: Lernfeld, Berufsbildposition, Modul, curriculare Einheit (Pflege), Themenfeld (BE/BB), Lernbereich mit Stunden (SN), Kursabschnitt."@de .
cv:fn_subunit a skos:Concept ; skos:inScheme cv:NodeFunctions ; skos:topConceptOf cv:NodeFunctions ;
    skos:notation "subunit" ; skos:prefLabel "Teileinheit"@de , "subunit"@en ;
    skos:definition "Unterteilung einer Einheit: Schwerpunkt, Teilmodul, Lehrveranstaltung, inhaltlicher Schwerpunkt (NW), Teilbereich, sprachliche Handlung."@de .
cv:fn_crossCutting a skos:Concept ; skos:inScheme cv:NodeFunctions ; skos:topConceptOf cv:NodeFunctions ;
    skos:notation "crossCutting" ; skos:prefLabel "Querschnittsteil"@de , "cross-cutting part"@en ;
    skos:definition "Abschnitt, der überfachliche Ziele entfaltet: Leitperspektiven, Basiskompetenzen, übergreifende Themen, Basiscurricula, Leitprinzipien, Standardberufsbildpositionen als Block."@de .
cv:fn_frame a skos:Concept ; skos:inScheme cv:NodeFunctions ; skos:topConceptOf cv:NodeFunctions ;
    skos:notation "frame" ; skos:prefLabel "Rahmenteil"@de , "frame part"@en ;
    skos:definition "Curricular relevanter Rahmen ohne Fachgliederung: Allgemeiner Teil, Grundsatzband, Bildungsauftrag, Bild vom Kind, didaktische Grundsätze, Kompetenzmodell, Operatorenliste, Prüfungs-§§. Liefert Bildungsziele, Aufträge, Regeln, Legenden. Hängt am Dokument, wenn er für mehrere Curricula gilt."@de .
cv:fn_nonCurricular a skos:Concept ; skos:inScheme cv:NodeFunctions ; skos:topConceptOf cv:NodeFunctions ;
    skos:notation "nonCurricular" ; skos:prefLabel "nicht curricular"@de , "non-curricular"@en ;
    skos:definition "Vorwort, Inhaltsverzeichnis, Impressum, Glossar, Literatur, Anhang ohne Vorgaben. Wird nicht nach Aussagen gefragt."@de .

# -----------------------------------------------------------------------------
# Extraktionstiefe (3)
# -----------------------------------------------------------------------------
cv:ExtractionDepths a skos:ConceptScheme ;
    skos:prefLabel "Extraktionstiefe"@de , "extraction depth"@en .
cv:depth_full a skos:Concept ; skos:inScheme cv:ExtractionDepths ; skos:topConceptOf cv:ExtractionDepths ;
    skos:notation "full" ; skos:prefLabel "vollständig"@de , "full"@en ;
    skos:definition "Alle Aussagen im Wortlaut extrahieren."@de .
cv:depth_typed a skos:Concept ; skos:inScheme cv:ExtractionDepths ; skos:topConceptOf cv:ExtractionDepths ;
    skos:notation "typed" ; skos:prefLabel "nur typisiert"@de , "typed"@en ;
    skos:definition "Nur Knoten mit Titel, Typ und Seitenbereich; Aussagen nur, wenn sie Ziele, Regeln oder Legenden sind."@de .
cv:depth_skip a skos:Concept ; skos:inScheme cv:ExtractionDepths ; skos:topConceptOf cv:ExtractionDepths ;
    skos:notation "skip" ; skos:prefLabel "überspringen"@de , "skip"@en .

# -----------------------------------------------------------------------------
# Aussagearten (7) – LLM-Enum
# -----------------------------------------------------------------------------
cv:StatementKinds a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Aussagearten"@de , "statement kinds"@en .
cv:kind_learningOutcome a skos:Concept ; skos:inScheme cv:StatementKinds ; skos:topConceptOf cv:StatementKinds ;
    skos:notation "learningOutcome" ; skos:prefLabel "Lernergebnis"@de , "learning outcome"@en ;
    skos:definition "Was Lernende wissen, verstehen oder können sollen; prüf- oder beobachtbar (meist mit Operator)."@de .
cv:kind_developmentGoal a skos:Concept ; skos:inScheme cv:StatementKinds ; skos:topConceptOf cv:StatementKinds ;
    skos:notation "developmentGoal" ; skos:prefLabel "Bildungs-/Entwicklungsziel"@de , "development goal"@en ;
    skos:definition "Haltung, Wert, Disposition, Erfahrung oder Bildungsanspruch ohne Prüfanspruch."@de .
cv:kind_content a skos:Concept ; skos:inScheme cv:StatementKinds ; skos:topConceptOf cv:StatementKinds ;
    skos:notation "content" ; skos:prefLabel "Inhalt"@de , "content"@en ;
    skos:definition "Gegenstand ohne Handlungsanforderung."@de .
cv:kind_standard a skos:Concept ; skos:inScheme cv:StatementKinds ; skos:topConceptOf cv:StatementKinds ;
    skos:notation "standard" ; skos:prefLabel "Standard/Kriterium"@de , "standard"@en ;
    skos:definition "Maßstab, an dem Erreichtes oder Handeln gemessen wird (Regelstandard, Raster-Deskriptor, Bewertungskriterium, Qualitätsanspruch)."@de ;
    skos:scopeNote "Schulpläne nennen Lernergebnisse oft „Standard“ (BE/BB, HB, MV). Maßgeblich ist die Funktion, nicht das Wort: eine Kompetenzerwartung eines Landeslehrplans ist learningOutcome; ein KMK-Regelstandard oder eine Rasterzelle ist standard."@de .
cv:kind_mandate a skos:Concept ; skos:inScheme cv:StatementKinds ; skos:topConceptOf cv:StatementKinds ;
    skos:notation "mandate" ; skos:prefLabel "Auftrag"@de , "mandate"@en ;
    skos:definition "Normative Aufgabe für Lehrende, Fachkräfte, Einrichtung oder Träger."@de .
cv:kind_guidance a skos:Concept ; skos:inScheme cv:StatementKinds ; skos:topConceptOf cv:StatementKinds ;
    skos:notation "guidance" ; skos:prefLabel "Hinweis"@de , "guidance"@en ;
    skos:definition "Nicht normativ: Anregung, Impuls, Beispiel, Reflexionsfrage, didaktischer oder methodischer Hinweis."@de .
cv:kind_reference a skos:Concept ; skos:inScheme cv:StatementKinds ; skos:topConceptOf cv:StatementKinds ;
    skos:notation "reference" ; skos:prefLabel "Verweis"@de , "reference"@en ;
    skos:definition "Verweis auf andere Stelle, anderes Fach, Dokument oder Modul."@de .
cv:kind_unclassified a skos:Concept ; skos:inScheme cv:StatementKinds ; skos:topConceptOf cv:StatementKinds ;
    skos:notation "unclassified" ; skos:prefLabel "unklar"@de , "unclassified"@en ;
    skos:definition "Art nicht sicher bestimmbar (Grenzfall Lernergebnis/Bildungsziel, „Kinder lernen …“). Besser als eine erzwungene Art; geht in die Prüfliste."@de .

# -----------------------------------------------------------------------------
# Adressaten (6) – LLM-Enum
# -----------------------------------------------------------------------------
cv:Addressees a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Adressaten"@de , "addressees"@en .
cv:addr_learner a skos:Concept ; skos:inScheme cv:Addressees ; skos:topConceptOf cv:Addressees ;
    skos:notation "learner" ; skos:prefLabel "Lernende"@de , "learner"@en ;
    skos:definition "Kinder, Schülerinnen und Schüler, Auszubildende, Studierende, Teilnehmende."@de .
cv:addr_educator a skos:Concept ; skos:inScheme cv:Addressees ; skos:topConceptOf cv:Addressees ;
    skos:notation "educator" ; skos:prefLabel "Lehrende/Fachkräfte"@de , "educator"@en ;
    skos:definition "Pädagogische Fachkräfte, Lehrkräfte, Ausbildende, Lehrende, Kursleitende, Tagespflegepersonen."@de .
cv:addr_institution a skos:Concept ; skos:inScheme cv:Addressees ; skos:topConceptOf cv:Addressees ;
    skos:notation "institution" ; skos:prefLabel "Einrichtung/Träger"@de , "institution"@en ;
    skos:definition "Einrichtung, Schule, Betrieb, Hochschule, Träger, Leitung als Organisation."@de .
cv:addr_family a skos:Concept ; skos:inScheme cv:Addressees ; skos:topConceptOf cv:Addressees ;
    skos:notation "family" ; skos:prefLabel "Familie"@de , "family"@en .
cv:addr_partner a skos:Concept ; skos:inScheme cv:Addressees ; skos:topConceptOf cv:Addressees ;
    skos:notation "partner" ; skos:prefLabel "Kooperationspartner"@de , "partner"@en ;
    skos:definition "Andere Lernorte und Partner (Schule für die Kita, Betrieb für die Berufsschule, Praxispartner)."@de .
cv:addr_other a skos:Concept ; skos:inScheme cv:Addressees ; skos:topConceptOf cv:Addressees ;
    skos:notation "other" ; skos:prefLabel "andere"@de , "other"@en .

# -----------------------------------------------------------------------------
# Verbindlichkeit je Element (8) – LLM-Enum
# -----------------------------------------------------------------------------
cv:Obligations a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Verbindlichkeit"@de , "obligation"@en ;
    skos:definition "Verbindlichkeit je Einheit, Aussage oder Verwendung. Getrennt von der rechtlichen Bindung des Dokuments (cv:DocumentBindings)."@de .
cv:obl_binding a skos:Concept ; skos:inScheme cv:Obligations ; skos:topConceptOf cv:Obligations ;
    skos:notation "binding" ; skos:prefLabel "verbindlich"@de , "binding"@en ;
    skos:altLabel "Pflicht"@de .
cv:obl_electiveRequired a skos:Concept ; skos:inScheme cv:Obligations ; skos:topConceptOf cv:Obligations ;
    skos:notation "electiveRequired" ; skos:prefLabel "Wahlpflicht"@de , "elective required"@en ;
    skos:altLabel "wahlobligatorisch"@de .
cv:obl_elective a skos:Concept ; skos:inScheme cv:Obligations ; skos:topConceptOf cv:Obligations ;
    skos:notation "elective" ; skos:prefLabel "Wahl"@de , "elective"@en ;
    skos:altLabel "fakultativ"@de , "optional"@de .
cv:obl_selectionPool a skos:Concept ; skos:inScheme cv:Obligations ; skos:topConceptOf cv:Obligations ;
    skos:notation "selectionPool" ; skos:prefLabel "Auswahlpool"@de , "selection pool"@en ;
    skos:definition "Höchstmenge möglicher Ziele, aus der ausgewählt wird; nicht jedes muss erreicht werden (z. B. Rahmencurriculum Integrationskurse)."@de .
cv:obl_exemplary a skos:Concept ; skos:inScheme cv:Obligations ; skos:topConceptOf cv:Obligations ;
    skos:notation "exemplary" ; skos:prefLabel "beispielhaft"@de , "exemplary"@en ;
    skos:altLabel "exemplarisch"@de , "mögliche Inhalte"@de , "z. B."@de .
cv:obl_recommended a skos:Concept ; skos:inScheme cv:Obligations ; skos:topConceptOf cv:Obligations ;
    skos:notation "recommended" ; skos:prefLabel "empfohlen"@de , "recommended"@en .
cv:obl_informative a skos:Concept ; skos:inScheme cv:Obligations ; skos:topConceptOf cv:Obligations ;
    skos:notation "informative" ; skos:prefLabel "informativ/orientierend"@de , "informative"@en .
cv:obl_unknown a skos:Concept ; skos:inScheme cv:Obligations ; skos:topConceptOf cv:Obligations ;
    skos:notation "unknown" ; skos:prefLabel "unbestimmt"@de , "unknown"@en .

# -----------------------------------------------------------------------------
# Dokument: Bindung, Rechtsform, Lebenszyklus, Dokumentart, Bildungsbereich
# -----------------------------------------------------------------------------
cv:DocumentBindings a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "rechtliche Bindung des Dokuments"@de , "document binding"@en .
cv:bind_binding a skos:Concept ; skos:inScheme cv:DocumentBindings ; skos:topConceptOf cv:DocumentBindings ;
    skos:notation "binding" ; skos:prefLabel "verbindlich"@de , "binding"@en .
cv:bind_partial a skos:Concept ; skos:inScheme cv:DocumentBindings ; skos:topConceptOf cv:DocumentBindings ;
    skos:notation "partial" ; skos:prefLabel "teilweise verbindlich"@de , "partially binding"@en ;
    skos:altLabel "hybrid"@de .
cv:bind_orienting a skos:Concept ; skos:inScheme cv:DocumentBindings ; skos:topConceptOf cv:DocumentBindings ;
    skos:notation "orienting" ; skos:prefLabel "orientierend"@de , "orienting"@en ;
    skos:altLabel "Orientierungsrahmen"@de .
cv:bind_recommending a skos:Concept ; skos:inScheme cv:DocumentBindings ; skos:topConceptOf cv:DocumentBindings ;
    skos:notation "recommending" ; skos:prefLabel "empfehlend"@de , "recommending"@en .
cv:bind_informative a skos:Concept ; skos:inScheme cv:DocumentBindings ; skos:topConceptOf cv:DocumentBindings ;
    skos:notation "informative" ; skos:prefLabel "informativ (Begleit- oder Lesefassung)"@de , "informative"@en ;
    skos:definition "Offizielles Begleitdokument oder nicht amtliche Lesefassung: Inhalt stammt aus verbindlichen Ordnungen, das Dokument selbst bindet nicht („Lesefassung“, „Es gilt die jeweils gültige Prüfungsordnung“)."@de .
cv:bind_none a skos:Concept ; skos:inScheme cv:DocumentBindings ; skos:topConceptOf cv:DocumentBindings ;
    skos:notation "none" ; skos:prefLabel "ohne Bindung (beschreibend, Nachweis)"@de , "none"@en ;
    skos:example "Studiengangsflyer, Website, Diploma Supplement, Akkreditierungsbericht" .
cv:bind_unknown a skos:Concept ; skos:inScheme cv:DocumentBindings ; skos:topConceptOf cv:DocumentBindings ;
    skos:notation "unknown" ; skos:prefLabel "unbekannt"@de , "unknown"@en .

cv:LegalForms a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Rechtsform"@de , "legal form"@en .
cv:lf_law a skos:Concept ; skos:inScheme cv:LegalForms ; skos:topConceptOf cv:LegalForms ;
    skos:notation "law" ; skos:prefLabel "Gesetz"@de , "law"@en .
cv:lf_ordinance a skos:Concept ; skos:inScheme cv:LegalForms ; skos:topConceptOf cv:LegalForms ;
    skos:notation "ordinance" ; skos:prefLabel "Verordnung"@de , "ordinance"@en ;
    skos:example "Ausbildungsordnung (BGBl.), PflAPrV, AVBayKiBiG" .
cv:lf_administrativeRegulation a skos:Concept ; skos:inScheme cv:LegalForms ; skos:topConceptOf cv:LegalForms ;
    skos:notation "administrativeRegulation" ; skos:prefLabel "Verwaltungsvorschrift/Erlass"@de , "administrative regulation"@en ;
    skos:example "Inkraftsetzung eines Lehrplans per Erlass" .
cv:lf_resolution a skos:Concept ; skos:inScheme cv:LegalForms ; skos:topConceptOf cv:LegalForms ;
    skos:notation "resolution" ; skos:prefLabel "Beschluss (KMK, JFMK)"@de , "resolution"@en ;
    skos:example "KMK-Rahmenlehrplan, Bildungsstandards, Gemeinsamer Rahmen der Länder" .
cv:lf_statute a skos:Concept ; skos:inScheme cv:LegalForms ; skos:topConceptOf cv:LegalForms ;
    skos:notation "statute" ; skos:prefLabel "Satzung"@de , "statute"@en ;
    skos:example "Studien- und Prüfungsordnung, Kammer-Fortbildungsprüfungsregelung" .
cv:lf_officialRecommendation a skos:Concept ; skos:inScheme cv:LegalForms ; skos:topConceptOf cv:LegalForms ;
    skos:notation "officialRecommendation" ; skos:prefLabel "amtliche Empfehlung/Handreichung"@de , "official recommendation"@en .
cv:lf_providerDocument a skos:Concept ; skos:inScheme cv:LegalForms ; skos:topConceptOf cv:LegalForms ;
    skos:notation "providerDocument" ; skos:prefLabel "Dokument eines Trägers oder Verbands"@de , "provider document"@en ;
    skos:example "DVV-Rahmencurriculum, Kurskonzept" .
cv:lf_institutionalDocument a skos:Concept ; skos:inScheme cv:LegalForms ; skos:topConceptOf cv:LegalForms ;
    skos:notation "institutionalDocument" ; skos:prefLabel "einrichtungsinternes Dokument"@de , "institutional document"@en ;
    skos:example "schulinternes Curriculum, Kita-Konzeption, Modulhandbuch ohne Satzungsrang" .
cv:lf_unknown a skos:Concept ; skos:inScheme cv:LegalForms ; skos:topConceptOf cv:LegalForms ;
    skos:notation "unknown" ; skos:prefLabel "unbekannt"@de , "unknown"@en .

cv:Lifecycles a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Lebenszyklus"@de , "lifecycle"@en .
cv:life_draft a skos:Concept ; skos:inScheme cv:Lifecycles ; skos:topConceptOf cv:Lifecycles ;
    skos:notation "draft" ; skos:prefLabel "Entwurf"@de , "draft"@en .
cv:life_consultation a skos:Concept ; skos:inScheme cv:Lifecycles ; skos:topConceptOf cv:Lifecycles ;
    skos:notation "consultation" ; skos:prefLabel "Anhörungsfassung"@de , "consultation version"@en .
cv:life_adopted a skos:Concept ; skos:inScheme cv:Lifecycles ; skos:topConceptOf cv:Lifecycles ;
    skos:notation "adopted" ; skos:prefLabel "beschlossen"@de , "adopted"@en .
cv:life_inForce a skos:Concept ; skos:inScheme cv:Lifecycles ; skos:topConceptOf cv:Lifecycles ;
    skos:notation "inForce" ; skos:prefLabel "in Kraft"@de , "in force"@en .
cv:life_futureInForce a skos:Concept ; skos:inScheme cv:Lifecycles ; skos:topConceptOf cv:Lifecycles ;
    skos:notation "futureInForce" ; skos:prefLabel "künftig in Kraft"@de , "future in force"@en .
cv:life_superseded a skos:Concept ; skos:inScheme cv:Lifecycles ; skos:topConceptOf cv:Lifecycles ;
    skos:notation "superseded" ; skos:prefLabel "ersetzt/ausgelaufen"@de , "superseded"@en .
cv:life_withdrawn a skos:Concept ; skos:inScheme cv:Lifecycles ; skos:topConceptOf cv:Lifecycles ;
    skos:notation "withdrawn" ; skos:prefLabel "zurückgezogen"@de , "withdrawn"@en .
cv:life_unknown a skos:Concept ; skos:inScheme cv:Lifecycles ; skos:topConceptOf cv:Lifecycles ;
    skos:notation "unknown" ; skos:prefLabel "unbekannt"@de , "unknown"@en .

cv:DocumentKinds a skos:ConceptScheme ;
    skos:prefLabel "Dokumentarten (Kern)"@de , "document kinds"@en ;
    skos:definition "Grobe Kernarten; die Profile hängen ihre Dokumenttypen per skos:broader darunter."@de .
cv:dk_curriculum a skos:Concept ; skos:inScheme cv:DocumentKinds ; skos:topConceptOf cv:DocumentKinds ;
    skos:notation "curriculum" ; skos:prefLabel "Lehr- oder Bildungsplan"@de , "curriculum document"@en .
cv:dk_regulation a skos:Concept ; skos:inScheme cv:DocumentKinds ; skos:topConceptOf cv:DocumentKinds ;
    skos:notation "regulation" ; skos:prefLabel "Ordnung"@de , "regulation"@en ;
    skos:definition "Ausbildungs-, Fortbildungs-, Studien- und Prüfungsordnung, Prüfungsverordnung."@de .
cv:dk_catalogue a skos:Concept ; skos:inScheme cv:DocumentKinds ; skos:topConceptOf cv:DocumentKinds ;
    skos:notation "catalogue" ; skos:prefLabel "Katalog/Beschreibung"@de , "catalogue"@en ;
    skos:definition "Modulhandbuch, Lernzielkatalog, Kurskonzept, Studienverlaufsplan, Programmbeschreibung."@de .
cv:dk_framework a skos:Concept ; skos:inScheme cv:DocumentKinds ; skos:topConceptOf cv:DocumentKinds ;
    skos:notation "framework" ; skos:prefLabel "Rahmen/Standard"@de , "framework"@en ;
    skos:definition "Bildungsstandards, Kompetenzrahmen, Referenzrahmen, länderübergreifender Rahmen."@de .
cv:dk_guidance a skos:Concept ; skos:inScheme cv:DocumentKinds ; skos:topConceptOf cv:DocumentKinds ;
    skos:notation "guidance" ; skos:prefLabel "Handreichung/Umsetzungshilfe"@de , "guidance document"@en .
cv:dk_correspondence a skos:Concept ; skos:inScheme cv:DocumentKinds ; skos:topConceptOf cv:DocumentKinds ;
    skos:notation "correspondence" ; skos:prefLabel "Entsprechungs- oder Zuordnungsliste"@de , "correspondence list"@en ;
    skos:definition "Amtliche Kantenquelle (Entsprechungsliste AO↔RLP, Kompetenzmatrix, Anrechnungs- oder Äquivalenzliste); wird regelbasiert gelesen."@de .
cv:dk_assessment a skos:Concept ; skos:inScheme cv:DocumentKinds ; skos:topConceptOf cv:DocumentKinds ;
    skos:notation "assessment" ; skos:prefLabel "Prüfungsvorgabe"@de , "assessment document"@en ;
    skos:definition "Prüfungsanforderungen, Abiturvorgaben, Operatorenliste, Testhandbuch."@de .
cv:dk_institutional a skos:Concept ; skos:inScheme cv:DocumentKinds ; skos:topConceptOf cv:DocumentKinds ;
    skos:notation "institutional" ; skos:prefLabel "Einrichtungs- oder Trägerkonzept"@de , "institutional concept"@en ;
    skos:definition "Schulinternes Curriculum, Kita-Konzeption, Lernsituationen; nie Status amtlich."@de .
cv:dk_other a skos:Concept ; skos:inScheme cv:DocumentKinds ; skos:topConceptOf cv:DocumentKinds ;
    skos:notation "other" ; skos:prefLabel "sonstiges"@de , "other"@en .

cv:EducationSectors a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Bildungsbereiche"@de , "education sectors"@en .
cv:sec_elementary a skos:Concept ; skos:inScheme cv:EducationSectors ; skos:topConceptOf cv:EducationSectors ;
    skos:notation "elementary" ; skos:prefLabel "Elementarbildung"@de , "early childhood education"@en .
cv:sec_school a skos:Concept ; skos:inScheme cv:EducationSectors ; skos:topConceptOf cv:EducationSectors ;
    skos:notation "school" ; skos:prefLabel "Schulbildung"@de , "school education"@en .
cv:sec_vocational a skos:Concept ; skos:inScheme cv:EducationSectors ; skos:topConceptOf cv:EducationSectors ;
    skos:notation "vocational" ; skos:prefLabel "Berufsbildung"@de , "vocational education and training"@en .
cv:sec_higher a skos:Concept ; skos:inScheme cv:EducationSectors ; skos:topConceptOf cv:EducationSectors ;
    skos:notation "higher" ; skos:prefLabel "Hochschulbildung"@de , "higher education"@en .
cv:sec_adult a skos:Concept ; skos:inScheme cv:EducationSectors ; skos:topConceptOf cv:EducationSectors ;
    skos:notation "adult" ; skos:prefLabel "Erwachsenen- und Weiterbildung"@de , "adult and continuing education"@en .

cv:Formalities a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Formalität"@de , "formality"@en .
cv:form_formal a skos:Concept ; skos:inScheme cv:Formalities ; skos:topConceptOf cv:Formalities ;
    skos:notation "formal" ; skos:prefLabel "formal"@de , "formal"@en ;
    skos:definition "Führt zu einem anerkannten Abschluss im Bildungssystem."@de .
cv:form_nonFormal a skos:Concept ; skos:inScheme cv:Formalities ; skos:topConceptOf cv:Formalities ;
    skos:notation "nonFormal" ; skos:prefLabel "non-formal"@de , "non-formal"@en ;
    skos:definition "Organisiertes Lernen ohne staatlich anerkannten Abschluss (Kurs, Zertifikatslehrgang)."@de .
cv:form_informal a skos:Concept ; skos:inScheme cv:Formalities ; skos:topConceptOf cv:Formalities ;
    skos:notation "informal" ; skos:prefLabel "informell"@de , "informal"@en .

# -----------------------------------------------------------------------------
# Geltung: Umfang, Variantenart, Voraussetzungsart
# -----------------------------------------------------------------------------
cv:ScopeShares a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Geltungsumfang"@de , "scope share"@en .
cv:share_common a skos:Concept ; skos:inScheme cv:ScopeShares ; skos:topConceptOf cv:ScopeShares ;
    skos:notation "common" ; skos:prefLabel "gemeinsam"@de , "common"@en ;
    skos:definition "Gilt für alle Geltungsträger („fachrichtungsübergreifend“, „gemeinsame Kernqualifikationen“)."@de .
cv:share_specific a skos:Concept ; skos:inScheme cv:ScopeShares ; skos:topConceptOf cv:ScopeShares ;
    skos:notation "specific" ; skos:prefLabel "spezifisch"@de , "specific"@en .
cv:share_supplementary a skos:Concept ; skos:inScheme cv:ScopeShares ; skos:topConceptOf cv:ScopeShares ;
    skos:notation "supplementary" ; skos:prefLabel "ergänzend"@de , "supplementary"@en .
cv:share_alternative a skos:Concept ; skos:inScheme cv:ScopeShares ; skos:topConceptOf cv:ScopeShares ;
    skos:notation "alternative" ; skos:prefLabel "alternativ"@de , "alternative"@en ;
    skos:definition "Parallelfassung derselben Einheit für verschiedene Geltungsträger (Lernfeld 13 GH/AH)."@de .

cv:VariantKinds a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Variantenarten"@de , "variant kinds"@en .
cv:var_specialisation a skos:Concept ; skos:inScheme cv:VariantKinds ; skos:topConceptOf cv:VariantKinds ;
    skos:notation "specialisation" ; skos:prefLabel "Fachrichtung"@de , "specialisation"@en .
cv:var_focus a skos:Concept ; skos:inScheme cv:VariantKinds ; skos:topConceptOf cv:VariantKinds ;
    skos:notation "focus" ; skos:prefLabel "Schwerpunkt/Vertiefung/Studienrichtung"@de , "focus"@en .
cv:var_electiveQualification a skos:Concept ; skos:inScheme cv:VariantKinds ; skos:topConceptOf cv:VariantKinds ;
    skos:notation "electiveQualification" ; skos:prefLabel "Wahlqualifikation"@de , "elective qualification"@en .
cv:var_additionalQualification a skos:Concept ; skos:inScheme cv:VariantKinds ; skos:topConceptOf cv:VariantKinds ;
    skos:notation "additionalQualification" ; skos:prefLabel "Zusatzqualifikation"@de , "additional qualification"@en .
cv:var_track a skos:Concept ; skos:inScheme cv:VariantKinds ; skos:topConceptOf cv:VariantKinds ;
    skos:notation "track" ; skos:prefLabel "Zug/Kursniveau-Variante"@de , "track"@en ;
    skos:example "G-/E-Kurs, Regel-/M-Klasse, Grund-/Leistungskurs" .
cv:var_subCurriculum a skos:Concept ; skos:inScheme cv:VariantKinds ; skos:topConceptOf cv:VariantKinds ;
    skos:notation "subCurriculum" ; skos:prefLabel "Teilcurriculum"@de , "sub-curriculum"@en ;
    skos:example "Krippe, Kindergarten, Hort in einem Plan 0–10; Teilstudiengang im Kombi-Bachelor" .
cv:var_targetGroup a skos:Concept ; skos:inScheme cv:VariantKinds ; skos:topConceptOf cv:VariantKinds ;
    skos:notation "targetGroup" ; skos:prefLabel "Zielgruppenvariante"@de , "target group variant"@en ;
    skos:example "Jugendintegrationskurs, Alphabetisierungskurs" .
cv:var_placementArea a skos:Concept ; skos:inScheme cv:VariantKinds ; skos:topConceptOf cv:VariantKinds ;
    skos:notation "placementArea" ; skos:prefLabel "Einsatzgebiet"@de , "placement area"@en .

cv:RequirementKinds a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Art der Voraussetzung"@de , "requirement kinds"@en .
cv:req_formal a skos:Concept ; skos:inScheme cv:RequirementKinds ; skos:topConceptOf cv:RequirementKinds ;
    skos:notation "formal" ; skos:prefLabel "formal (zwingend)"@de , "formal"@en .
cv:req_recommended a skos:Concept ; skos:inScheme cv:RequirementKinds ; skos:topConceptOf cv:RequirementKinds ;
    skos:notation "recommended" ; skos:prefLabel "empfohlen"@de , "recommended"@en ;
    skos:altLabel "empfohlene Vorkenntnisse"@de .
cv:req_none a skos:Concept ; skos:inScheme cv:RequirementKinds ; skos:topConceptOf cv:RequirementKinds ;
    skos:notation "none" ; skos:prefLabel "keine (ausdrücklich)"@de , "none"@en ;
    skos:definition "Das Dokument sagt ausdrücklich „keine“ – als leere Menge speichern, nicht als fehlende Angabe."@de .

# -----------------------------------------------------------------------------
# Niveau: Dimension, Zuordnungsart, Ordnungsart
# -----------------------------------------------------------------------------
cv:LevelDimensions a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Niveaudimensionen"@de , "level dimensions"@en ;
    skos:definition "Gleiche Wörter („Niveau“, „Standard“, „Anforderung“) meinen Verschiedenes; deshalb getrennte Dimensionen. Zeitliche Lage (Jahrgang, Alter, Semester) ist kein Niveau, sondern cur:TimeSpan."@de .
cv:dim_stage a skos:Concept ; skos:inScheme cv:LevelDimensions ; skos:topConceptOf cv:LevelDimensions ;
    skos:notation "stage" ; skos:prefLabel "Bildungsstufe"@de , "educational stage"@en ;
    skos:definition "ISCED 2011, KIM-Bildungsstufe (Primarstufe, Sekundarstufe I …)."@de .
cv:dim_qualification a skos:Concept ; skos:inScheme cv:LevelDimensions ; skos:topConceptOf cv:LevelDimensions ;
    skos:notation "qualification" ; skos:prefLabel "Qualifikationsniveau/Abschlussbezug"@de , "qualification level"@en ;
    skos:definition "DQR/EQR, Schulabschluss (ESA, MSA, AHR), Hochschulgrad. Nur an Qualifikation oder Spezifikation, nie an einzelnen Aussagen."@de .
cv:dim_proficiency a skos:Concept ; skos:inScheme cv:LevelDimensions ; skos:topConceptOf cv:LevelDimensions ;
    skos:notation "proficiency" ; skos:prefLabel "Kompetenzstufe"@de , "proficiency level"@en ;
    skos:definition "Stufe eines expliziten Stufenmodells: GER A1–C2, Alpha-Level, Niveaustufen A–H (BE/BB), IQB-Kompetenzstufen, Raster-Stufen."@de .
cv:dim_attainment a skos:Concept ; skos:inScheme cv:LevelDimensions ; skos:topConceptOf cv:LevelDimensions ;
    skos:notation "attainment" ; skos:prefLabel "Erwartungsniveau"@de , "attainment level"@en ;
    skos:definition "Erwarteter Erreichungsgrad: Mindest-, Regel-, erhöhte Anforderung; G/M/E (BW)."@de .
cv:dim_course a skos:Concept ; skos:inScheme cv:LevelDimensions ; skos:topConceptOf cv:LevelDimensions ;
    skos:notation "course" ; skos:prefLabel "Kursniveau"@de , "course level"@en ;
    skos:definition "Grundlegendes/erhöhtes Anforderungsniveau (GK/LK, Basis-/Leistungsfach), G-/E-Kurs."@de .
cv:dim_taskDemand a skos:Concept ; skos:inScheme cv:LevelDimensions ; skos:topConceptOf cv:LevelDimensions ;
    skos:notation "taskDemand" ; skos:prefLabel "Aufgabenanforderung"@de , "task demand"@en ;
    skos:definition "Anforderungsbereich I–III. Bezieht sich auf Aufgaben; an Lernergebnissen nur, wenn das Dokument ihn ausdrücklich nennt."@de .
cv:dim_cognitive a skos:Concept ; skos:inScheme cv:LevelDimensions ; skos:topConceptOf cv:LevelDimensions ;
    skos:notation "cognitive" ; skos:prefLabel "kognitive Stufe (Heuristik)"@de , "cognitive level (heuristic)"@en ;
    skos:definition "Taxonomiestufe (Anderson/Krathwohl, SOLO) oder AFB-Heuristik aus dem Operator über eine Operatorenliste; nur Herkunft rule, model oder human, nie im Extraktionspass (X4)."@de .
cv:dim_affective a skos:Concept ; skos:inScheme cv:LevelDimensions ; skos:topConceptOf cv:LevelDimensions ;
    skos:notation "affective" ; skos:prefLabel "affektive Stufe (Heuristik)"@de , "affective level (heuristic)"@en ;
    skos:definition "Stufe der affektiven Taxonomie (Krathwohl/Bloom/Masia 1964) für Werte und Haltungen; wie die kognitive Heuristik nur mit Herkunft rule/model/human. Dient der Planung, stuft keine Lernenden ein."@de .
cv:dim_psychomotor a skos:Concept ; skos:inScheme cv:LevelDimensions ; skos:topConceptOf cv:LevelDimensions ;
    skos:notation "psychomotor" ; skos:prefLabel "psychomotorische Stufe (Heuristik)"@de , "psychomotor level (heuristic)"@en ;
    skos:definition "Stufe der psychomotorischen Taxonomie (Dave 1970) für praktisches Handeln; nur mit Herkunft rule/model/human."@de .
cv:dim_development a skos:Concept ; skos:inScheme cv:LevelDimensions ; skos:topConceptOf cv:LevelDimensions ;
    skos:notation "development" ; skos:prefLabel "Entwicklungsstufe"@de , "developmental stage"@en ;
    skos:definition "Stufe eines Entwicklungsverlaufs, den das Dokument ausdrücklich ordnet, ohne Bindung an Alter oder Jahrgang. Signale wie „zunehmend“ bleiben Wortlaut (elem:developmentQualifier)."@de .
cv:dim_grading a skos:Concept ; skos:inScheme cv:LevelDimensions ; skos:topConceptOf cv:LevelDimensions ;
    skos:notation "grading" ; skos:prefLabel "Bewertungsstufe"@de , "grade"@en ;
    skos:definition "Note oder Punktzahl einer Leistungsbewertung (Notenstufen 1–6, Notenpunkte 0–15). Nur an Prüfung, Prüfungsspezifikation, Regel (Bestehen, Zulassung, Anrechnung) oder Standard, nie an Lernergebnissen, Knoten oder Zerlegungen."@de .
cv:dim_conduct a skos:Concept ; skos:inScheme cv:LevelDimensions ; skos:topConceptOf cv:LevelDimensions ;
    skos:notation "conduct" ; skos:prefLabel "Verhaltensbewertung"@de , "conduct rating"@en ;
    skos:altLabel "Kopfnote"@de , "Arbeits- und Sozialverhalten"@de ;
    skos:definition "Stufe einer Bewertung von Arbeits- und Sozialverhalten nach Zeugnisrecht; Skalen je Land. Wie Bewertungsstufen nur an Prüfung, Prüfungsspezifikation, Regel oder Standard."@de .

cv:LevelRelations a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Art der Niveauzuordnung"@de , "level relations"@en .
cv:lrel_assigned a skos:Concept ; skos:inScheme cv:LevelRelations ; skos:topConceptOf cv:LevelRelations ;
    skos:notation "assigned" ; skos:prefLabel "zugewiesen"@de , "assigned"@en .
cv:lrel_minimum a skos:Concept ; skos:inScheme cv:LevelRelations ; skos:topConceptOf cv:LevelRelations ;
    skos:notation "minimum" ; skos:prefLabel "Mindestniveau"@de , "minimum"@en ;
    skos:example "Rahmencurriculum Integrationskurse: Lernziel der niedrigsten möglichen Stufe zugeordnet" .
cv:lrel_target a skos:Concept ; skos:inScheme cv:LevelRelations ; skos:topConceptOf cv:LevelRelations ;
    skos:notation "target" ; skos:prefLabel "Zielniveau"@de , "target"@en .
cv:lrel_entry a skos:Concept ; skos:inScheme cv:LevelRelations ; skos:topConceptOf cv:LevelRelations ;
    skos:notation "entry" ; skos:prefLabel "Eingangsniveau"@de , "entry"@en .
cv:lrel_range a skos:Concept ; skos:inScheme cv:LevelRelations ; skos:topConceptOf cv:LevelRelations ;
    skos:notation "range" ; skos:prefLabel "Bereich (von–bis)"@de , "range"@en .

cv:LevelOrderings a skos:ConceptScheme ;
    skos:prefLabel "Ordnungsart von Niveausystemen"@de , "level orderings"@en .
cv:ord_cumulative a skos:Concept ; skos:inScheme cv:LevelOrderings ; skos:topConceptOf cv:LevelOrderings ;
    skos:notation "cumulative" ; skos:prefLabel "kumulativ"@de , "cumulative"@en ;
    skos:definition "Höhere Stufe schließt niedrigere ein (A–H, GER, DQR). Nur hier sind steigert-Kanten zulässig."@de .
cv:ord_parallel a skos:Concept ; skos:inScheme cv:LevelOrderings ; skos:topConceptOf cv:LevelOrderings ;
    skos:notation "parallel" ; skos:prefLabel "parallele Züge"@de , "parallel tracks"@en ;
    skos:definition "Stufen sind parallele Anspruchsniveaus desselben Jahrgangs (G/M/E, G-/E-Kurs)."@de .
cv:ord_nominal a skos:Concept ; skos:inScheme cv:LevelOrderings ; skos:topConceptOf cv:LevelOrderings ;
    skos:notation "nominal" ; skos:prefLabel "ungeordnet"@de , "nominal"@en .
cv:ord_ordinal a skos:Concept ; skos:inScheme cv:LevelOrderings ; skos:topConceptOf cv:LevelOrderings ;
    skos:notation "ordinal" ; skos:prefLabel "geordnet ohne Einschluss"@de , "ordinal"@en ;
    skos:definition "Stufen sind geordnet, eine höhere schließt die niedrigere aber nicht ein (Noten, Notenpunkte, Verhaltensstufen). Keine steigert-Kanten zwischen Kriterien verschiedener Stufen."@de .

# -----------------------------------------------------------------------------
# Zeit und Umfang
# -----------------------------------------------------------------------------
cv:TimeKinds a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Art des Zeitraums"@de , "time kinds"@en .
cv:time_age a skos:Concept ; skos:inScheme cv:TimeKinds ; skos:topConceptOf cv:TimeKinds ;
    skos:notation "age" ; skos:prefLabel "Alter (Jahre)"@de , "age (years)"@en ;
    skos:definition "Lebensalter in Jahren, Dezimalwerte zulässig (U3 = 0–3; „ab 18 Monaten“ = 1,5)."@de .
cv:time_gradeLevel a skos:Concept ; skos:inScheme cv:TimeKinds ; skos:topConceptOf cv:TimeKinds ;
    skos:notation "gradeLevel" ; skos:prefLabel "Jahrgangsstufe"@de , "grade level"@en .
cv:time_trainingYear a skos:Concept ; skos:inScheme cv:TimeKinds ; skos:topConceptOf cv:TimeKinds ;
    skos:notation "trainingYear" ; skos:prefLabel "Ausbildungsjahr"@de , "training year"@en .
cv:time_trainingMonth a skos:Concept ; skos:inScheme cv:TimeKinds ; skos:topConceptOf cv:TimeKinds ;
    skos:notation "trainingMonth" ; skos:prefLabel "Ausbildungsmonat"@de , "training month"@en ;
    skos:example "„1. bis 15. Monat“" .
cv:time_semester a skos:Concept ; skos:inScheme cv:TimeKinds ; skos:topConceptOf cv:TimeKinds ;
    skos:notation "semester" ; skos:prefLabel "Fachsemester"@de , "semester"@en .
cv:time_studyYear a skos:Concept ; skos:inScheme cv:TimeKinds ; skos:topConceptOf cv:TimeKinds ;
    skos:notation "studyYear" ; skos:prefLabel "Studienjahr"@de , "study year"@en .
cv:time_courseSection a skos:Concept ; skos:inScheme cv:TimeKinds ; skos:topConceptOf cv:TimeKinds ;
    skos:notation "courseSection" ; skos:prefLabel "Kursabschnitt"@de , "course section"@en .
cv:time_phase a skos:Concept ; skos:inScheme cv:TimeKinds ; skos:topConceptOf cv:TimeKinds ;
    skos:notation "phase" ; skos:prefLabel "benannte Phase"@de , "named phase"@en ;
    skos:definition "Einführungs-/Qualifikationsphase, Ausbildungsdrittel, Studieneingangsphase, Eingewöhnung; Wert in cur:phase."@de .

cv:TimeRelations a skos:ConceptScheme ;
    skos:prefLabel "Zeitbezug"@de , "time relations"@en .
cv:trel_during a skos:Concept ; skos:inScheme cv:TimeRelations ; skos:topConceptOf cv:TimeRelations ;
    skos:notation "during" ; skos:prefLabel "während"@de , "during"@en .
cv:trel_endOf a skos:Concept ; skos:inScheme cv:TimeRelations ; skos:topConceptOf cv:TimeRelations ;
    skos:notation "endOf" ; skos:prefLabel "am Ende von (Bezugszeitpunkt)"@de , "end of"@en ;
    skos:example "„am Ende der Jahrgangsstufe 6“" .
cv:trel_until a skos:Concept ; skos:inScheme cv:TimeRelations ; skos:topConceptOf cv:TimeRelations ;
    skos:notation "until" ; skos:prefLabel "bis spätestens"@de , "until"@en .
cv:trel_from a skos:Concept ; skos:inScheme cv:TimeRelations ; skos:topConceptOf cv:TimeRelations ;
    skos:notation "from" ; skos:prefLabel "ab"@de , "from"@en .

cv:WorkloadUnits a skos:ConceptScheme ; cur:llmEnum true ;
    skos:prefLabel "Umfangseinheiten"@de , "workload units"@en .
