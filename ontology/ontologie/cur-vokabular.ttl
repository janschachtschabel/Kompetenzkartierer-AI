# -----------------------------------------------------------------------------
# Knotentypen für importierte Rahmen und Raster (bereichsneutral)
# Rahmen (cur:CompetencyFramework) werden einmal importiert; ihre Zeilen sind
# Kriterien, ihre Zellen niveaugebundene Standard-Aussagen.
# -----------------------------------------------------------------------------
cv:FrameworkNodeTypes a skos:ConceptScheme ;
    skos:prefLabel "Knotentypen für Kompetenzrahmen"@de , "framework node types"@en .
cv:nt_criterion a cur:NodeType ; skos:inScheme cv:FrameworkNodeTypes ; skos:topConceptOf cv:FrameworkNodeTypes ; skos:broader cv:fn_area ;
    skos:notation "criterion" ; skos:prefLabel "Kriterium/Kompetenzbereich eines Rahmens"@de , "framework criterion"@en ;
    skos:definition "Zeile eines Rasters oder Bereich eines Rahmens (GER-Skala, DigComp-Kompetenz, KMK-Kompetenzbereich); trägt die Zellen als Standard-Aussagen mit Niveauzuordnung."@de ;
    cur:extractionDepth cv:depth_full .
cv:nt_subcriterion a cur:NodeType ; skos:inScheme cv:FrameworkNodeTypes ; skos:topConceptOf cv:FrameworkNodeTypes ; skos:broader cv:fn_subunit ;
    skos:notation "subcriterion" ; skos:prefLabel "Teilkriterium eines Rahmens"@de , "framework sub-criterion"@en ;
    cur:typicalParent cv:nt_criterion ; cur:extractionDepth cv:depth_full .

# -----------------------------------------------------------------------------
# Körnung von Inhaltskonzepten (Andockpunkt Inhalt und Thema)
# -----------------------------------------------------------------------------
cv:ContentGranularities a skos:ConceptScheme ;
    skos:prefLabel "Körnung von Inhaltskonzepten"@de , "content granularities"@en .
cv:gran_topic a skos:Concept ; skos:inScheme cv:ContentGranularities ; skos:topConceptOf cv:ContentGranularities ;
    skos:notation "topic" ; skos:prefLabel "Thema"@de , "topic"@en ;
    skos:definition "Grober Weltausschnitt, wie er in Titeln von Bereichen und Einheiten steht („Elektrizität“, „Klimawandel“, „Ernährung“). Einstieg der Themensuche."@de .
cv:gran_concept a skos:Concept ; skos:inScheme cv:ContentGranularities ; skos:topConceptOf cv:ContentGranularities ;
    skos:notation "concept" ; skos:prefLabel "Begriff"@de , "concept"@en ;
    skos:definition "Fachbegriff, Gesetz, Verfahren („Ohmsches Gesetz“, „Photosynthese“, „Dreisatz“)."@de .
cv:gran_entity a skos:Concept ; skos:inScheme cv:ContentGranularities ; skos:topConceptOf cv:ContentGranularities ;
    skos:notation "entity" ; skos:prefLabel "Entität"@de , "entity"@en ;
    skos:definition "Einzelnes Ding, Person, Ort, Werk, Ereignis („Martin Luther“, „Rhein“, „Faust“)."@de .
