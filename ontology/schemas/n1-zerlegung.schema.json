          },
          "knowledgeType": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "conceptual",
              "factual",
              "metacognitive",
              "procedural",
              null
            ],
            "description": "Wissensart nur bei Wissensaussagen.",
            "x-cv-scheme": "KnowledgeTypes"
          },
          "competenceDimension": {
            "type": [
              "string",
              "null"
            ],
            "description": "Dimension aus dem Kompetenzmodell des Dokuments (Liste im Prompt) oder null."
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/wlo/curriculum/schema/n1-zerlegung",
  "title": "N1 Zerlegung"
}
